'==============================================================
' FoodResQ — Sequence Diagrams: Recipes (recipes module)
' Create · List (public / mine) · Detail · Update · Soft delete · Upload image
' NOTE: authoring is restricted to volunteers with the "chef" specialization
'       (or admin); editing/deleting is restricted to the author or admin
'==============================================================

'──────────────────── 1. Create Recipe ───────────────────────
@startuml seq-recipe-create
!include _seq-style.iuml
title Create Recipe Sequence Diagram

actor "Chef" as User
participant ":RecipeFormScreen" as Screen
participant ":RecipesController" as Ctrl
participant ":RecipesService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : fill recipe (name, servings, steps, ingredients)
activate Screen
Screen -> Ctrl : POST /recipes (CreateRecipeDto)
activate Ctrl
Ctrl -> Svc : create(userId, dto)
activate Svc

Svc -> Svc : assertCanAuthor(userId)
Svc -> Repo : user.findUnique(id) select role
Repo --> Svc : user | null
alt User not found
  Svc --> Ctrl : 404 NotFound
  Ctrl --> Screen : return error
  Screen --> User : show error message
else role = admin
  note right of Svc : admin bỏ qua kiểm tra chuyên môn
else role != volunteer
  Svc --> Ctrl : 403 "Chỉ đầu bếp hoặc quản trị viên mới được thêm công thức"
  Ctrl --> Screen : return error
  Screen --> User : show error message
else role = volunteer
  Svc -> Repo : volunteerSpecializationEntry.findFirst(userId, specialization='chef')
  Repo -> DB : SELECT volunteer_specializations
  DB --> Repo : chef | null
  alt No chef specialization
    Svc --> Ctrl : 403 "Bạn cần có chuyên môn Đầu bếp"
    Ctrl --> Screen : return error
    Screen --> User : show error message
  end
end

Svc -> Repo : recipe.create(...) nested create ingredients[]
Repo -> DB : INSERT recipes + recipe_ingredients
DB --> Repo : recipe
Repo --> Svc : recipe include ingredients
Svc --> Ctrl : recipe
Ctrl --> Screen : return data (201)
Screen --> User : recipe published to the library
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 2. List Recipes ────────────────────────
@startuml seq-recipe-list
!include _seq-style.iuml
title List Recipes Sequence Diagram

actor "Chef / Volunteer" as User
participant ":RecipeLibraryScreen" as Screen
participant ":RecipesController" as Ctrl
participant ":RecipesService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : browse library (search, page)
activate Screen
alt public library
  Screen -> Ctrl : GET /recipes?search&page&limit
  activate Ctrl
  Ctrl -> Svc : list({ search, page, limit })
  activate Svc
  Svc -> Svc : where = { deletedAt: null, isPublic: true }
else my recipes
  Screen -> Ctrl : GET /recipes/mine?search&page&limit
  Ctrl -> Svc : list({ mine: true, userId, ... })
  Svc -> Svc : where = { deletedAt: null, createdByUserId: userId }
end
Svc -> Svc : page = max(1, page) · limit = min(limit ?? 20, 50)
note right of Svc : chặn client xin danh sách vô hạn (CLAUDE.md §2.4)
opt search provided
  Svc -> Svc : where.name = { contains: search, mode: insensitive }
end
Svc -> Repo : $transaction([ recipe.findMany(where, skip, take), recipe.count(where) ])
Repo -> DB : SELECT recipes ORDER BY times_used DESC, created_at DESC + COUNT(*)
DB --> Repo : rows[], total
Repo --> Svc : rows, total
Svc -> Svc : map → { ingredientCount, authorName, authorAvatar }
Svc --> Ctrl : { items, meta: { page, limit, total, totalPages } }
deactivate Svc
Ctrl --> Screen : return data (200)
deactivate Ctrl
Screen --> User : render recipe cards
deactivate Screen
@enduml

'──────────────────── 3. Recipe Detail ───────────────────────
@startuml seq-recipe-detail
!include _seq-style.iuml
title Recipe Detail Sequence Diagram

actor "Chef / Volunteer" as User
participant ":RecipeDetailScreen" as Screen
participant ":RecipesController" as Ctrl
participant ":RecipesService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : open a recipe
activate Screen
Screen -> Ctrl : GET /recipes/:id
activate Ctrl
Ctrl -> Svc : findOne(id)
activate Svc
Svc -> Repo : recipe.findFirst(id, deletedAt = null) include ingredients, createdBy
Repo -> DB : SELECT recipes JOIN recipe_ingredients JOIN users
DB --> Repo : recipe | null
Repo --> Svc : recipe
alt Not found OR soft-deleted
  Svc --> Ctrl : 404 "Không tìm thấy công thức"
  Ctrl --> Screen : return error
  Screen --> User : show error message
else found
  Svc --> Ctrl : recipe (imageUrls normalized to string[])
  Ctrl --> Screen : return data (200)
  Screen --> User : render ingredients + instructions
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 4. Update Recipe ───────────────────────
@startuml seq-recipe-update
!include _seq-style.iuml
title Update Recipe Sequence Diagram

actor "Chef" as User
participant ":RecipeFormScreen" as Screen
participant ":RecipesController" as Ctrl
participant ":RecipesService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : edit recipe
activate Screen
Screen -> Ctrl : PATCH /recipes/:id (UpdateRecipeDto)
activate Ctrl
Ctrl -> Svc : update(id, userId, dto)
activate Svc

Svc -> Svc : assertOwnerOrAdmin(id, userId)
Svc -> Repo : recipe.findFirst(id, deletedAt = null) select createdByUserId
Repo --> Svc : recipe | null
alt Not found
  Svc --> Ctrl : 404 NotFound
  Ctrl --> Screen : return error
  Screen --> User : show error message
else not the author
  Svc -> Repo : user.findUnique(userId) select role
  Repo --> Svc : role
  alt role != admin
    Svc --> Ctrl : 403 "Chỉ tác giả hoặc quản trị viên mới sửa được"
    Ctrl --> Screen : return error
    Screen --> User : show error message
  end
end

alt dto.ingredients provided
  group $transaction
    Svc -> Repo : recipeIngredient.deleteMany(recipeId)
    Svc -> Repo : recipe.update(data + nested create ingredients[])
    Repo -> DB : DELETE recipe_ingredients / UPDATE recipes / INSERT recipe_ingredients
  end
  note right of Svc : gửi kèm ingredients = thay TOÀN BỘ danh sách
else fields only
  Svc -> Repo : recipe.update(data)
  Repo -> DB : UPDATE recipes
end
Svc -> Svc : findOne(id)
Svc --> Ctrl : updated recipe
Ctrl --> Screen : return data (200)
Screen --> User : recipe saved
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 5. Delete Recipe (soft) ────────────────
@startuml seq-recipe-delete
!include _seq-style.iuml
title Delete Recipe Sequence Diagram

actor "Chef" as User
participant ":RecipeDetailScreen" as Screen
participant ":RecipesController" as Ctrl
participant ":RecipesService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : delete recipe
activate Screen
Screen -> Ctrl : DELETE /recipes/:id
activate Ctrl
Ctrl -> Svc : remove(id, userId)
activate Svc
Svc -> Svc : assertOwnerOrAdmin(id, userId)
alt Not found OR not author/admin
  Svc --> Ctrl : 404 / 403 error
  Ctrl --> Screen : return error
  Screen --> User : show error message
else allowed
  Svc -> Repo : recipe.update(deletedAt = NOW())
  note right of Svc : soft delete — công thức đã dùng\ncho chiến dịch cũ vẫn tra cứu được
  Repo -> DB : UPDATE recipes SET deleted_at
  Svc --> Ctrl : { id, deleted: true }
  Ctrl --> Screen : return data (200)
  Screen --> User : recipe removed from library
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 6. Upload Recipe Image ─────────────────
@startuml seq-recipe-upload-image
!include _seq-style.iuml
title Upload Recipe Image Sequence Diagram

actor "Chef" as User
participant ":RecipeFormScreen" as Screen
participant ":RecipesController" as Ctrl
participant ":RecipesService" as Svc
participant ":StorageService" as Storage
participant "Disk / Object Storage" as Disk

User -> Screen : attach dish photo
activate Screen
Screen -> Ctrl : POST /recipes/upload-image (multipart image)
activate Ctrl
Ctrl -> Svc : saveRecipeImage(image)
activate Svc
alt No file
  Svc --> Ctrl : 400 "Thiếu file ảnh"
  Ctrl --> Screen : return error
  Screen --> User : show error message
else file present
  Svc -> Storage : saveImage(file, 'recipes')
  activate Storage
  Storage -> Storage : MIME + magic-byte check
  Storage -> Disk : writeFile(recipes/{uuid}.{ext})
  Disk --> Storage : written
  Storage --> Svc : "/uploads/recipes/{uuid}.{ext}"
  deactivate Storage
  Svc --> Ctrl : url
  Ctrl --> Screen : { url } (201)
  Screen --> User : preview attached, url added to imageUrls[]
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml
