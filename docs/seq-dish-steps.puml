'==============================================================
' FoodResQ — Sequence Diagrams: Dish Steps & Weekly Schedule
' (campaigns/dish-steps.service.ts + weekly-schedule.controller.ts)
'
' Quy trình 4 khâu cố định cho mỗi món: Sơ chế → Nấu → Trình bày → Sẵn sàng phát xuất
' Một khâu mở khoá khi ĐỦ 2 điều kiện: đã đến giờ dự kiến AND khâu trước đã done.
' Set scheduled times · Load board · Complete step · QC fail · Cron auto-open ·
' Campaign supplies · Weekly schedule
'==============================================================

'──────────────────── 1. Set Step Scheduled Times ────────────
@startuml seq-dish-step-set-times
!include _seq-style.iuml
title Set Dish Step Times Sequence Diagram

actor "Charity Org" as User
participant ":CampaignManageScreen" as Screen
participant ":DishStepsController" as Ctrl
participant ":DishStepsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : set 4 expected times for a dish (HH:mm)
activate Screen
Screen -> Ctrl : POST /campaigns/:campaignId/menu-items/:menuItemId/step-times (times[])
activate Ctrl
Ctrl -> Svc : setScheduledTimes(campaignId, userId, menuItemId, scheduledTimes)
activate Svc

Svc -> Svc : assertCampaignOwner(campaignId, userId)
Svc -> Repo : kitchenCampaign.findUnique(id) include charityReceiver
Svc -> Repo : receiverProfile.findUnique(userId)
Repo --> Svc : campaign, receiver
alt Campaign not found
  Svc --> Ctrl : 404 NotFound
else caller is not the owning organization
  Svc --> Ctrl : 403 "Chỉ tổ chức tạo chiến dịch mới thao tác được"
else owner
  Svc -> Repo : campaignMenuItem.findUnique(menuItemId)
  Repo --> Svc : menuItem | null
  alt Item not in this campaign
    Svc --> Ctrl : 404 "Không tìm thấy món trong chiến dịch này"
  else valid
    Svc -> Svc : ensureStepsForMenuItem(campaignId, menuItemId, times)
    alt times.length != 4 OR a value is not HH:mm
      Svc --> Ctrl : 400 "Cần đúng 4 giờ dự kiến, định dạng HH:mm"
    else valid times
      Svc -> Repo : campaignDishStep.findMany(campaignId, menuItemId)
      Repo --> Svc : existing[]
      alt existing.length = 4
        Svc --> Ctrl : existing steps (idempotent — không tạo lại)
      else partial or empty
        opt existing.length > 0
          Svc -> Repo : campaignDishStep.deleteMany(campaignId, menuItemId)
          note right of Svc : bộ khâu dở dang → xoá & tạo lại cho sạch
        end
        Svc -> Repo : campaignDishStep.createMany(4 FIXED_DISH_STEPS + scheduledTime)
        Repo -> DB : DELETE / INSERT campaign_dish_steps
        Svc --> Ctrl : steps[] (order 1..4)
      end
      Ctrl --> Screen : return data (201)
      Screen --> User : timeline saved
    end
  end
end
Ctrl --> Screen : return error (on any failure)
Screen --> User : show error message
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 2. Load Kitchen Board ──────────────────
@startuml seq-dish-step-board
!include _seq-style.iuml
title Load Kitchen Board Sequence Diagram

actor "Chef" as User
participant ":KitchenBoardScreen" as Screen
participant ":DishStepsController" as Ctrl
participant ":DishStepsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : open the kitchen board
activate Screen
Screen -> Ctrl : GET /campaigns/:campaignId/dish-steps
activate Ctrl
Ctrl -> Svc : getStepsForCampaign(campaignId, currentUserId)
activate Svc
Svc -> Repo : kitchenCampaign.findUnique(id) select scheduledDate, endDate, startTime, endTime
Repo --> Svc : campaignTiming
Svc -> Repo : campaignMenuItem.findMany(campaignId) select dishSteps.id
Repo --> Svc : menuItems[]
loop for each item with no steps
  Svc -> Svc : ensureStepsForMenuItem(..., ['08:00','09:00','10:30','11:30'])
  note right of Svc : món chưa được set giờ → sinh mốc mặc định
end
Svc -> Repo : campaignMenuItem.findMany include recipe, dishSteps(+completedBy, qcFailedBy)
Svc -> Repo : campaignVolunteerAssignment.findMany(role = chef, status != cancelled)
Svc -> Repo : kitchenSafetyLog.findMany(campaignId) order checkedAt desc take 5
Repo -> DB : SELECT menu items / dish steps / assignments / safety logs
DB --> Repo : rows
Repo --> Svc : dishes, team, safetyLogs

loop for each step of each dish
  Svc -> Svc : computeEffectiveStatus(step, prevDone, isFirst, campaignTiming)
  note right of Svc : done → done\nđến giờ (stepDueAtUtc) AND khâu trước done → available\nngược lại → locked
end
note right of Svc : tính lại status tại thời điểm đọc —\nDB có thể còn 'locked' vì cron chưa chạy

Svc --> Ctrl : { dishes[] (steps + effectiveStatus), cookingTeam, safetyLogs }
deactivate Svc
Ctrl --> Screen : return data (200)
deactivate Ctrl
Screen --> User : render 4-step timeline per dish
deactivate Screen
@enduml

'──────────────────── 3. Complete a Dish Step ────────────────
@startuml seq-dish-step-complete
!include _seq-style.iuml
title Complete Dish Step Sequence Diagram

actor "Chef" as User
participant ":KitchenBoardScreen\n(Camera)" as Screen
participant ":DishStepsController" as Ctrl
participant ":DishStepsService" as Svc
participant ":StorageService" as Storage
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : tick "hoàn thành khâu" + take proof photo
activate Screen
Screen -> Ctrl : POST /campaigns/:campaignId/dish-steps/:stepId/complete (proof, note?)
activate Ctrl
Ctrl -> Svc : completeStep(campaignId, userId, stepId, proof, note)
activate Svc

alt No proof photo
  Svc --> Ctrl : 400 "Vui lòng chụp ảnh bằng chứng"
  note right of Svc : ảnh là bắt buộc — bằng chứng truy vết ATTP
else photo present
  Svc -> Svc : assertAssignedVolunteer(campaignId, userId)
  Svc -> Repo : volunteerProfile.findUnique(userId) include user.status
  Svc -> Repo : campaignVolunteerAssignment.findFirst(campaignId, volunteerId, role in chef/waiter/shipper, status in assigned/checked_in/in_progress)
  Repo --> Svc : volunteer, assignment
  alt Volunteer profile missing
    Svc --> Ctrl : 404 NotFound
  else account not active
    Svc --> Ctrl : 403 "Tài khoản chưa ở trạng thái hoạt động"
  else no assignment in this campaign
    Svc --> Ctrl : 403 "Bạn chưa được phân công vào chiến dịch này"
  else assigned
    Svc -> Repo : campaignDishStep.findUnique(stepId) include menuItem
    Svc -> Repo : kitchenCampaign.findUnique(campaignId) select timing
    Svc -> Repo : campaignDishStep.findFirst(menuItemId, stepOrder − 1)
    Repo --> Svc : step, campaignTiming, prevStep
    alt Step not in this campaign OR campaign missing
      Svc --> Ctrl : 404 NotFound
    else found
      Svc -> Svc : computeEffectiveStatus(step, prevDone, isFirst, timing)
      alt effective = locked
        Svc --> Ctrl : 400 "Chưa đến giờ hoặc khâu trước chưa hoàn thành"
      else step.status = done
        Svc --> Ctrl : 400 "Khâu này đã được hoàn thành trước đó"
      else available
        Svc -> Storage : saveImage(proof, 'dish-step-proofs')
        Storage --> Svc : proofUrl
        Svc -> Repo : campaignDishStep.update(status = done, completedAt, completedByVolunteerId, proofUrl, note)
        Repo -> DB : UPDATE campaign_dish_steps
        Svc -> Repo : campaignDishStep.findFirst(menuItemId, stepOrder + 1)
        Repo --> Svc : nextStep | null
        opt next step exists, not done, and its scheduled time has passed
          Svc -> Repo : campaignDishStep.update(nextStep → available, openedAt)
          note right of Svc : mở khoá khâu kế tiếp ngay,\nkhông chờ cron 30s
        end
        opt step.stepOrder = 4 (Sẵn sàng phát xuất)
          Svc -> Svc : maybeCompleteAssignment(campaignId, volunteerId)
          Svc -> Repo : count dish steps with stepOrder = 4 AND status != done
          Repo --> Svc : pendingLastSteps
          alt pendingLastSteps = 0
            Svc -> Repo : campaignVolunteerAssignment.update(status = completed)
            note right of Svc : mọi món đã sẵn sàng → ca bếp của chef kết thúc
          end
        end
        Svc --> Ctrl : updated step
        Ctrl --> Screen : return data (201)
        Screen --> User : step marked done, next step unlocked
      end
    end
  end
end
Ctrl --> Screen : return error (on any failure)
Screen --> User : show error message
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 4. Flag QC Failure ─────────────────────
@startuml seq-dish-step-qc-fail
!include _seq-style.iuml
title Flag Dish Step QC Failure Sequence Diagram

actor "Chef / QC Volunteer" as User
participant ":KitchenBoardScreen" as Screen
participant ":DishStepsController" as Ctrl
participant ":DishStepsService" as Svc
participant ":PrismaService" as Repo
participant ":NotificationsService" as Notif
database "Database" as DB
actor "Charity Org" as Owner

User -> Screen : "ngắt khẩn cấp" + reason
activate Screen
Screen -> Ctrl : POST /campaigns/:campaignId/dish-steps/:stepId/qc-fail (reason)
activate Ctrl
Ctrl -> Svc : flagStepQualityFail(campaignId, userId, stepId, reason)
activate Svc
alt reason empty OR longer than 500 chars
  Svc --> Ctrl : 400 BadRequest
  Ctrl --> Screen : return error
  Screen --> User : show error message
else valid reason
  Svc -> Svc : assertAssignedVolunteer(campaignId, userId)
  alt Not assigned / account not active
    Svc --> Ctrl : 403 / 404 error
    Ctrl --> Screen : return error
    Screen --> User : show error message
  else assigned
    Svc -> Repo : campaignDishStep.findUnique(stepId) include menuItem.recipe
    Repo --> Svc : step | null
    alt Step not in this campaign
      Svc --> Ctrl : 404 NotFound
    else step.status = done
      Svc --> Ctrl : 400 "Khâu đã hoàn thành — không thể đánh dấu fail"
    else step.qcFailedAt already set
      Svc --> Ctrl : 400 "Khâu này đã được đánh dấu fail trước đó"
    else flaggable
      Svc -> Repo : campaignDishStep.update(qcFailedAt, qcFailedByVolunteerId, qcFailureReason)
      note right of Svc : KHÔNG xoá step, không ảnh hưởng\nkhâu khác / món khác
      Repo -> DB : UPDATE campaign_dish_steps
      Svc -> Notif : notifyCampaignOwner(campaignId, "⚠️ Ngắt khẩn cấp: {dish}")
      Notif --> Owner : realtime alert
      Svc --> Ctrl : updated step
      Ctrl --> Screen : return data (201)
      Screen --> User : QC failure recorded, org notified
    end
  end
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 5. Cron — Auto-open Steps ──────────────
@startuml seq-dish-step-cron
!include _seq-style.iuml
title Auto-open Available Dish Steps Sequence Diagram

participant ":CampaignsCron\n(every 30s)" as Cron
participant ":DishStepsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

Cron -> Svc : autoOpenAvailableSteps()
activate Svc
Svc -> Svc : window = [VN today − 1 day, VN today + 1 day)
note right of Svc : chiến dịch qua đêm có scheduledDate = HÔM QUA\nnhưng vẫn đang chạy → lấy đúng hôm nay sẽ bỏ sót
Svc -> Repo : kitchenCampaign.findMany(status in in_progress/open, scheduledDate in window)
Repo -> DB : SELECT kitchen_campaigns
DB --> Repo : campaigns[]
Repo --> Svc : campaigns
alt No campaign in window
  Svc --> Cron : 0
else has campaigns
  Svc -> Repo : campaignDishStep.findMany(campaignId in …, status in locked/available) order menuItemId, stepOrder
  Repo --> Svc : allSteps[]
  Svc -> Svc : group steps by menuItemId
  loop for each menu item, steps in order
    Svc -> Svc : onTime = now >= stepDueAtUtc(campaignTiming, step.scheduledTime)
    note right of Svc : stepDueAtUtc neo HH:mm (giờ VN) vào đúng NGÀY —\nchỉ chiến dịch vắt qua nửa đêm mới đẩy sang ngày sau
    alt onTime AND prevDone AND status = locked
      Svc -> Svc : push step to toOpen[]
    end
  end
  alt toOpen is empty
    Svc --> Cron : 0
  else has steps to open
    Svc -> Repo : campaignDishStep.updateMany(id in toOpen, status = locked → available, openedAt)
    Repo -> DB : UPDATE campaign_dish_steps
    DB --> Repo : count
    Svc --> Cron : count
  end
end
deactivate Svc
@enduml

'──────────────────── 6. Campaign Supplies ───────────────────
@startuml seq-dish-step-supplies
!include _seq-style.iuml
title Campaign Supplies Sequence Diagram

actor "Chef / Charity Org" as User
participant ":SuppliesScreen" as Screen
participant ":DishStepsController" as Ctrl
participant ":DishStepsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : open the pantry view
activate Screen
Screen -> Ctrl : GET /campaigns/:campaignId/supplies
activate Ctrl
Ctrl -> Svc : getCampaignSupplies(campaignId)
activate Svc
Svc -> Repo : kitchenCampaign.findUnique(id) select supplyItems
Repo -> DB : SELECT kitchen_campaigns
DB --> Repo : campaign | null
Repo --> Svc : campaign
alt Campaign not found
  Svc --> Ctrl : 404 "Campaign không tồn tại"
  Ctrl --> Screen : return error
  Screen --> User : show error message
else found
  Svc -> Svc : parse supplyItems JSON → requested[] { name, unit, quantity }
  note right of Svc : nhu cầu charity khai lúc đăng ký
  Svc -> Repo : campaignDonation.findMany(campaignId, status = received) include provider
  Repo -> DB : SELECT campaign_donations JOIN provider_profiles
  DB --> Repo : donations[]
  Repo --> Svc : donations
  Svc -> Svc : group donations by itemName → items[]
  note right of Svc : thực tế kho bếp đang có
  Svc --> Ctrl : { requested, total, items, donations }
  Ctrl --> Screen : return data (200)
  Screen --> User : render needed vs received ingredients
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 7. Weekly Schedule ─────────────────────
@startuml seq-campaign-weekly-schedule
!include _seq-style.iuml
title Weekly Schedule Sequence Diagram

actor "Volunteer / Charity Org" as User
participant ":ScheduleScreen" as Screen
participant ":WeeklyScheduleController" as Ctrl
participant ":DishStepsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : open weekly schedule
activate Screen
Screen -> Ctrl : GET /campaigns/schedule/weekly?weekStart=YYYY-MM-DD
activate Ctrl
Ctrl -> Ctrl : start = weekStart ?? currentWeekStartUtc() (Monday, UTC)
Ctrl -> Svc : getWeeklySchedule(start, user.id, user.role)
activate Svc
Svc -> Svc : weekEnd = weekStart + 7 days

alt role = volunteer
  Svc -> Repo : volunteerProfile.findUnique(userId)
  Repo --> Svc : volunteer | null
  alt No volunteer profile
    Svc --> Ctrl : { weekStart, isPersonalView: true, days: [] }
  else found
    Svc -> Repo : campaignVolunteerAssignment.findMany(volunteerId, campaign.scheduledDate in week, status in open/in_progress/completed) include shift, campaign
    Repo -> DB : SELECT assignments JOIN campaign_shifts JOIN kitchen_campaigns
    DB --> Repo : assignments[]
    Svc -> Svc : group by campaign day → 7 day buckets
    Svc --> Ctrl : { weekStart, isPersonalView: true, days[7] }
    note right of Svc : TNV chỉ thấy chiến dịch MÌNH ĐƯỢC PHÂN CÔNG,\nkèm ca trực
  end
else role = receiver (charity org)
  Svc -> Repo : receiverProfile.findUnique(userId)
  Repo --> Svc : receiver | null
  alt No receiver profile
    Svc --> Ctrl : { weekStart, isPersonalView: false, days: [] }
  else found
    Svc -> Repo : kitchenCampaign.findMany(charityReceiverId, scheduledDate in week, status in open/in_progress/completed)
    Repo -> DB : SELECT kitchen_campaigns
    DB --> Repo : campaigns[]
    Svc -> Svc : group by day → 7 day buckets
    Svc --> Ctrl : { weekStart, isPersonalView: false, days[7] }
  end
else other roles (admin, provider)
  Svc --> Ctrl : { weekStart, isPersonalView: false, days: [] }
end
deactivate Svc
Ctrl --> Screen : return data (200)
deactivate Ctrl
Screen --> User : render 7-day grid
deactivate Screen
@enduml
