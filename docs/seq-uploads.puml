'==============================================================
' FoodResQ — Sequence Diagrams: Uploads (uploads module + StorageService)
' Authenticated image upload · Public register-evidence upload (throttled)
' NOTE: StorageService is the single write path for every image in the system
'       (listings, avatars, verifications, faces, QC photos, campaign covers)
'==============================================================

'──────────────────── 1. Upload Image (authenticated) ────────
@startuml seq-upload-image
!include _seq-style.iuml
title Upload Image Sequence Diagram

actor "User" as User
participant ":UploadWidget" as Screen
participant ":UploadsController" as Ctrl
participant ":ParseFilePipe" as Pipe
participant ":StorageService" as Storage
participant "Disk / Object Storage" as Disk

User -> Screen : pick an image
activate Screen
Screen -> Ctrl : POST /uploads/image?kind=listing|avatar|verification (multipart file)
activate Ctrl
Ctrl -> Pipe : validate file
activate Pipe
alt size > 5MB OR mimetype not in (jpeg, png, webp)
  Pipe --> Ctrl : throw
  deactivate Pipe
  Ctrl --> Screen : 400 BadRequest
  Screen --> User : show error message
else valid
  Pipe --> Ctrl : file
  Ctrl -> Ctrl : folder = FOLDER_BY_KIND[kind]
  alt kind not in whitelist
    Ctrl --> Screen : 400 "kind phải là một trong: listing, avatar, verification"
    note right of Ctrl : whitelist thư mục đích —\nchặn client ghi tuỳ ý vào uploads/
    Screen --> User : show error message
  else allowed kind
    Ctrl -> Storage : saveImage(file, folder)
    activate Storage
    Storage -> Storage : ext = EXT_BY_MIME[mimetype]
    Storage -> Storage : matchesMagicBytes(buffer, mimetype)
    note right of Storage : đối chiếu magic bytes —\nchống giả mạo Content-Type
    alt Extension unknown OR magic bytes mismatch
      Storage --> Ctrl : 400 BadRequest
      Ctrl --> Screen : return error
      Screen --> User : show error message
    else content verified
      Storage -> Storage : safeSubdir = subdir.replace(/[^a-z0-9_-]/gi, '')
      Storage -> Disk : mkdir(recursive) + writeFile(randomUUID().ext)
      Disk --> Storage : written
      Storage --> Ctrl : "/uploads/{subdir}/{uuid}.{ext}"
      deactivate Storage
      Ctrl --> Screen : { url } (201)
      Screen --> User : preview image, url attached to the form
    end
  end
end
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 2. Register Evidence (public) ──────────
@startuml seq-upload-register-evidence
!include _seq-style.iuml
title Upload Register Evidence Sequence Diagram

actor "Guest\n(provider signing up)" as User
participant ":RegisterScreen" as Screen
participant ":ThrottlerGuard" as Throttle
participant ":UploadsController" as Ctrl
participant ":ParseFilePipe" as Pipe
participant ":StorageService" as Storage
participant "Disk / Object Storage" as Disk

User -> Screen : attach business licence / storefront photo
activate Screen
Screen -> Throttle : POST /uploads/register-evidence (multipart file)
activate Throttle
note right of Throttle : @Throttle 15 req / 60s —\nendpoint public nên phải chặn spam
alt Rate limit exceeded
  Throttle --> Screen : 429 Too Many Requests
  Screen --> User : "Thử lại sau ít phút"
else within limit
  Throttle -> Ctrl : forward request
  deactivate Throttle
  activate Ctrl
  note right of Ctrl : KHÔNG có JwtAuthGuard —\nngười đăng ký chưa có tài khoản
  Ctrl -> Pipe : validate (≤ 5MB, jpeg/png/webp)
  activate Pipe
  alt invalid
    Pipe --> Ctrl : throw
    deactivate Pipe
    Ctrl --> Screen : 400 BadRequest
    Screen --> User : show error message
  else valid
    Ctrl -> Storage : saveImage(file, 'verifications')
    activate Storage
    Storage -> Storage : magic-byte check
    Storage -> Disk : writeFile(verifications/{uuid}.{ext})
    Disk --> Storage : written
    Storage --> Ctrl : "/uploads/verifications/{uuid}.{ext}"
    deactivate Storage
    Ctrl --> Screen : { url } (201)
    Screen --> User : evidence attached — submit register form next
  end
  deactivate Ctrl
end
deactivate Screen
@enduml
