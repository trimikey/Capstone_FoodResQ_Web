@startuml class-cron
title Scheduled Jobs Class Diagram

skinparam classAttributeIconSize 0
hide empty members

package "Scheduled Jobs" {
  class ReservationsCron {
    +handleNoShows()
    +handleDailyReset()
  }

  class DeliveriesCron {
    +handleUnclaimedSweep()
    +handleStalledDeliveries()
  }

  class BulkRunsCron {
    +handleStalled()
  }

  class ListingsCron {
    +handleAutoExpire()
    +handleExpiryAlerts()
  }

  class CampaignsCron {
    +handleRecruitmentLifecycle()
    +handlePurgeStalePending()
    +handleExpireOverdue()
    +handleAutoComplete()
    +handleNudgeUpcomingTasks()
    +handleMarkAbsentVolunteers()
    +handleAutoOpenDishSteps()
  }
}

class ReservationsService {
  +expireNoShows()
  +resetDailyReservationCounters()
}

class DeliveriesService {
  +expireUnclaimedDeliveries()
  +expireStalledDeliveries()
}

class BulkRunsService {
  +expireStalled()
}

class CampaignsService {
  +advanceRecruitmentLifecycle()
  +purgeStalePendingCampaigns()
  +expireOverdueCampaigns()
  +autoCompleteExpiredCampaigns()
  +releaseVolunteersOfFinishedCampaigns()
  +nudgeUpcomingTasks()
  +markAbsentVolunteers()
}

class DishStepsService {
  +autoOpenAvailableSteps()
}

class NotificationsService
class PrismaService

ReservationsCron --> ReservationsService
DeliveriesCron --> DeliveriesService
BulkRunsCron --> BulkRunsService
CampaignsCron --> CampaignsService
CampaignsCron --> DishStepsService
ListingsCron --> NotificationsService
ListingsCron --> PrismaService
@enduml
