'──────────────────── 25. Shipper Offer ──────────────────────
@startuml seq-delivery-offer
title Shipper Offer Sequence Diagram

actor "Shipper" as User
participant ":ShipperHomeScreen\n(offer popup)" as Screen
participant ":DeliveriesController" as Ctrl
participant ":DeliveriesService" as Svc
participant ":NotificationsGateway" as WS
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB

== System offers shippers one at a time (ride-hailing model) ==
activate Screen
Svc -> Svc : broadcastToNearbyShippers(deliveryId, pickupLng, pickupLat)
Svc -> Repo : $queryRaw nearest shipper: ST_DWithin(current_location, pickup, 5km)\nAND is_available AND verified shipper specialization\nAND not offered this delivery before — ORDER BY distance LIMIT 1
Repo -> DB : SELECT volunteer_profiles
DB --> Repo : shipper | null
Repo --> Svc : shipper
alt Nobody left within the radius
  Svc -> Svc : wait for the next sweep (cron every 30s)
else a shipper is available
  Svc -> Repo : shipperTaskOffer.create(deliveryId, shipperId, expiresAt = +15s)
  Repo -> DB : INSERT shipper_task_offers
  Svc -> WS : emitToUser(shipper, 'delivery:offer', payload)
  WS --> Screen : socket event
  Screen --> User : accept popup with a 15 second countdown
end

== Shipper responds ==
alt Shipper taps ACCEPT
  User -> Screen : tap "Accept"
  Screen -> Ctrl : POST /deliveries/:id/accept
  Ctrl -> Svc : acceptOffer(deliveryId, shipperUserId)
  Svc -> Repo : delivery.findUnique(id) + offer.findFirst(pending, not expired)
  Repo --> Svc : delivery, offer
  alt Another shipper already took it / offer expired
    Svc --> Ctrl : 409 "This delivery was taken by someone else"
  else shipper already has an active delivery or bulk run
    Svc --> Ctrl : 400 "Finish your current task first"
  else accepted
    group $transaction
      Svc -> Repo : delivery.updateMany(id, shipperId IS NULL → shipperId, status = assigned)
      Svc -> Repo : shipperTaskOffer.update(status = accepted, respondedAt)
      Svc -> Repo : volunteerProfile.update(isAvailable = false)
      Repo -> DB : UPDATE deliveries / offers / volunteer_profiles
    end
    Svc --> Ctrl : { deliveryId, status: assigned }
  end
else Shipper taps REJECT
  User -> Screen : tap "Skip"
  Screen -> Ctrl : POST /deliveries/:id/reject (reason?)
  Ctrl -> Svc : rejectOffer(deliveryId, shipperUserId, reason)
  Svc -> Repo : shipperTaskOffer.update(status = rejected, respondedAt)
  Repo -> DB : UPDATE shipper_task_offers
  Svc -> Svc : offerNextNearestShipper(...) — move on immediately
else Offer lapses after 15 seconds
  Svc -> Repo : shipperTaskOffer.update(status = expired)
  Svc -> Repo : volunteerProfile.update(isAvailable = false)
  Svc -> Svc : offerNextNearestShipper(...)
end
Ctrl --> Screen : return data (201) / error
Screen --> User : open the active task screen (or show error message)
deactivate Screen
@enduml

'──────────────────── 26. Delivery Lifecycle ─────────────────
@startuml seq-delivery-lifecycle
title Delivery Status Lifecycle Sequence Diagram

actor "Shipper" as User
participant ":ActiveTaskScreen\n(Camera / QR Scanner)" as Screen
participant ":DeliveriesController" as Ctrl
participant ":DeliveriesService" as Svc
participant ":StorageService" as Storage
participant ":TrustService" as Trust
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : open the active task
activate Screen
Screen -> Ctrl : GET /deliveries/my/active
activate Ctrl
Ctrl -> Svc : getMyActiveDelivery(shipperUserId)
activate Svc
Svc -> Repo : delivery.findFirst(shipperId, active statuses) include reservation, listing
Repo -> DB : SELECT deliveries JOIN reservations JOIN food_listings
DB --> Repo : delivery | null
Svc --> Ctrl : delivery + pickup / dropoff coordinates
deactivate Svc
Ctrl --> Screen : return data (200)
deactivate Ctrl
Screen --> User : render the route and the next-step button

loop each step: assigned → heading_to_provider → qc_completed → in_transit → delivered
  User -> Screen : advance the step (QC photo / QR scan where required)
  opt step = qc_completed
    Screen -> Ctrl : upload the QC photo
    activate Ctrl
    Ctrl -> Storage : saveImage(photo, 'qc-proofs')
    activate Storage
    Storage --> Ctrl : qcPhotoUrl
    deactivate Storage
    deactivate Ctrl
  end
  Screen -> Ctrl : PATCH /deliveries/:id/status (status, qcPhotoUrl?, qrToken?)
  activate Ctrl
  Ctrl -> Svc : updateStatus(deliveryId, shipperUserId, dto)
  activate Svc
  Svc -> Repo : delivery.findUnique(id) include reservation.receiver
  Repo --> Svc : delivery
  alt Caller is not the assigned shipper
    Svc --> Ctrl : 403 Forbidden
  else invalid transition (skipping or going backwards)
    Svc --> Ctrl : 400 "Cannot move from {current} to {next}"
  else step = qc_completed without a photo
    Svc --> Ctrl : 400 "A QC photo is required before leaving the store"
  else step = delivered without a valid receiver QR token
    Svc --> Ctrl : 400 "Scan the receiver QR code to confirm handover"
  else valid
    group $transaction
      Svc -> Repo : delivery.update(status, matching timestamp, qcPhotoUrl?)
      opt status = delivered
        Svc -> Repo : reservation.update(status = completed)
        Svc -> Repo : volunteerProfile.update(dedicationPoints += 5, isAvailable = true)
        Svc -> Repo : dedicationPointsHistory.create(delivery_completed)
      end
      Repo -> DB : UPDATE deliveries / reservations / volunteer_profiles
    end
    opt status = delivered
      Svc -> Trust : applyDelta(receiver, +2, RESERVATION_COMPLETED)
    end
    Svc -> Notif : notify(receiver, "Delivery update: {status}")
    Svc --> Ctrl : { deliveryId, status }
  end
  deactivate Svc
  Ctrl --> Screen : return data (200) / error
  deactivate Ctrl
  Screen --> User : refresh the progress bar (or show error message)
end
deactivate Screen
@enduml

'──────────────────── 27. Track Delivery ─────────────────────
@startuml seq-delivery-track
title Track Delivery Sequence Diagram

actor "Receiver" as User
participant ":TrackScreen\n(Map)" as Screen
participant ":DeliveriesController" as Ctrl
participant ":DeliveriesService" as Svc
participant ":NotificationsGateway" as WS
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB

User -> Screen : open the tracking screen
activate Screen
Screen -> Ctrl : GET /deliveries/track/:reservationId
activate Ctrl
Ctrl -> Svc : getTrackingForReceiver(reservationId, receiverUserId)
activate Svc
Svc -> Repo : receiverProfile.findUnique(userId) select id
Repo --> Svc : receiver | null
Svc -> Repo : delivery.findFirst(reservationId) include shipper.user, reservation
Repo -> DB : SELECT deliveries JOIN volunteer_profiles JOIN users
DB --> Repo : delivery | null
Repo --> Svc : delivery
alt Delivery not found
  Svc --> Ctrl : 404 NotFound
else the delivery belongs to another receiver
  Svc --> Ctrl : 403 Forbidden
else authorised
  Svc -> Repo : $queryRaw ST_X / ST_Y (pickup_location, delivery_location, shipper.current_location)
  Repo --> Svc : coordinates
  Svc --> Ctrl : { status, shipper: { fullName, phone, avgRating }, coords, timeline }
end
deactivate Svc
Ctrl --> Screen : return data (200) / error
deactivate Ctrl
Screen --> User : draw the route and the shipper position (or show error message)

Screen -> WS : subscribe to room user:{receiverUserId}
activate WS
loop whenever the shipper pushes GPS
  WS --> Screen : 'delivery:location' { lng, lat }
  Screen --> User : the shipper marker moves in real time
end
opt status changes
  WS --> Screen : 'notification:new' { deliveryId, status }
  Screen --> User : update the progress milestones
end
deactivate WS
deactivate Screen
@enduml

'──────────────────── 28. Shipper Drops Task ─────────────────
@startuml seq-delivery-drop-task
title Shipper Drops Task Sequence Diagram

actor "Shipper" as User
participant ":ActiveTaskScreen" as Screen
participant ":DeliveriesController" as Ctrl
participant ":DeliveriesService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB
actor "Next Shipper" as Next

User -> Screen : return the task before collecting the food
activate Screen
Screen -> Ctrl : POST /deliveries/:id/cancel (reason?)
activate Ctrl
Ctrl -> Svc : cancelAssignment(deliveryId, shipperUserId, reason)
activate Svc
Svc -> Repo : volunteerProfile.findUnique(userId) + delivery.findUnique(id)
Repo -> DB : SELECT volunteer_profiles / deliveries
DB --> Repo : volunteer, delivery | null
Repo --> Svc : volunteer, delivery
alt Delivery not found
  Svc --> Ctrl : 404 NotFound
else caller is not the assigned shipper
  Svc --> Ctrl : 403 Forbidden
else status is past qc_completed (food already collected)
  Svc --> Ctrl : 400 "Report a failed delivery instead"
else allowed
  group $transaction
    Svc -> Repo : delivery.update(shipperId = null, status = pending_assignment)
    Svc -> Repo : shipperTaskOffer.updateMany(this shipper → rejected)
    Svc -> Repo : volunteerProfile.update(isAvailable = true)
    Repo -> DB : UPDATE deliveries / shipper_task_offers / volunteer_profiles
  end
  Svc -> Svc : offerNextNearestShipper(deliveryId, pickupLng, pickupLat)
  Svc -> Notif : emitToUser(next shipper, 'delivery:offer')
  Notif --> Next : accept popup
  Svc --> Ctrl : { id, status: pending_assignment }
  Ctrl --> Screen : return data (201)
  Screen --> User : task returned, the order stays alive for the receiver
end
deactivate Svc
Ctrl --> Screen : return error (on any failure)
deactivate Ctrl
Screen --> User : show error message
deactivate Screen
@enduml

'──────────────────── 29. Report Failed Delivery ─────────────
@startuml seq-delivery-fail
title Report Failed Delivery Sequence Diagram

actor "Shipper" as User
participant ":ActiveTaskScreen" as Screen
participant ":DeliveriesController" as Ctrl
participant ":DeliveriesService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Receiver" as Receiver

User -> Screen : report the delivery as failed, enter the reason
activate Screen
Screen -> Ctrl : POST /deliveries/:id/fail (reason)
activate Ctrl
Ctrl -> Svc : failDelivery(deliveryId, shipperUserId, reason)
activate Svc
Svc -> Repo : volunteerProfile.findUnique(userId)
Repo --> Svc : volunteer | null
alt Volunteer profile not found
  Svc --> Ctrl : 404 NotFound
else reason is empty
  Svc --> Ctrl : 400 "A failure reason is required"
else valid caller
  Svc -> Repo : delivery.findUnique(id) include reservation
  Repo -> DB : SELECT deliveries JOIN reservations
  DB --> Repo : delivery | null
  Repo --> Svc : delivery
  alt Delivery not found
    Svc --> Ctrl : 404 NotFound
  else caller is not the assigned shipper
    Svc --> Ctrl : 403 Forbidden
  else status is already delivered / failed / cancelled
    Svc --> Ctrl : 400 "This delivery is already closed"
  else allowed
    group $transaction
      Svc -> Repo : delivery.update(status = failed, failedReason, failedAt)
      Svc -> Repo : reservation.update(status = cancelled, cancellationReason)
      Svc -> Repo : $executeRaw quantity_remaining = LEAST(total, remaining + qty), status = active
      Svc -> Repo : volunteerProfile.update(isAvailable = true)
      Repo -> DB : UPDATE deliveries / reservations / food_listings / volunteer_profiles
    end
    Svc -> Notif : notify(receiver, "The delivery failed: {reason}")
    Notif --> Receiver : realtime notification
    Svc --> Ctrl : { id, status: failed }
    Ctrl --> Screen : return data (201)
    Screen --> User : task closed, you are free to take a new one
  end
end
deactivate Svc
Ctrl --> Screen : return error (on any failure)
deactivate Ctrl
Screen --> User : show error message
deactivate Screen
@enduml

'──────────────────── 30. Receiver Cancels Search ────────────
@startuml seq-delivery-receiver-cancel
!include _seq-style.iuml
title Receiver Cancels Shipper Search Sequence Diagram

actor "Receiver" as User
participant ":TrackScreen" as Screen
participant ":DeliveriesController" as Ctrl
participant ":DeliveriesService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : stop looking for a shipper, collect the food in person
activate Screen
Screen -> Ctrl : POST /deliveries/:id/receiver-cancel
activate Ctrl
Ctrl -> Svc : cancelDeliverySearchByReceiver(deliveryId, userId)
activate Svc
Svc -> Repo : receiverProfile.findUnique(userId) select id
Repo -> DB : SELECT receiver_profiles
DB --> Repo : receiver | null
Repo --> Svc : receiver
alt Receiver profile not found
  Svc --> Ctrl : 404 NotFound
else found
  Svc -> Repo : delivery.findUnique(id) include reservation
  Repo -> DB : SELECT deliveries JOIN reservations
  DB --> Repo : delivery | null
  Repo --> Svc : delivery
  alt Delivery not found
    Svc --> Ctrl : 404 NotFound
  else the order belongs to another receiver
    Svc --> Ctrl : 403 Forbidden
  else status not in (pending_assignment, assigned)
    Svc --> Ctrl : 400 "The delivery is already in transit"
  else allowed
    group $transaction
      Svc -> Repo : shipperTaskOffer.updateMany(deliveryId, pending → expired)
      Svc -> Repo : delivery.update(status = cancelled)
      Repo -> DB : UPDATE shipper_task_offers / deliveries
    end
    Svc --> Ctrl : { id, status: cancelled, message }
    Ctrl --> Screen : return data (201)
    Screen --> User : collect the food yourself within the pickup window
  end
end
deactivate Svc
Ctrl --> Screen : return error (on any failure)
deactivate Ctrl
Screen --> User : show error message
deactivate Screen
@enduml

'──────────────────── 31. Shipper Performance ────────────────
@startuml seq-delivery-performance
title Shipper Performance Sequence Diagram

actor "Shipper" as User
participant ":HistoryScreen" as Screen
participant ":DeliveriesController" as Ctrl
participant ":DeliveriesService" as Svc
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB

User -> Screen : open the performance page
activate Screen
Screen -> Ctrl : GET /deliveries/my/stats
activate Ctrl
Ctrl -> Svc : getMyStats(shipperUserId)
activate Svc
Svc -> Repo : volunteerProfile.findUnique(userId) select dedicationPoints, rank, avgRating
Repo --> Svc : volunteer | null
alt Volunteer profile not found
  Svc --> Ctrl : 404 NotFound
else found
  Svc -> Repo : $transaction([ count delivered, count failed,\ncount delivered today, SUM(distanceKm) ])
  Repo -> DB : SELECT COUNT / SUM FROM deliveries
  DB --> Repo : counts, kmSum
  Svc -> Svc : completionRate = round(delivered / (delivered + failed) × 100)
  Svc --> Ctrl : { totalDelivered, todayDelivered, totalFailed,\ncompletionRate, totalKm, dedicationPoints, rank, avgRating }
end
deactivate Svc
Ctrl --> Screen : return data (200) / error
deactivate Ctrl
Screen --> User : KPI tiles and the rank badge

Screen -> Ctrl : GET /deliveries/my/history?page&limit
activate Ctrl
Ctrl -> Svc : getMyDeliveryHistory(shipperUserId, opts)
activate Svc
Svc -> Repo : $transaction([ delivery.findMany(shipperId, finished statuses,\ninclude reservation.listing, skip, take), count ])
Repo -> DB : SELECT deliveries JOIN reservations JOIN food_listings
DB --> Repo : items[], total
Svc -> Svc : getDeliveryCoords(ids) + getCampaignTransportSummaries(ids)
Svc --> Ctrl : { items, meta }
deactivate Svc
Ctrl --> Screen : return data (200)
deactivate Ctrl
Screen --> User : list of past runs

Screen -> Ctrl : GET /deliveries/my/ratings?page&limit
activate Ctrl
Ctrl -> Svc : getMyRatings(shipperUserId, page, limit)
activate Svc
Svc -> Repo : $queryRaw ratings JOIN reservations JOIN food_listings JOIN users
Svc -> Repo : $queryRaw COUNT(*) GROUP BY score (star distribution)
Repo -> DB : SELECT ratings
DB --> Repo : items[], distribution[]
Svc --> Ctrl : { avgRating, items, distribution, meta }
deactivate Svc
Ctrl --> Screen : return data (200)
deactivate Ctrl
Screen --> User : reviews and the star histogram
deactivate Screen
@enduml
