@startuml class-listing
title Listing Class Diagram

skinparam classAttributeIconSize 0
hide empty members

package "Listing" {
  class ListingsController {
    +findNearby()
    +findOne()
    +myListings()
    +getStats()
    +create()
    +update()
    +publish()
    +cancel()
    +remove()
    +duplicate()
  }

  class ListingsService {
    +findNearby()
    +findOne()
    +findByProvider()
    +getProviderStats()
    +create()
    +update()
    +publish()
    +cancel()
    +removeDraft()
    +duplicate()
  }

  class ListingsCron {
    +handleAutoExpire()
    +handleExpiryAlerts()
  }
}

class UploadsController
class StorageService
class SystemConfigService
class NotificationsService
class PrismaService

ListingsController --> ListingsService
ListingsService --> SystemConfigService
ListingsService --> PrismaService

ListingsCron --> NotificationsService
ListingsCron --> PrismaService

UploadsController --> StorageService
@enduml
