@startuml class-support
title Supporting Modules Class Diagram

skinparam classAttributeIconSize 0
hide empty members

package "Notifications" {
  class NotificationsController {
    +myNotifications()
    +unreadCount()
    +markRead()
    +markAllRead()
    +saveDeviceToken()
  }

  class NotificationsService {
    +notify()
    +notifyAdmins()
    +notifyCampaignOwner()
    +listMine()
    +unreadCount()
    +markRead()
    +markAllRead()
    +saveDeviceToken()
  }

  class NotificationsGateway {
    +handleConnection()
    +emitToUser()
  }
}

package "Reports" {
  class ReportsController {
    +create()
    +findMine()
  }

  class ReportsService {
    +create()
    +findMine()
  }
}

package "Recipes" {
  class RecipesController {
    +list()
    +mine()
    +findOne()
    +create()
    +update()
    +remove()
    +uploadImage()
  }

  class RecipesService {
    +list()
    +findOne()
    +create()
    +update()
    +remove()
    +saveRecipeImage()
  }
}

package "ESG" {
  class EsgController {
    +platform()
    +providerMe()
    +providerReport()
  }

  class EsgService {
    +getPlatformEsg()
    +getProviderEsg()
    +getProviderReport()
  }
}

package "Uploads" {
  class UploadsController {
    +uploadImage()
    +uploadRegisterEvidence()
  }

  class StorageService {
    +saveImage()
    +imageExists()
    +isCloudinaryConfigured()
  }
}

package "Common Services" {
  class SystemConfigService {
    +getNumber()
    +getAll()
    +set()
  }

  class TrustService {
    +applyDelta()
  }

  class FaceMatchService {
    +getFaceDescriptor()
    +compare()
    +assertNotDuplicateFace()
  }
}

class JwtService
class PrismaService

NotificationsController --> NotificationsService
NotificationsService --> NotificationsGateway
NotificationsService --> PrismaService
NotificationsGateway --> JwtService

ReportsController --> ReportsService
ReportsService --> NotificationsService
ReportsService --> PrismaService

RecipesController --> RecipesService
RecipesService --> StorageService
RecipesService --> PrismaService

EsgController --> EsgService
EsgService --> PrismaService

UploadsController --> StorageService

SystemConfigService --> PrismaService
TrustService --> SystemConfigService
TrustService --> PrismaService
FaceMatchService --> SystemConfigService
FaceMatchService --> PrismaService
@enduml
