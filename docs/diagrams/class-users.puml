@startuml class-user-volunteer
title Users & Volunteers Class Diagram

skinparam classAttributeIconSize 0
hide empty members

package "User Profile" {
  class UsersController {
    +getMe()
    +updateMe()
    +getTrustHistory()
    +getFaceEnrollment()
    +enrollFace()
    +getProviders()
    +getProviderListings()
  }

  class UsersService {
    +getMe()
    +updateMe()
    +getMeStats()
    +getTrustHistory()
    +getFaceEnrollmentStatus()
    +enrollFace()
    +getProviders()
    +getProviderListings()
  }
}

package "Volunteer" {
  class VolunteersController {
    +getMe()
    +setAvailability()
    +updateLocation()
    +getWeeklyAvailability()
    +setWeeklyAvailability()
    +getDeliveryShifts()
    +setDeliveryShifts()
  }

  class VolunteersService {
    +getMe()
    +setAvailability()
    +updateLocation()
    +getMyWeeklyAvailability()
    +setMyWeeklyAvailability()
    +getMyDeliveryShifts()
    +setMyDeliveryShifts()
  }
}

class StorageService
class FaceMatchService
class SystemConfigService
class NotificationsGateway
class PrismaService

UsersController --> UsersService
UsersService --> StorageService
UsersService --> FaceMatchService
UsersService --> PrismaService

VolunteersController --> VolunteersService
VolunteersService --> SystemConfigService
VolunteersService --> NotificationsGateway
VolunteersService --> PrismaService
@enduml
