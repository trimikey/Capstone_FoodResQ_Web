@startuml seq-campaign-find-suppliers
title Find Nearby Suppliers Sequence Diagram

actor "Charity Org" as User
participant ":SuppliersScreen\n(Map)" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB

User -> Screen : search for suppliers around the kitchen (radius, category)
activate Screen
Screen -> Ctrl : GET /campaigns/:id/supplier-matches?radiusKm&category
activate Ctrl
Ctrl -> Svc : suggestSuppliersForCampaign(campaignId, charityUserId, opts)
activate Svc
Svc -> Svc : assertOwner(campaignId, charityUserId)
Svc -> Repo : $queryRaw ST_X / ST_Y (kitchen_location)
Repo -> DB : SELECT kitchen_campaigns
DB --> Repo : { lng, lat } | null
Repo --> Svc : kitchen
alt Caller does not own the campaign
  Svc --> Ctrl : 403 Forbidden
  Ctrl --> Screen : return error
  Screen --> User : show error message
else the kitchen has no pinned coordinates
  Svc --> Ctrl : { matches: [], reason: 'NO_KITCHEN_LOCATION' }
  Ctrl --> Screen : return data (200)
  Screen --> User : prompt to pin the kitchen location first
else coordinates available
  Svc -> Repo : $queryRaw provider_profiles JOIN food_listings\nWHERE verification_status = 'approved' AND users.status = 'active'\nAND listing active, in date, still in stock\nAND ST_DWithin(location, kitchen, radiusM) ORDER BY ST_Distance
  Repo -> DB : SELECT ... GROUP BY provider
  DB --> Repo : rows[]
  Repo --> Svc : rows
  Svc --> Ctrl : { radiusKm, kitchen, matches[] }
  Ctrl --> Screen : return data (200)
  Screen --> User : render suppliers on the map and in a list
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

@startuml seq-campaign-send-request
title Send Provider Request Sequence Diagram

actor "Charity Org" as User
participant ":SuppliersScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Provider" as Provider

User -> Screen : pick a supplier, declare the demand (item, kg, date, pickup window),\naccept the non-commercial waiver
activate Screen
Screen -> Ctrl : POST /campaigns/requests (SendProviderRequestDto)
activate Ctrl
Ctrl -> Svc : sendProviderRequest(charityUserId, dto)
activate Svc
Svc -> Repo : receiverProfile.findUnique(userId) + user.findFirst(providerProfile.id)
Repo -> DB : SELECT receiver_profiles / users JOIN provider_profiles
DB --> Repo : rows
Repo --> Svc : receiver, provider
alt Organization or provider profile not found
  Svc --> Ctrl : 404 NotFound
else the non-commercial waiver was not accepted
  Svc --> Ctrl : 400 "The kitchen must commit to charitable, non-commercial use"
else pickup date / window missing, invalid or in the past
  Svc --> Ctrl : 400 BadRequest
else valid
  Svc -> Repo : campaignProviderRequest.findFirst(campaignId, providerId, status = pending)
  Repo --> Svc : existing | null
  alt a pending request already exists
    Svc -> Repo : campaignProviderRequest.update(demandDetails, message)
  else first time
    Svc -> Repo : campaignProviderRequest.create(status = pending)
  end
  Repo -> DB : INSERT / UPDATE campaign_provider_requests
  Svc -> Notif : notify(provider, "New ingredient request")
  Notif --> Provider : realtime notification
  Svc --> Ctrl : { message, requestId }
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : request sent, awaiting the provider
deactivate Screen
@enduml

@startuml seq-campaign-provider-review
title Provider Reviews Ingredient Request Sequence Diagram

actor "Provider" as User
participant ":ProviderRequestsScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Charity Org" as Charity

User -> Screen : open the ingredient request inbox
activate Screen
Screen -> Ctrl : GET /campaigns/provider-requests
activate Ctrl
Ctrl -> Svc : listMyProviderRequests(providerUserId)
activate Svc
Svc -> Repo : campaignProviderRequest.findMany(providerId) include receiver, campaign, transport
Repo -> DB : SELECT campaign_provider_requests JOIN ...
DB --> Repo : requests[]
Svc --> Ctrl : requests[]
deactivate Svc
Ctrl --> Screen : return data (200)
deactivate Ctrl
Screen --> User : render the request list

User -> Screen : accept (pickup time, listing to deduct from) or reject
Screen -> Ctrl : PATCH /campaigns/provider-requests/:requestId/review (action, note, pickupTime, listingId)
activate Ctrl
Ctrl -> Svc : reviewProviderRequest(providerUserId, requestId, action, note, opts)
activate Svc
Svc -> Repo : providerProfile.findUnique(userId) + campaignProviderRequest.findUnique(id)
Repo --> Svc : profile, request
alt Provider profile or request not found
  Svc --> Ctrl : 404 NotFound
else provider not approved / not active
  Svc --> Ctrl : 403 Forbidden
else the request belongs to another provider
  Svc --> Ctrl : 403 Forbidden
else status != pending
  Svc --> Ctrl : 400 "The request is already {status}"
else pickupTime is not in HH:mm format
  Svc --> Ctrl : 400 BadRequest
else valid
  opt accepting
    Svc -> Repo : kitchenCampaign.findUnique(campaignId) include donations
    Repo --> Svc : campaign
    Svc -> Svc : planStockDeduction(providerId, demand, listingId)
  end
  group $transaction
    Svc -> Repo : campaignProviderRequest.updateMany(id, status = pending → accepted / rejected,\nreviewedAt, scheduledDate, pickupStartTime, pickupEndTime)
    alt updated row count != 1
      Svc --> Ctrl : 409 "Another action already processed this request"
    end
    opt accepting
      Svc -> Repo : $executeRaw UPDATE food_listings SET quantity_remaining −= units\nWHERE status = 'active' AND quantity_remaining >= units
      alt no row updated (stock changed meanwhile)
        Svc --> Ctrl : 400 "Not enough stock left on the listing"
      end
      Svc -> Repo : campaignDonation.create(status = pledged, providerRequestId)
      Svc -> Repo : campaignTransport.create(providerRequestId, status = pending)
    end
    Repo -> DB : UPDATE requests / food_listings · INSERT donations / campaign_transports
  end
  Svc -> Notif : notify(charity, outcome + pickup date and time)
  Notif --> Charity : realtime notification
  opt accepting AND every supply target is now covered
    Svc -> Notif : notifyAdmins("Suppliers are ready for this campaign")
  end
  Svc --> Ctrl : { ...request, transportId, stockDeduction }
end
deactivate Svc
Ctrl --> Screen : return data (200) / error
deactivate Ctrl
Screen --> User : decision saved (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-ingredient-pickup
title Assign and Confirm Ingredient Pickup Sequence Diagram

actor "Charity Org" as Org
participant ":CampaignManageScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":StorageService" as Storage
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Campaign Shipper" as User

Org -> Screen : choose which on-shift volunteers collect the ingredients
activate Screen
Screen -> Ctrl : PATCH /campaigns/requests/:id/assign-pickup (assignmentIds)
activate Ctrl
Ctrl -> Svc : assignRequestPickup(requestId, charityUserId, dto)
activate Svc
Svc -> Repo : campaignProviderRequest.findUnique(id) include campaign, transport
Svc -> Repo : campaignVolunteerAssignment.findMany(assignmentIds) include shift, volunteer
Repo --> Svc : request, assignments
alt Request not found or not owned by this organization
  Svc --> Ctrl : 404 NotFound
else status != accepted OR no pickup schedule yet
  Svc --> Ctrl : 400 BadRequest
else an assignee is a chef / not approved / on another day / shift does not cover the pickup window
  Svc --> Ctrl : 400 BadRequest
else valid
  Svc -> Repo : campaignProviderRequest.update(pickupAssigneeIds)
  Repo -> DB : UPDATE campaign_provider_requests
  Svc -> Notif : notify(each new assignee, "You are assigned to collect ingredients")
  Notif --> User : realtime notification
  Svc --> Ctrl : { id, pickupAssigneeIds }
end
deactivate Svc
Ctrl --> Screen : return data (200) / error
deactivate Ctrl
Screen --> Org : pickup assigned

== Shipper collects the ingredients at the supplier ==
User -> Screen : take a photo of the collected goods, enter the received weight
Screen -> Ctrl : POST /campaigns/pickup-orders/:requestId/confirm (multipart photo, receivedKg, note?)
activate Ctrl
Ctrl -> Svc : saveProofPhoto(photo)
Svc -> Storage : saveImage(photo, 'campaign-proofs')
Storage --> Svc : photoUrl
Ctrl -> Svc : confirmIngredientPickup(requestId, userId, dto, photoUrl)
activate Svc
Svc -> Repo : campaignProviderRequest.findUnique(id) include campaign, provider
Svc -> Repo : volunteerProfile.findUnique(userId) + assignments of this campaign
Repo --> Svc : request, volunteer, assignments
alt No photo
  Svc --> Ctrl : 400 "A photo of the goods is required"
else Request not found / not accepted yet
  Svc --> Ctrl : 404 / 400 error
else the volunteer is not on an operations shift / not assigned to this pickup
  Svc --> Ctrl : 403 Forbidden
else the volunteer has not checked in
  Svc --> Ctrl : 400 "Check in before collecting the ingredients"
else receivedKg far above the requested amount OR already confirmed
  Svc --> Ctrl : 400 BadRequest
else valid
  Svc -> Repo : campaignIngredientPickup.create(requestId, volunteerId, receivedKg, photoUrl)
  Svc -> Repo : campaignVolunteerAssignment.update(ingredient proof)
  Svc -> Repo : campaignTransport.updateMany(status = delivered, pickedUpAt, deliveredAt)
  Repo -> DB : INSERT campaign_ingredient_pickups · UPDATE assignments / campaign_transports
  Svc -> Notif : notify(provider, "The goods were collected") · notify(org, "Ingredients are on the way")
  Svc --> Ctrl : pickup record
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : pickup confirmed (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-transport-receipt
title Confirm Transport Receipt Sequence Diagram

actor "Charity Org" as User
participant ":CampaignManageScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Provider" as Provider

User -> Screen : confirm the ingredients arrived at the kitchen
activate Screen
Screen -> Ctrl : POST /campaigns/:id/transports/:transportId/receive (note?)
activate Ctrl
Ctrl -> Svc : confirmTransportReceipt(campaignId, transportId, charityUserId, note)
activate Svc
Svc -> Repo : receiverProfile.findUnique(userId)
Svc -> Repo : campaignTransport.findFirst(id, campaignId, owned by this organization)
Repo -> DB : SELECT receiver_profiles / campaign_transports
DB --> Repo : receiver, transport | null
Repo --> Svc : receiver, transport
alt Organization profile or transport not found
  Svc --> Ctrl : 404 NotFound
else status = received (already confirmed)
  Svc --> Ctrl : current transport (idempotent)
else status != delivered
  Svc --> Ctrl : 400 "Confirm only after the shipper has handed over the goods"
else valid
  Svc -> Repo : campaignTransport.updateMany(status = delivered → received, receivedAt, note)
  Svc -> Repo : campaignDonation.updateMany(providerRequestId, pledged → received)
  Repo -> DB : UPDATE campaign_transports / campaign_donations
  Svc -> Notif : notify(provider, "The kitchen received {kg} kg — thank you")
  Notif --> Provider : realtime notification
  Svc --> Ctrl : transport
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : ingredients recorded as received (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-create-distribution
title Create Distribution Round Sequence Diagram

actor "Charity Org" as User
participant ":DistributionScreen\n(Map)" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB
actor "Volunteers" as Volunteers

User -> Screen : plan a distribution round (location, servings, assignees)
activate Screen
Screen -> Ctrl : POST /campaigns/:id/manage/distributions (CreateDistributionDto)
activate Ctrl
Ctrl -> Svc : createDistribution(campaignId, userId, dto)
activate Svc
Svc -> Svc : assertOwner(campaignId, userId)
Svc -> Repo : kitchenCampaign.findUnique(id)
Repo --> Svc : campaign
alt Caller does not own the campaign
  Svc --> Ctrl : 403 Forbidden
else status not in (in_progress, completed)
  Svc --> Ctrl : 400 "Distribution is recorded only while the campaign is running"
else valid
  Svc -> Repo : mealDistribution.aggregate(SUM servingsServed + leftover)
  Repo --> Svc : alreadyPlanned
  Svc -> Svc : cookedServingsSummary(campaignId)
  alt servings exceed the campaign target OR the cooked servings still available
    Svc --> Ctrl : 400 "Only {n} servings are available"
  else an assignee is not an approved volunteer of this campaign
    Svc --> Ctrl : 400 BadRequest
  else the point is too close to another point of the same round
    Svc --> Ctrl : 400 BadRequest
  else valid
    Svc -> Repo : mealDistribution.create(location, servingsServed, leftover, assigneeIds)
    Repo -> DB : INSERT meal_distributions
    Svc -> Notif : notify(each assignee, "You are assigned to a distribution round")
    Notif --> Volunteers : realtime notification
    Svc --> Ctrl : distribution
  end
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : distribution round created (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-close-distribution
title Close Distribution Round Sequence Diagram

actor "Volunteer / Charity Org" as User
participant ":DistributionTaskScreen\n(Camera)" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":StorageService" as Storage
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Charity Org" as Org

User -> Screen : take proof photos, enter the servings actually handed out
activate Screen
Screen -> Ctrl : POST /campaigns/distributions/:distributionId/complete (multipart photos, actualServings, note?)
activate Ctrl
Ctrl -> Svc : completeDistribution(distributionId, userId, dto, photos)
activate Svc
Svc -> Repo : mealDistribution.findUnique(id) include campaign
Repo -> DB : SELECT meal_distributions
DB --> Repo : distribution | null
Repo --> Svc : distribution
alt Distribution not found
  Svc --> Ctrl : 404 NotFound
else already completed
  Svc --> Ctrl : { id, completedAt, alreadyCompleted: true }
else actualServings < 0 OR above the planned servings
  Svc --> Ctrl : 400 BadRequest
else caller is neither an assignee nor the campaign owner
  Svc --> Ctrl : 403 Forbidden
else assignee who has not checked in
  Svc --> Ctrl : 400 "Check in before closing the round"
else valid
  Svc -> Storage : saveImage(each photo, 'campaign-proofs')
  Storage --> Svc : photoUrls[]
  Svc -> Repo : mealDistribution.updateMany(id, completedAt IS NULL\n→ completedAt, actualServings, proofPhotoUrls, completedBy)
  Repo -> DB : UPDATE meal_distributions
  DB --> Repo : count
  alt count != 1 (someone else closed it first)
    Svc --> Ctrl : { alreadyCompleted: true }
  else closed
    opt closed by an assignee
      Svc -> Notif : notify(org, "Distribution round finished")
      Notif --> Org : realtime notification
    end
    Svc --> Ctrl : { id, completedAt, actualServings, photos }
  end
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : round closed (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-incident
title Report and Handle Campaign Incident Sequence Diagram

actor "Campaign Shipper" as User
participant ":IncidentScreen\n(Camera)" as Screen
participant ":CampaignIncidentsController" as Ctrl
participant ":CampaignIncidentsService" as Svc
participant ":CampaignsService" as Campaigns
participant ":StorageService" as Storage
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Charity Org" as Org

User -> Screen : report a problem during a pickup or a distribution round
activate Screen
Screen -> Ctrl : POST /campaigns/:id/incidents (context, reasonCode, canContinue, referenceId?, photo?)
activate Ctrl
Ctrl -> Svc : report(campaignId, userId, dto, photo)
activate Svc
Svc -> Repo : volunteerProfile.findUnique(userId) + kitchenCampaign.findUnique(id)
Svc -> Repo : campaignVolunteerAssignment.findFirst(operations role in this campaign)
Repo -> DB : SELECT volunteer_profiles / kitchen_campaigns / assignments
DB --> Repo : rows
Repo --> Svc : volunteer, campaign, assignment
alt Invalid context / reason, or "cannot continue" without a reference
  Svc --> Ctrl : 400 BadRequest
else Volunteer or campaign not found
  Svc --> Ctrl : 404 NotFound
else the volunteer has no operations shift in this campaign
  Svc --> Ctrl : 403 Forbidden
else the referenced pickup order / distribution round is already finished
  Svc --> Ctrl : 400 BadRequest
else valid
  opt a photo is attached
    Svc -> Storage : saveImage(photo, 'campaign-incidents')
    Storage --> Svc : photoUrl
  end
  Svc -> Repo : campaignIncident.create(status = open, context, reason, canContinue, photoUrl)
  Repo -> DB : INSERT campaign_incidents
  opt canContinue = false
    Svc -> Repo : remove the volunteer from the pickup order / distribution round
    Repo -> DB : UPDATE campaign_provider_requests | meal_distributions
  end
  Svc -> Notif : notify(org, "Incident reported: {reason}")
  Notif --> Org : realtime notification
  Svc --> Ctrl : incident
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : incident sent to the organization (or show error message)

== Organization handles the incident ==
alt Assign other volunteers
  Org -> Screen : pick replacement volunteers
  Screen -> Ctrl : PATCH /campaigns/incidents/:incidentId/reassign (assignmentIds)
  activate Ctrl
  Ctrl -> Svc : reassign(incidentId, userId, ids)
  activate Svc
  Svc -> Repo : campaignIncident.findUnique(id) include campaign
  Repo --> Svc : incident
  alt Incident not found / caller does not own the campaign
    Svc --> Ctrl : 404 / 403 error
  else the incident is not linked to a pickup order or a round
    Svc --> Ctrl : 400 BadRequest
  else context = pickup
    Svc -> Campaigns : assignRequestPickup(requestId, userId, { assignmentIds })
  else context = distribution
    Svc -> Repo : mealDistribution.update(assigneeIds)
  end
  Svc -> Repo : campaignIncident.update(status = resolved, actionTaken = reassigned)
  Repo -> DB : UPDATE campaign_incidents
  Svc --> Ctrl : { id, status: resolved, reassignedTo }
else Close without reassigning
  Org -> Screen : mark the incident as handled, add a note
  Screen -> Ctrl : PATCH /campaigns/incidents/:incidentId/resolve (note?)
  activate Ctrl
  Ctrl -> Svc : resolve(incidentId, userId, note)
  activate Svc
  Svc -> Repo : campaignIncident.update(status = resolved, resolutionNote, resolvedAt)
  Repo -> DB : UPDATE campaign_incidents
  Svc -> Notif : notify(volunteer, "Your incident report was handled")
  Svc --> Ctrl : { id, status: resolved }
end
deactivate Svc
Ctrl --> Screen : return data (200) / error
deactivate Ctrl
Screen --> Org : incident closed
deactivate Screen
@enduml
