@startuml class-campaign-supply
title Campaign Supply Chain Class Diagram

skinparam classAttributeIconSize 0
hide empty members

package "Campaign Supply Chain" {
  class CampaignsController {
    +suggestSuppliers()
    +supplierReadiness()
    +sendProviderRequest()
    +listMySentRequests()
    +listMyProviderRequests()
    +reviewProviderRequest()
    +assignRequestPickup()
    +myPickupOrders()
    +confirmIngredientPickup()
    +retakeIngredientPickupPhoto()
    +receiveTransport()
    +createDistribution()
    +completeDistribution()
    +retakeDistributionPhoto()
    +myDistributionHistory()
  }

  class CampaignsService {
    +suggestSuppliersForCampaign()
    +supplierReadiness()
    +sendProviderRequest()
    +listMySentRequests()
    +listMyProviderRequests()
    +reviewProviderRequest()
    +assignRequestPickup()
    +myPickupOrders()
    +confirmIngredientPickup()
    +retakeIngredientPickupPhoto()
    +confirmTransportReceipt()
    +cookedServingsSummary()
    +createDistribution()
    +completeDistribution()
    +retakeDistributionPhoto()
    +myDistributionHistory()
  }

  class CampaignIncidentsController {
    +report()
    +list()
    +reassign()
    +assignDistribution()
    +resolve()
  }

  class CampaignIncidentsService {
    +report()
    +list()
    +reassign()
    +reassignDistributionByOwner()
    +resolve()
  }
}

class StorageService
class SystemConfigService
class NotificationsService
class PrismaService

CampaignsController --> CampaignsService
CampaignIncidentsController --> CampaignIncidentsService
CampaignIncidentsService --> CampaignsService

CampaignsService --> StorageService
CampaignsService --> SystemConfigService
CampaignsService --> NotificationsService
CampaignsService --> PrismaService

CampaignIncidentsService --> StorageService
CampaignIncidentsService --> NotificationsService
CampaignIncidentsService --> PrismaService
@enduml
