@startuml class-auth
title Auth Class Diagram

skinparam classAttributeIconSize 0
hide empty members

package "Auth" {
  class AuthController {
    +register()
    +login()
    +google()
    +firebase()
    +refresh()
    +logout()
    +forgotPassword()
    +resetPassword()
    +checkEmail()
    +checkPhone()
  }

  class AuthService {
    +register()
    +login()
    +loginWithGoogle()
    +loginWithFirebase()
    +refresh()
    +logout()
    +forgotPassword()
    +resetPassword()
    +checkEmailExists()
    +checkPhoneExists()
  }

  class JwtAuthGuard
  class JwtStrategy {
    +validate()
  }
}

class JwtService
class FaceMatchService
class StorageService
class FirebaseAdminService
class NotificationsService
class Redis
class PrismaService

AuthController --> AuthService
AuthController ..> JwtAuthGuard
JwtAuthGuard ..> JwtStrategy

AuthService --> JwtService
AuthService --> FaceMatchService
AuthService --> StorageService
AuthService --> FirebaseAdminService
AuthService --> NotificationsService
AuthService --> Redis
AuthService --> PrismaService
JwtStrategy --> PrismaService
@enduml
