@startuml seq-cron-order-jobs
title Order Lifecycle Scheduled Jobs Sequence Diagram

participant ":ReservationsCron" as ResCron
participant ":DeliveriesCron" as DelCron
participant ":ReservationsService" as Res
participant ":DeliveriesService" as Del
participant ":TrustService" as Trust
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
participant ":NotificationCenter" as Screen
actor "Receiver / Shipper" as User

group A. Every minute — expire overdue orders
  ResCron -> Res : expireNoShows()
  activate Res
  Res -> Repo : reservation.findMany(confirmed, qrExpiresAt < now,\nno delivery OR delivery cancelled)
  Repo -> DB : SELECT reservations LEFT JOIN deliveries
  DB --> Repo : selfPickup[]
  Repo --> Res : selfPickup
  loop for each overdue self-pickup order
    group $transaction
      Res -> Repo : reservation.update(status = no_show) + restore stock + reservationsToday −1
      Repo -> DB : UPDATE reservations / food_listings / receiver_profiles
    end
    Res -> Trust : applyDelta(receiver, −RESERVATION_NO_SHOW_PENALTY, NO_SHOW)
  end
  Res -> Repo : reservation.findMany(confirmed, qrExpiresAt < now,\ndelivery in pending_assignment / failed)
  Repo --> Res : unassigned[]
  loop for each delivery order nobody claimed
    group $transaction
      Res -> Repo : reservation.update(status = expired) + delivery.update(failed) + restore stock
      Repo -> DB : UPDATE reservations / deliveries / food_listings
    end
  end
  Res -> Notif : notify(receiver, the new order status)
  deactivate Res
end

group B. Daily at 00:00 — reset the daily quota
  ResCron -> Res : resetDailyReservationCounters()
  activate Res
  Res -> Repo : receiverProfile.updateMany(reservationsToday = 0)
  Repo -> DB : UPDATE receiver_profiles
  deactivate Res
end

group C. Every 30 seconds — close deliveries nobody claimed
  DelCron -> Del : expireUnclaimedDeliveries()
  activate Del
  Del -> Repo : delivery.findMany(status = pending_assignment) include reservation
  Repo -> DB : SELECT deliveries JOIN reservations
  DB --> Repo : candidates[]
  Repo --> Del : candidates
  loop for each waiting delivery
    Del -> Del : deadline = immediate: createdAt + DELIVERY_CLAIM_WINDOW_MINUTES\nscheduled: deliveryScheduledAt − DELIVERY_SCHEDULED_CUTOFF_MINUTES
    opt now > deadline
      group $transaction
        Del -> Repo : delivery.update(failed) + reservation.update(cancelled)\n+ restore stock + reservationsToday −1
        Repo -> DB : UPDATE deliveries / reservations / food_listings / receiver_profiles
      end
      Del -> Notif : notify(receiver, "No volunteer claimed the delivery — please order again")
    end
  end
  deactivate Del
end

group D. Every 5 minutes — auto-fail stalled deliveries
  DelCron -> Del : expireStalledDeliveries()
  activate Del
  Del -> Repo : delivery.findMany(in progress, updatedAt < now − DELIVERY_STALL_HOURS (6h))
  Repo -> DB : SELECT deliveries
  DB --> Repo : stalled[]
  Repo --> Del : stalled
  loop for each stalled delivery
    group $transaction
      Del -> Repo : delivery.update(failed) + reservation.update(expired)\n+ restore stock when not yet picked up + free the shipper
      Repo -> DB : UPDATE deliveries / reservations / food_listings / volunteer_profiles
    end
    Del -> Notif : notify(receiver, "The delivery failed")
  end
  deactivate Del
end

Notif --> Screen : 'notification:new'
activate Screen
Screen --> User : order status and trust score refresh on screen
deactivate Screen
@enduml

@startuml seq-cron-campaign-recruitment
title Campaign Recruitment Lifecycle Scheduled Job Sequence Diagram

participant ":CampaignsCron\n(every minute)" as Cron
participant ":CampaignsService" as Svc
participant ":SystemConfigService" as Cfg
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
participant ":NotificationCenter" as Screen
actor "Charity Org / Volunteer" as User

Cron -> Svc : advanceRecruitmentLifecycle()
activate Svc
Svc -> Repo : kitchenCampaign.findMany(status = approved)
Repo -> DB : SELECT kitchen_campaigns
DB --> Repo : campaigns[]
Repo --> Svc : campaigns
Svc -> Cfg : getNumber(CAMPAIGN_MIN_FILL_PERCENT)
Cfg --> Svc : minPercent
loop for each approved campaign
  Svc -> Svc : refreshRecruitmentStatus(campaignId)\nscheduled → open → staffed → closed_ready / expired_understaffed
  opt the recruitment status changed
    Svc -> Repo : kitchenCampaign.update(recruitmentStatus)
    Svc -> Notif : notify(charity, the new recruitment status)
  end
  opt now >= operationStartAt
    group $transaction
      Svc -> Repo : $queryRaw SELECT kitchen_campaigns FOR UPDATE
      Svc -> Svc : getStaffingReadiness(campaignId)
      alt below the minimum confirmed staffing
        Svc -> Repo : kitchenCampaign.update(recruitmentStatus = expired_understaffed)
      else minimum reached but not every slot confirmed
        Svc -> Repo : kitchenCampaign.update(recruitmentStatus = closed_ready)
      else every slot confirmed
        Svc -> Repo : kitchenCampaign.update(status = in_progress, recruitmentStatus = closed_ready)
      end
      Repo -> DB : UPDATE kitchen_campaigns
    end
    opt the campaign started automatically
      Svc -> Notif : notify(charity and confirmed volunteers, "The campaign has started")
    end
  end
end
Svc --> Cron : { refreshed, started }
deactivate Svc
Notif --> Screen : 'notification:new'
activate Screen
Screen --> User : recruitment status and campaign status refresh
deactivate Screen
@enduml

@startuml seq-cron-campaign-close
title Auto-close Campaigns Scheduled Job Sequence Diagram

participant ":CampaignsCron" as Cron
participant ":CampaignsService" as Svc
participant ":TrustService" as Trust
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
participant ":NotificationCenter" as Screen
actor "Charity Org / Volunteer" as User

group A. Daily at 00:00 — drafts never approved and campaigns that never started
  Cron -> Svc : purgeStalePendingCampaigns()
  activate Svc
  Svc -> Repo : kitchenCampaign.findMany(status = pending_approval,\nolder than CAMPAIGN_PENDING_PURGE_DAYS)
  Repo --> Svc : stale[]
  opt stale campaigns found
    Svc -> Repo : kitchenCampaign.deleteMany(id in stale)
    Repo -> DB : DELETE kitchen_campaigns
    Svc -> Notif : notify(charity, "The pending campaign was removed")
  end
  Cron -> Svc : expireOverdueCampaigns()
  Svc -> Repo : kitchenCampaign.findMany(status = approved, operationStartAt <= now,\nrecruitmentStatus != expired_understaffed)
  Repo --> Svc : overdue[]
  opt overdue campaigns found
    Svc -> Repo : kitchenCampaign.updateMany(recruitmentStatus = expired_understaffed)
    Repo -> DB : UPDATE kitchen_campaigns
    Svc -> Notif : notify(charity and applicants, "Not enough volunteers — the campaign cannot start")
  end
  deactivate Svc
end

group B. Hourly — running campaigns past their end time
  Cron -> Svc : autoCompleteExpiredCampaigns()
  activate Svc
  Svc -> Repo : kitchenCampaign.findMany(status = in_progress, operationEndAt < now)
  Repo -> DB : SELECT kitchen_campaigns
  DB --> Repo : expired[]
  Repo --> Svc : expired
  opt expired campaigns found
    Svc -> Repo : kitchenCampaign.updateMany(id in expired, status = completed)
    Repo -> DB : UPDATE kitchen_campaigns
    Svc -> Notif : notify(charity, "Campaign closed automatically")
  end
  Cron -> Svc : releaseVolunteersOfFinishedCampaigns()
  Svc -> Repo : close assignments still open in finished campaigns
  Repo -> DB : UPDATE campaign_volunteer_assignments
  deactivate Svc
end

group C. Hourly — volunteers who never checked in
  Cron -> Svc : markAbsentVolunteers()
  activate Svc
  Svc -> Repo : campaignVolunteerAssignment.findMany(status = assigned,\nno check-in, shift already over)
  Repo --> Svc : stale[]
  opt stale assignments found
    Svc -> Repo : assignment.updateMany(status = absent) + slotsFilled −1
    Repo -> DB : UPDATE assignments / kitchen_campaigns / campaign_shifts
    Svc -> Trust : applyDelta(volunteer, −VOLUNTEER_NO_SHOW_PENALTY, VOLUNTEER_NO_SHOW)
    Svc -> Notif : notify(volunteer and charity, "Marked absent")
  end
  deactivate Svc
end

Notif --> Screen : 'notification:new'
activate Screen
Screen --> User : the campaign status refreshes on the manage screen
deactivate Screen
@enduml

@startuml seq-cron-dish-steps
title Unlock Cooking Steps Scheduled Job Sequence Diagram

participant ":CampaignsCron\n(every 30 seconds)" as Cron
participant ":DishStepsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB
participant ":KitchenBoardScreen" as Screen
actor "Chef" as User

Cron -> Svc : autoOpenAvailableSteps()
activate Svc
Svc -> Svc : window = [VN yesterday, VN tomorrow)
Svc -> Repo : kitchenCampaign.findMany(status in in_progress / approved,\ndates within the window)
Repo -> DB : SELECT kitchen_campaigns
DB --> Repo : campaigns[]
Repo --> Svc : campaigns
alt No campaign in the window
  Svc --> Cron : 0
else campaigns found
  Svc -> Repo : campaignDishStep.findMany(campaignId in campaigns,\nstatus in locked / available) order menuItemId, stepOrder
  Repo -> DB : SELECT campaign_dish_steps
  DB --> Repo : steps[]
  Repo --> Svc : steps
  loop for each dish, walking its steps in order
    Svc -> Svc : due = now >= stepDueAtUtc(campaignTiming, step.scheduledTime)
    alt due AND previous step done (QC approved) AND ingredients received AND status = locked
      Svc -> Svc : add the step to toOpen[]
    else not eligible yet
      Svc -> Svc : leave it locked
    end
  end
  alt toOpen is empty
    Svc --> Cron : 0
  else steps became eligible
    Svc -> Repo : campaignDishStep.updateMany(id in toOpen, locked → available, openedAt)
    Repo -> DB : UPDATE campaign_dish_steps
    DB --> Repo : count
    Svc --> Cron : count
    Repo --> Screen : the board polls and shows the step as available
    activate Screen
    Screen --> User : the next cooking step unlocks
    deactivate Screen
  end
end
deactivate Svc
@enduml

@startuml seq-cron-bulk-cleanup
title Clean Up Abandoned Bulk Runs Scheduled Job Sequence Diagram

participant ":BulkRunsCron\n(every 10 minutes)" as Cron
participant ":BulkRunsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB
participant ":BulkRunScreen" as Screen
actor "Shipper / Provider" as User

Cron -> Svc : expireStalled()
activate Svc

group A. Requested too long ago — the provider never reviewed it
  Svc -> Repo : bulkRun.updateMany(status = requested,\ncreatedAt < now − REQUEST_EXPIRY_HOURS, status = cancelled)
  Repo -> DB : UPDATE bulk_runs
  DB --> Repo : count
end

group B. Approved but the shipper never collected
  Svc -> Repo : bulkRun.findMany(status = approved,\napprovedAt < now − PICKUP_DEADLINE_HOURS)
  Repo -> DB : SELECT bulk_runs
  DB --> Repo : notPickedUp[]
  Repo --> Svc : notPickedUp
  loop for each run
    group $transaction
      Svc -> Repo : bulkRun.update(status = cancelled, rejectReason)
      Svc -> Repo : restockSql(listingId, quantity) — return the whole batch
      Repo -> DB : UPDATE bulk_runs / food_listings
    end
  end
end

group C. Picked up but the run never finished
  Svc -> Repo : bulkRun.findMany(status = picked_up,\npickedUpAt < now − RUN_COMPLETION_HOURS)
  Repo -> DB : SELECT bulk_runs
  DB --> Repo : overdue[]
  Repo --> Svc : overdue
  loop for each run
    Svc -> Svc : leftover = quantity − quantityDistributed
    group $transaction
      Svc -> Repo : bulkRun.update(status = completed, completedAt, rejectReason)
      opt leftover > 0
        Svc -> Repo : restockSql(listingId, leftover)
      end
      Repo -> DB : UPDATE bulk_runs / food_listings
    end
  end
end

Svc --> Cron : number of runs closed
deactivate Svc
Repo --> Screen : the run list reloads
activate Screen
Screen --> User : the run shows as cancelled or completed, stock is back on the listing
deactivate Screen
@enduml
