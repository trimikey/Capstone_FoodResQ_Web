@startuml class-reservation
title Reservation Class Diagram

skinparam classAttributeIconSize 0
hide empty members

package "Reservation" {
  class ReservationsController {
    +create()
    +myReservations()
    +providerReservations()
    +findOne()
    +scanQr()
    +confirmPickup()
    +submitPickupProof()
    +cancel()
    +providerCancel()
    +rate()
    +getMessages()
    +sendMessage()
  }

  class ReservationsService {
    +create()
    +findMyReservations()
    +findProviderReservations()
    +findOne()
    +scanQr()
    +confirmPickupByProvider()
    +submitPickupProof()
    +cancel()
    +providerCancel()
    +rateReservation()
    +getMessages()
    +sendMessage()
    +expireNoShows()
    +resetDailyReservationCounters()
  }

  class ReservationsCron {
    +handleNoShows()
    +handleDailyReset()
  }
}

class Redlock
class SystemConfigService
class FaceMatchService
class StorageService
class TrustService
class NotificationsService
class PrismaService

ReservationsController --> ReservationsService
ReservationsCron --> ReservationsService

ReservationsService --> Redlock
ReservationsService --> SystemConfigService
ReservationsService --> FaceMatchService
ReservationsService --> StorageService
ReservationsService --> TrustService
ReservationsService --> NotificationsService
ReservationsService --> PrismaService
@enduml
