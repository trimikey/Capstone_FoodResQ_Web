@startuml class-admin
title Admin Class Diagram

skinparam classAttributeIconSize 0
hide empty members

package "Admin" {
  class AdminController {
    +stats()
    +overview()
    +verifications()
    +review()
    +users()
    +createUser()
    +setUserStatus()
    +campaigns()
    +campaignDetail()
    +approveCampaign()
    +rejectCampaign()
