  class AdminOperationsService {
    +listProviders()
    +listVolunteers()
    +deliveryMonitor()
    +listCampaignIncidents()
  }
}

class SystemConfigService {
  +getNumber()
  +getAll()
  +set()
}
class NotificationsService
class PrismaService

AdminController --> AdminService
AdminController --> AdminOperationsService

AdminService --> SystemConfigService
AdminService --> NotificationsService
AdminService --> PrismaService

AdminOperationsService --> SystemConfigService
AdminOperationsService --> PrismaService
@enduml
