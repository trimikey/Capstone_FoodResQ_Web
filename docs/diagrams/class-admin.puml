    +foodListings()
    +foodCatalog()
    +reports()
    +resolveReport()
    +configs()
    +setConfig()
    +providers()
    +volunteersOverview()
    +deliveryMonitor()
    +campaignIncidents()
  }

  class AdminService {
    +getStats()
    +getOverview()
    +listVerifications()
    +reviewVerification()
    +listUsers()
    +adminCreateUser()
    +setUserStatus()
    +listCampaigns()
    +getCampaignDetail()
    +setCampaignStatus()
    +listCampaignChangeRequests()
    +reviewCampaignChangeRequest()
    +listFoodListings()
    +listFoodCatalog()
    +listReports()
    +resolveReport()
