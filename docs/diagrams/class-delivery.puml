@startuml class-delivery
title Delivery Class Diagram

skinparam classAttributeIconSize 0
hide empty members

package "Delivery" {
  class DeliveriesController {
    +nearbySettings()
    +nearbyPending()
    +claim()
    +getMyActive()
    +updateStatus()
    +cancel()
    +fail()
    +receiverCancel()
    +track()
    +getMyStats()
    +getMyHistory()
    +myRatings()
  }

  class DeliveriesService {
    +getClaimRadiusKm()
    +getNearbyPendingDeliveries()
    +claimDelivery()
    +getMyActiveDelivery()
    +updateStatus()
    +saveProofPhoto()
    +cancelAssignment()
    +failDelivery()
    +cancelDeliverySearchByReceiver()
    +getTrackingForReceiver()
    +getMyStats()
    +getMyDeliveryHistory()
    +getMyRatings()
    +expireUnclaimedDeliveries()
    +expireStalledDeliveries()
  }

  class DeliveriesCron {
    +handleUnclaimedSweep()
    +handleStalledDeliveries()
  }
}

class SystemConfigService
class StorageService
class TrustService
class NotificationsService
class NotificationsGateway
class PrismaService

DeliveriesController --> DeliveriesService
DeliveriesCron --> DeliveriesService

DeliveriesService --> SystemConfigService
DeliveriesService --> StorageService
DeliveriesService --> TrustService
DeliveriesService --> NotificationsService
DeliveriesService --> NotificationsGateway
DeliveriesService --> PrismaService
@enduml
