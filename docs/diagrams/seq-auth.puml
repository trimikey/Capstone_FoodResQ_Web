'==============================================================
' FoodResQ — Sequence Diagrams: Auth (4)
' 01. Register · 02. Login · 03. Token Lifecycle · 04. Password Reset
'==============================================================

'──────────────────── 01. Register ───────────────────────────
@startuml seq-auth-register
title Register Sequence Diagram

actor "User" as User
participant ":RegisterScreen" as Screen
participant ":AuthController" as Ctrl
participant ":AuthService" as Svc
participant ":FaceMatchService" as Face
participant ":StorageService" as Storage
participant ":bcrypt" as Bcrypt
participant ":JwtService" as Jwt
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : fill register form (role, email, phone, selfie)
activate Screen
Screen -> Ctrl : POST /auth/check-email · /auth/check-phone
activate Ctrl
Ctrl -> Svc : checkEmailExists / checkPhoneExists
activate Svc
Svc -> Repo : user.findUnique(email / phone)
Repo --> Svc : row | null
Svc --> Ctrl : { exists }
deactivate Svc
Ctrl --> Screen : return data (201)
deactivate Ctrl
Screen --> User : inline validation hint

Screen -> Ctrl : POST /auth/register (RegisterDto + selfie)
activate Ctrl
Ctrl -> Svc : register(dto, selfie)
activate Svc
Svc -> Repo : user.findUnique(email)
Repo -> DB : SELECT users
DB --> Repo : existing | null
Repo --> Svc : existing

alt Email already registered
  Svc --> Ctrl : 409 Conflict
else available
  alt role = receiver / volunteer (individual)
    Svc -> Face : getFaceDescriptor(selfie)
    activate Face
    Face --> Svc : descriptor | null
    deactivate Face
    alt No face detected
      Svc --> Ctrl : 400 "No face detected in the selfie"
    else face detected
      Svc -> Storage : saveImage(selfie, 'faces')
      Storage --> Svc : faceImageUrl
    end
  end
  Svc -> Bcrypt : hash(password, 12)
  Bcrypt --> Svc : passwordHash
  group $transaction
    Svc -> Repo : user.create(status = pending_verification | active)
    Svc -> Repo : create role profile (receiver / volunteer / provider)
    Repo -> DB : INSERT users + profile
  end
  Svc -> Jwt : sign(access 15m) + sign(refresh 30d)
  Jwt --> Svc : tokens
  Svc -> Bcrypt : hash(refreshToken)
  Svc -> Repo : refreshToken.create(tokenHash, expiresAt)
  Repo -> DB : INSERT refresh_tokens
  Svc --> Ctrl : { accessToken, refreshToken, user }
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : account created (or show error message)
deactivate Screen
@enduml

'──────────────────── 02. Login ──────────────────────────────
@startuml seq-auth-login
title Login Sequence Diagram

actor "User" as User
participant ":LoginScreen" as Screen
participant ":AuthController" as Ctrl
participant ":AuthService" as Svc
participant ":OAuth2Client\n(Google / Firebase)" as OAuth
participant ":bcrypt" as Bcrypt
participant ":JwtService" as Jwt
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : choose a login method
activate Screen

alt email + password
  Screen -> Ctrl : POST /auth/login (email, password)
  activate Ctrl
  Ctrl -> Svc : login(dto, deviceInfo, ipAddress)
  activate Svc
  Svc -> Repo : user.findUnique(email)
  Repo -> DB : SELECT users
  DB --> Repo : user | null
  Repo --> Svc : user
  Svc -> Bcrypt : compare(password, user.passwordHash)
  Bcrypt --> Svc : matched?
  alt Not found OR wrong password
    Svc --> Ctrl : 401 "Incorrect email or password"
  end
else Google / Firebase
  Screen -> Ctrl : POST /auth/google · /auth/firebase (idToken)
  activate Ctrl
  Ctrl -> Svc : loginWithGoogle / loginWithFirebase(idToken)
  activate Svc
  Svc -> OAuth : verifyIdToken(idToken, audience)
  activate OAuth
  OAuth --> Svc : { email, name, picture } | throw
  deactivate OAuth
  alt Invalid token OR email not verified
    Svc --> Ctrl : 401 "Invalid token"
  else verified
    Svc -> Repo : user.findUnique(email)
    Repo --> Svc : user | null
    opt No account yet
      Svc -> Bcrypt : hash(random 32 bytes, 12)
      group $transaction
        Svc -> Repo : user.create(role = receiver, status = active)
        Svc -> Repo : receiverProfile.create(userId)
        Repo -> DB : INSERT users + receiver_profiles
      end
    end
  end
end

alt user.status = banned
  Svc --> Ctrl : 401 "Account is banned"
else active
  Svc -> Jwt : sign(access 15m) + sign(refresh 30d)
  Jwt --> Svc : tokens
  Svc -> Bcrypt : hash(refreshToken)
  Svc -> Repo : refreshToken.create(tokenHash, deviceInfo, ipAddress, expiresAt)
  Repo -> DB : INSERT refresh_tokens
  Svc --> Ctrl : { accessToken, refreshToken, user }
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : logged in (or show error message)
deactivate Screen
@enduml

'──────────────────── 03. Token Lifecycle ────────────────────
@startuml seq-auth-token-lifecycle
!include _seq-style.iuml
title Refresh Token and Logout Sequence Diagram

actor "User" as User
participant ":AppShell\n(axios interceptor)" as Screen
participant ":AuthController" as Ctrl
participant ":JwtAuthGuard" as Guard
participant ":AuthService" as Svc
participant ":bcrypt" as Bcrypt
participant ":JwtService" as Jwt
participant ":PrismaService" as Repo
database "Database" as DB

alt access token expired (401 from any API call)
  User -> Screen : keep using the app
  activate Screen
  Screen -> Ctrl : POST /auth/refresh (refreshToken)
  activate Ctrl
  Ctrl -> Svc : refresh(refreshToken)
  activate Svc
  Svc -> Jwt : verify(refreshToken, JWT_REFRESH_SECRET)
  Jwt --> Svc : payload | throw
  Svc -> Repo : refreshToken.findMany(userId, isRevoked = false, expiresAt > now)
  Repo -> DB : SELECT refresh_tokens
  DB --> Repo : tokens[]
  Repo --> Svc : tokens
  Svc -> Bcrypt : compare(refreshToken, token.tokenHash) for each row
  Bcrypt --> Svc : matched | none
  alt Token invalid / revoked / expired
    Svc --> Ctrl : 401 Unauthorized
    Ctrl --> Screen : return error
    Screen --> User : redirect to the login screen
  else valid
    group $transaction
      Svc -> Repo : refreshToken.update(old row → isRevoked = true)
      Svc -> Jwt : sign(new access) + sign(new refresh)
      Svc -> Repo : refreshToken.create(new tokenHash)
      Repo -> DB : UPDATE + INSERT refresh_tokens
    end
    Svc --> Ctrl : { accessToken, refreshToken }
    Ctrl --> Screen : return data (201)
    Screen --> User : original request replayed, no visible interruption
  end
  deactivate Svc
  deactivate Ctrl
else user taps logout
  User -> Screen : tap "Log out"
  Screen -> Ctrl : POST /auth/logout (Bearer token)
  activate Ctrl
  Ctrl -> Guard : validate JWT
  activate Guard
  Guard --> Ctrl : CurrentUser
  deactivate Guard
  Ctrl -> Svc : logout(user.id)
  activate Svc
  Svc -> Repo : refreshToken.updateMany(userId, isRevoked = false → true)
  Repo -> DB : UPDATE refresh_tokens
  Svc --> Ctrl : void
  deactivate Svc
  Ctrl --> Screen : return data (200)
  deactivate Ctrl
  Screen --> User : logged out on every device
end
deactivate Screen
@enduml

'──────────────────── 04. Password Reset ─────────────────────
@startuml seq-auth-password-reset
!include _seq-style.iuml
title Forgot and Reset Password Sequence Diagram

actor "User" as User
participant ":ForgotPasswordScreen" as Screen
participant ":AuthController" as Ctrl
participant ":AuthService" as Svc
participant ":Redis" as Redis
participant ":MailService" as Mail
participant ":bcrypt" as Bcrypt
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : enter the registered email
activate Screen
Screen -> Ctrl : POST /auth/forgot-password (email)
activate Ctrl
Ctrl -> Svc : forgotPassword(dto)
activate Svc
Svc -> Repo : user.findUnique(email, deletedAt = null)
Repo -> DB : SELECT users
DB --> Repo : user | null
Repo --> Svc : user
alt Not found OR status = banned
  Svc --> Ctrl : { message } — identical to the success case
else eligible
  Svc -> Svc : token = randomBytes(32).base64url\ntokenHash = sha256(token)
  Svc -> Redis : SETEX reset:{tokenHash} TTL { userId }
  Svc -> Mail : sendPasswordResetEmail(email, fullName, token)
  Mail --> User : email containing the raw token link
  Svc --> Ctrl : { message }
end
deactivate Svc
Ctrl --> Screen : return data (201)
deactivate Ctrl
Screen --> User : "if the email exists, instructions have been sent"

User -> Screen : open the link, enter a new password
Screen -> Ctrl : POST /auth/reset-password (token, password)
activate Ctrl
Ctrl -> Svc : resetPassword(dto)
activate Svc
Svc -> Redis : GET reset:{sha256(token)}
Redis --> Svc : payload | null
alt Key missing / payload unparseable / user banned
  Svc -> Redis : DEL reset:{tokenHash}
  Svc --> Ctrl : 400 "Reset code is invalid or expired"
  Ctrl --> Screen : return error
  Screen --> User : ask for a new reset link
else valid
  Svc -> Repo : user.findUnique(userId, deletedAt = null)
  Repo --> Svc : user
  Svc -> Bcrypt : hash(newPassword, 12)
  Bcrypt --> Svc : passwordHash
  group $transaction
    Svc -> Repo : user.update(passwordHash)
    Svc -> Repo : refreshToken.updateMany(userId → isRevoked = true)
    Repo -> DB : UPDATE users / refresh_tokens
  end
  Svc -> Redis : DEL reset:{tokenHash}
  Svc --> Ctrl : { message }
  Ctrl --> Screen : return data (201)
  Screen --> User : "password reset — please log in again"
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml
