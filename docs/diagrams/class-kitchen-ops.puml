@startuml class-kitchen-ops
title Kitchen Operations Class Diagram

skinparam classAttributeIconSize 0
hide empty members

package "Kitchen Operations" {
  class KitchenOpsController {
    +listShifts()
    +addMenuItem()
    +listMenuItems()
    +removeMenuItem()
    +createSafetyLog()
    +listSafetyLogs()
    +listDistributions()
    +distributionSummary()
    +issueHandoffQr()
    +scanHandoff()
    +listMyHandoffs()
    +submitBeneficiaryFeedback()
    +beneficiaryFeedbackSummary()
  }

  class KitchenOpsService {
    +listShifts()
    +addMenuItem()
    +listMenuItems()
    +removeMenuItem()
    +createSafetyLog()
    +listSafetyLogs()
    +listDistributions()
    +distributionSummary()
    +issueHandoffQr()
    +scanHandoff()
    +listMyHandoffs()
    +submitBeneficiaryFeedback()
    +beneficiaryFeedbackSummary()
  }

  class DishStepsController {
    +setStepTimes()
    +listSteps()
    +completeStep()
    +retakeStepProof()
    +reviewQcStep()
    +listSupplies()
  }

  class DishStepsService {
    +ensureStepsForMenuItem()
    +setScheduledTimes()
    +getStepsForCampaign()
    +completeStep()
    +retakeStepProof()
    +reviewQcStep()
    +approveDishFinalStep()
    +rejectDishFinalStep()
    +getCampaignSupplies()
    +getWeeklySchedule()
    +autoOpenAvailableSteps()
  }

  class WeeklyScheduleController {
    +weekly()
  }
}

class SystemConfigService
class StorageService
class NotificationsService
class PrismaService

KitchenOpsController --> KitchenOpsService
DishStepsController --> DishStepsService
WeeklyScheduleController --> DishStepsService

KitchenOpsService --> SystemConfigService
KitchenOpsService --> StorageService
KitchenOpsService --> NotificationsService
KitchenOpsService --> PrismaService

DishStepsService --> SystemConfigService
DishStepsService --> StorageService
DishStepsService --> NotificationsService
DishStepsService --> PrismaService
@enduml
