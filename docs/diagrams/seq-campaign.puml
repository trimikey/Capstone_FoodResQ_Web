@startuml seq-campaign-create
title Create Kitchen Campaign Sequence Diagram

actor "Charity Org" as User
participant ":CampaignFormScreen\n(Map)" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":StorageService" as Storage
participant ":DishStepsService" as Steps
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB
actor "Admin" as Admin

User -> Screen : fill the campaign form (dates, operating shifts, staffing per shift,\nmenu, supplies, recruitment window)
activate Screen
Screen -> Ctrl : POST /campaigns/upload-image (cover photo)
activate Ctrl
Ctrl -> Svc : saveCampaignImage(image)
activate Svc
Svc -> Storage : saveImage(file, 'campaigns')
activate Storage
Storage --> Svc : coverImageUrl
deactivate Storage
Svc --> Ctrl : url
deactivate Svc
Ctrl --> Screen : { url } (201)
deactivate Ctrl

Screen -> Ctrl : POST /campaigns (CreateCampaignDto)
activate Ctrl
Ctrl -> Svc : create(userId, dto)
activate Svc
Svc -> Repo : receiverProfile.findUnique(userId) select id, isCharityOrg
Repo -> DB : SELECT receiver_profiles
DB --> Repo : receiver | null
Repo --> Svc : receiver
alt No receiver profile
  Svc --> Ctrl : 404 NotFound
else isCharityOrg = false
  Svc --> Ctrl : 403 "Only charity organizations can create campaigns"
else no menu item OR no shift staffing
  Svc --> Ctrl : 400 "A campaign needs at least one dish and one shift"
else shifts not consecutive OR duplicated staffing rows
  Svc --> Ctrl : 400 BadRequest
else dates in the past / end before start / longer than 30 days
  Svc --> Ctrl : 400 "Invalid schedule"
else recruitment window invalid (closes too late or opens after it closes)
  Svc --> Ctrl : 400 "Invalid recruitment window"
else valid
  group $transaction
    Svc -> Repo : $queryRaw INSERT kitchen_campaigns (..., menu_items, supply_items,\nkitchen_location = ST_SetSRID(ST_MakePoint(lng, lat), 4326),\nrecruitment_status = 'scheduled', status = 'pending_approval') RETURNING id
    Svc -> Repo : campaignShift.createMany · campaignMenuItem.createMany
    Repo -> DB : INSERT kitchen_campaigns / campaign_shifts / campaign_menu_items
  end
  opt stepTimes provided
    Svc -> Steps : ensureStepsForMenuItem(campaignId, menuItemId, stepTimes)
  end
  Svc -> Notif : notifyAdmins("New campaign awaiting approval")
  Notif --> Admin : realtime notification
  Svc -> Svc : findOne(newId)
  Svc --> Ctrl : campaign detail
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : campaign created, awaiting admin approval (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-browse
title Browse Campaigns Sequence Diagram

actor "Volunteer / Guest" as User
participant ":CampaignsScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : open the campaign list
activate Screen
alt campaigns recruiting or running
  Screen -> Ctrl : GET /campaigns
  activate Ctrl
  Ctrl -> Svc : listOpen()
  activate Svc
  Svc -> Repo : kitchenCampaign.findMany(status = in_progress OR\n(status = approved AND recruitmentStatus in scheduled / open / staffed))
else my campaigns
  Screen -> Ctrl : GET /campaigns/my
  activate Ctrl
  Ctrl -> Svc : myCampaigns(userId)
  activate Svc
  Svc -> Repo : kitchenCampaign.findMany(charityReceiverId)
else public / completed
  Screen -> Ctrl : GET /campaigns/public · /campaigns/completed
  activate Ctrl
  Ctrl -> Svc : listPublicUpcoming(limit) · listCompleted()
  activate Svc
  Svc -> Repo : kitchenCampaign.findMany(by matching status)
end
Repo -> DB : SELECT kitchen_campaigns
DB --> Repo : campaigns[]
Repo --> Svc : campaigns
Svc --> Ctrl : campaigns[] with slot fill rates
deactivate Svc
Ctrl --> Screen : return data (200)
deactivate Ctrl
Screen --> User : render campaign cards

User -> Screen : open one campaign
Screen -> Ctrl : GET /campaigns/:id
activate Ctrl
Ctrl -> Svc : findOne(id)
activate Svc
Svc -> Repo : kitchenCampaign.findUnique(id) include charityReceiver, shifts,\nmenuItemRefs, assignments, donations
Repo -> DB : SELECT kitchen_campaigns JOIN ...
DB --> Repo : campaign | null
Repo --> Svc : campaign
alt Not found
  Svc --> Ctrl : 404 "Campaign not found"
  Ctrl --> Screen : return error
  Screen --> User : show error message
else found
  Svc --> Ctrl : campaign + shifts + supply progress
  Ctrl --> Screen : return data (200)
  Screen --> User : render details with the shift sign-up table
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

@startuml seq-campaign-apply-review
title Apply and Review Volunteer Assignment Sequence Diagram

actor "Volunteer" as User
participant ":CampaignDetailScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Charity Org" as Org

User -> Screen : pick a shift and a work date, then apply
activate Screen
Screen -> Ctrl : POST /campaigns/:id/shifts/:shiftId/apply (role, workDate)
activate Ctrl
Ctrl -> Svc : apply(campaignId, userId, dto)
activate Svc
Svc -> Repo : volunteerProfile.findUnique(userId) include specializations, user.status
Svc -> Repo : kitchenCampaign.findUnique(id) + campaignShift.findUnique(shiftId)
Repo -> DB : SELECT volunteer_profiles / kitchen_campaigns / campaign_shifts
DB --> Repo : rows
Repo --> Svc : volunteer, campaign, shift
alt No volunteer profile / account banned or suspended
  Svc --> Ctrl : 404 / 403 error
else missing the specialization for the chosen role
  Svc --> Ctrl : 400 "You do not have the {role} specialization"
else the campaign is outside its recruitment window or already ended
  Svc --> Ctrl : 400 "This campaign no longer accepts applications"
else the shift does not match the role / work date / has already passed
  Svc --> Ctrl : 400 BadRequest
else the shift is full on that day
  Svc --> Ctrl : 400 "This shift is full"
else already applied to this shift
  Svc --> Ctrl : 409 Conflict
else overlapping campaign shift OR active delivery in that slot
  Svc --> Ctrl : 400 / 409 error
else valid
  Svc -> Repo : campaignVolunteerAssignment.create(status = pending,\nconfirmationStatus = pending, role, shiftId, workDate)
  Repo -> DB : INSERT campaign_volunteer_assignments
  Svc --> Ctrl : { message }
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : application submitted, awaiting review (or show error message)

== Organization reviews the application ==
Org -> Screen : approve or reject an application
Screen -> Ctrl : PATCH /campaigns/:id/assignments/:assignmentId/review (action, note?)
activate Ctrl
Ctrl -> Svc : reviewAssignment(campaignId, assignmentId, userId, dto)
activate Svc
Svc -> Svc : assertOwner(campaignId, userId)
alt Caller does not own the campaign
  Svc --> Ctrl : 403 Forbidden
else owner
  group $transaction
    Svc -> Repo : campaignVolunteerAssignment.findUnique(assignmentId)
    Repo --> Svc : assignment | null
    alt not found / status != pending
      Svc --> Ctrl : 404 / 400 error
    else reject
      Svc -> Repo : assignment.update(status = rejected, notes)
    else approve
      Svc -> Repo : $queryRaw SELECT campaign_shifts FOR UPDATE
      alt campaign not approved / in_progress OR the shift is full
        Svc --> Ctrl : 400 "No free slot left"
      else slot available
        Svc -> Repo : kitchenCampaign.updateMany(slotsFilled +1 for that role)
        Svc -> Repo : campaignShift.update(slotsFilled +1)
        Svc -> Repo : assignment.updateMany(pending → assigned, shiftId)
      end
    end
    Repo -> DB : UPDATE assignments / kitchen_campaigns / campaign_shifts
  end
  Svc -> Notif : notify(volunteer, the review outcome)
  Notif --> User : realtime notification
  Svc --> Ctrl : updated assignment
end
deactivate Svc
Ctrl --> Screen : return data (200) / error
deactivate Ctrl
Screen --> Org : application processed
deactivate Screen
@enduml

@startuml seq-campaign-confirm-shift
title Volunteer Confirms Shift Sequence Diagram

actor "Volunteer" as User
participant ":MyTasksScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Charity Org" as Org

User -> Screen : confirm or decline an approved shift
activate Screen
Screen -> Ctrl : PATCH /campaigns/assignments/:assignmentId/confirmation (decision)
activate Ctrl
Ctrl -> Svc : confirmAssignment(assignmentId, userId, decision)
activate Svc
Svc -> Repo : campaignVolunteerAssignment.findUnique(id) include volunteer, campaign, shift
Repo -> DB : SELECT campaign_volunteer_assignments
DB --> Repo : assignment | null
Repo --> Svc : assignment
alt Assignment not found
  Svc --> Ctrl : 404 NotFound
else the assignment belongs to someone else
  Svc --> Ctrl : 403 Forbidden
else status != assigned
  Svc --> Ctrl : 400 "Only an approved shift can be confirmed"
else confirming while an active delivery occupies the slot
  Svc --> Ctrl : 400 BadRequest
else valid
  group $transaction
    Svc -> Repo : $queryRaw SELECT kitchen_campaigns FOR UPDATE
    alt campaign already ended OR the confirmation deadline (recruitmentEndAt) passed
      Svc --> Ctrl : 400 "The confirmation deadline has passed"
    else decision = confirmed
      Svc -> Repo : assignment.updateMany(confirmationStatus = confirmed, confirmedAt)
    else decision = declined
      Svc -> Repo : assignment.updateMany(confirmationStatus = declined, status = cancelled)
      Svc -> Repo : kitchenCampaign.update(slotsFilled −1) · campaignShift.update(slotsFilled −1)
    end
    Repo -> DB : UPDATE assignments / kitchen_campaigns / campaign_shifts
  end
  Svc -> Svc : refreshRecruitmentStatus(campaignId)
  opt decision = declined
    Svc -> Notif : notify(org, "A volunteer declined the shift")
    Notif --> Org : realtime notification
  end
  Svc --> Ctrl : { id, confirmationStatus }
end
deactivate Svc
Ctrl --> Screen : return data (200) / error
deactivate Ctrl
Screen --> User : shift confirmed / declined (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-invite-volunteers
title Invite Volunteers to Shift Sequence Diagram

actor "Charity Org" as Org
participant ":CampaignManageScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Volunteer" as User

Org -> Screen : open a shift that still lacks people
activate Screen
Screen -> Ctrl : GET /campaigns/:id/available-volunteers?workDate&period&role
activate Ctrl
Ctrl -> Svc : getAvailableVolunteersForShift(campaignId, userId, workDate, period, role)
activate Svc
Svc -> Repo : $queryRaw volunteers who declared weekly availability for that slot,\nhave the specialization and are not yet in this campaign that day
Repo -> DB : SELECT volunteer_availability JOIN volunteer_profiles
DB --> Repo : volunteers[]
Svc --> Ctrl : volunteers[]
deactivate Svc
Ctrl --> Screen : return data (200)
deactivate Ctrl
Screen --> Org : list of free volunteers

Org -> Screen : tick volunteers and send invitations
Screen -> Ctrl : POST /campaigns/:id/invite-volunteers (volunteerIds, workDate, period, shiftId)
activate Ctrl
Ctrl -> Svc : inviteVolunteersToShift(campaignId, userId, dto)
activate Svc
Svc -> Svc : assertOwner(campaignId, userId)
alt campaign not approved / in_progress OR recruitment already closed
  Svc --> Ctrl : 400 BadRequest
else nobody selected / none eligible / all already invited
  Svc --> Ctrl : 400 BadRequest
else valid
  Svc -> Notif : notify(each volunteer, kind = shift_invite, { campaignId, shiftId, workDate })
  Notif --> User : invitation card
  Svc --> Ctrl : { invited, skipped, duplicated }
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> Org : invitations sent

== Volunteer answers the invitation ==
User -> Screen : tap Accept on the invitation
Screen -> Ctrl : POST /campaigns/:id/accept-invite (notificationId)
activate Ctrl
Ctrl -> Svc : acceptShiftInvite(campaignId, userId, notificationId)
activate Svc
Svc -> Repo : notification.findFirst(id, userId) + kitchenCampaign.findUnique + campaignShift.findUnique
Repo --> Svc : invite, campaign, shift
alt invitation invalid / already answered
  Svc --> Ctrl : 400 "Invalid invitation"
else campaign closed OR the shift has passed
  Svc --> Ctrl : 400 BadRequest
else overlapping shift / active delivery / already in this shift
  Svc --> Ctrl : 400 / 409 error
else valid
  group $transaction
    Svc -> Repo : $queryRaw SELECT campaign_shifts FOR UPDATE
    alt the shift filled up meanwhile
      Svc --> Ctrl : 409 "The shift is already full"
    else slot available
      Svc -> Repo : campaignVolunteerAssignment.create(status = assigned)
      Svc -> Repo : kitchenCampaign.update(slotsFilled +1) · campaignShift.update(slotsFilled +1)
      Svc -> Repo : notification.update(mark the invitation as answered)
    end
    Repo -> DB : INSERT assignment / UPDATE kitchen_campaigns / campaign_shifts / notifications
  end
  Svc -> Svc : refreshRecruitmentStatus(campaignId)
  Svc -> Notif : notify(org, "{volunteer} accepted the invitation")
  Svc --> Ctrl : { ok, shiftLabel, workDate }
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : added to the shift (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-start
title Start Campaign Sequence Diagram

actor "Charity Org" as User
participant ":CampaignManageScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":SystemConfigService" as Cfg
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : tap Start campaign
activate Screen
Screen -> Ctrl : PATCH /campaigns/:id/start
activate Ctrl
Ctrl -> Svc : startCampaign(campaignId, userId)
activate Svc
Svc -> Svc : assertOwner(campaignId, userId)
Svc -> Repo : kitchenCampaign.findUnique(id) include shifts, assignments
Repo -> DB : SELECT kitchen_campaigns JOIN campaign_shifts / assignments
DB --> Repo : campaign
Repo --> Svc : campaign
Svc -> Cfg : getNumber(CAMPAIGN_MIN_FILL_PERCENT)
activate Cfg
Cfg --> Svc : minPercent
deactivate Cfg
Svc -> Svc : per shift and day: confirmed volunteers >= ceil(slotsNeeded × minPercent / 100)
alt Caller does not own the campaign
  Svc --> Ctrl : 403 "Only the organizing charity can start this campaign"
else status != approved
  Svc --> Ctrl : 400 "Only an approved campaign that has not started can be started"
else a shift is below the minimum confirmed staffing
  Svc --> Ctrl : 400 "Not enough confirmed volunteers yet"
else now < operationStartAt AND early start is disabled
  Svc --> Ctrl : 400 "The operating time has not come yet"
else valid
  Svc -> Repo : kitchenCampaign.update(status = in_progress, recruitmentStatus = closed_ready)
  Repo -> DB : UPDATE kitchen_campaigns
  Svc -> Notif : notify(each confirmed volunteer, "The campaign has started")
  Svc -> Svc : findOne(campaignId)
  Svc --> Ctrl : campaign detail
  Ctrl --> Screen : return data (200)
  Screen --> User : campaign is running, volunteers may check in
end
deactivate Svc
Ctrl --> Screen : return error (on any failure)
deactivate Ctrl
Screen --> User : show error message
deactivate Screen
@enduml

@startuml seq-campaign-checkin
title Volunteer Check-in Sequence Diagram

actor "Volunteer" as User
participant ":MyTaskScreen\n(GPS)" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":SystemConfigService" as Cfg
participant ":TrustService" as Trust
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB

User -> Screen : arrive at the kitchen and tap Check in
activate Screen
Screen -> Screen : read the current GPS position (lng, lat)
Screen -> Ctrl : POST /campaigns/assignments/:id/advance (lng, lat)
activate Ctrl
Ctrl -> Svc : advanceTask(assignmentId, userId, dto)
activate Svc
Svc -> Repo : volunteerProfile.findUnique(userId) include user.status
Svc -> Repo : campaignVolunteerAssignment.findUnique(id) include shift, campaign
Repo -> DB : SELECT volunteer_profiles / campaign_volunteer_assignments
DB --> Repo : rows
Repo --> Svc : volunteer, assignment
alt Volunteer profile missing or account not active
  Svc --> Ctrl : 404 / 403 error
else the assignment belongs to someone else
  Svc --> Ctrl : 403 "This task is not yours"
else the campaign is not in_progress
  Svc --> Ctrl : 400 "Tasks can only advance while the campaign is running"
else only one of lng / lat supplied
  Svc --> Ctrl : 400 "Both longitude and latitude are required"
else valid caller
  Svc -> Svc : evaluateCheckInWindow(campaign, shift, role, workDate)
  alt outside the assigned work date or before the shift opens
    Svc --> Ctrl : 400 "Check-in is not open for this shift"
  else inside the window
    Svc -> Cfg : getNumber(CHECKIN_GPS_RADIUS_M)
    Cfg --> Svc : radiusM (0 = GPS check off)
    opt radiusM > 0
      Svc -> Repo : $queryRaw ST_DWithin(kitchen_location, ST_MakePoint(lng, lat), radiusM)
      Repo -> DB : SELECT kitchen_campaigns
      DB --> Repo : withinRadius
    end
    alt outside the radius around the kitchen
      Svc --> Ctrl : 400 "You must be at the kitchen to check in"
    else at the kitchen
      group $transaction
        Svc -> Repo : assignment.update(status = checked_in, checkInTime, lateMinutes)
        Svc -> Repo : notification.create(organizer, "{volunteer} checked in")
        Repo -> DB : UPDATE campaign_volunteer_assignments / INSERT notifications
      end
      opt lateMinutes > CHECKIN_GRACE_MINUTES
        Svc -> Trust : applyDelta(volunteer, −CHECKIN_LATE_PENALTY, LATE_CHECK_IN)
      end
      Svc --> Ctrl : { id, status: checked_in, lateMinutes, penalty }
      Ctrl --> Screen : return data (201)
      Screen --> User : checked in, late by {lateMinutes} minutes
    end
  end
end
deactivate Svc
Ctrl --> Screen : return error (on any failure)
deactivate Ctrl
Screen --> User : show error message
deactivate Screen
@enduml

@startuml seq-campaign-task-progress
title Volunteer Task Progress Sequence Diagram

actor "Volunteer" as User
participant ":MyTaskScreen\n(Camera)" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":StorageService" as Storage
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : open the assigned task after checking in
activate Screen
loop checked_in → in_progress → completed
  User -> Screen : advance the step, attach a proof photo when required
  Screen -> Ctrl : POST /campaigns/assignments/:id/advance (multipart photo?)
  activate Ctrl
  opt a proof photo is attached
    Ctrl -> Svc : saveProofPhoto(photo)
    Svc -> Storage : saveImage(photo, 'campaign-proofs')
    activate Storage
    Storage --> Svc : proofUrl
    deactivate Storage
  end
  Ctrl -> Svc : advanceTask(assignmentId, userId, dto, proofUrl)
  activate Svc
  Svc -> Repo : campaignVolunteerAssignment.findUnique(id) include shift, campaign
  Repo -> DB : SELECT campaign_volunteer_assignments
  DB --> Repo : assignment | null
  Repo --> Svc : assignment
  alt Assignment not found
    Svc --> Ctrl : 404 "Task not found"
  else the assignment belongs to someone else
    Svc --> Ctrl : 403 "This task is not yours"
  else no next step (already completed or cancelled)
    Svc --> Ctrl : 400 "This task is already finished"
  else the campaign is not in_progress
    Svc --> Ctrl : 400 "Tasks can only advance while the campaign is running"
  else valid
    Svc -> Svc : next = ASSIGN_NEXT[current status]
    alt next = completed
      group $transaction
        Svc -> Repo : assignment.update(status = completed, checkOutTime, proofUrl, pointsAwarded)
        Svc -> Repo : volunteerProfile.update(dedicationPoints += points)
        Svc -> Repo : dedicationPointsHistory.create(campaign_completed)
        Repo -> DB : UPDATE assignments / volunteer_profiles / INSERT history
      end
      Svc --> Ctrl : { id, status: completed, pointsAwarded }
    else next = in_progress
      Svc -> Repo : assignment.update(status = in_progress, proofUrl?)
      Repo -> DB : UPDATE campaign_volunteer_assignments
      Svc --> Ctrl : { id, status: in_progress }
    end
    Ctrl --> Screen : return data (201)
    Screen --> User : task progress updated
  end
  deactivate Svc
  Ctrl --> Screen : return error (on any failure)
  deactivate Ctrl
  Screen --> User : show error message
end
deactivate Screen
@enduml

@startuml seq-campaign-complete
title Complete Campaign Sequence Diagram

actor "Charity Org" as User
participant ":CampaignManageScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : tap End campaign, enter the actual servings
activate Screen
Screen -> Ctrl : PATCH /campaigns/:id/complete (actualServings, earlyEndConfirmation?, earlyEndReason?)
activate Ctrl
Ctrl -> Svc : completeCampaign(campaignId, userId, actualServings, opts)
activate Svc
Svc -> Svc : assertOwner(campaignId, userId)
Svc -> Repo : kitchenCampaign.findUnique(id)
Repo -> DB : SELECT kitchen_campaigns
DB --> Repo : campaign | null
Repo --> Svc : campaign
alt Campaign not found
  Svc --> Ctrl : 404 NotFound
else caller does not own the campaign
  Svc --> Ctrl : 403 Forbidden
else status != in_progress
  Svc --> Ctrl : 400 "Only a running campaign can be completed"
else before the end date AND earlyEndConfirmation != EARLY_END
  Svc --> Ctrl : 400 "Confirm the early end first"
else before the end date AND reason shorter than 5 characters
  Svc --> Ctrl : 400 "An early-end reason is required"
else valid
  Svc -> Repo : kitchenCampaign.update(status = completed, actualServings, notes?)
  Repo -> DB : UPDATE kitchen_campaigns
  Svc -> Svc : releaseVolunteersOfFinishedCampaigns()
  Svc -> Repo : close assignments still open in the finished campaign
  Repo -> DB : UPDATE campaign_volunteer_assignments
  Svc -> Svc : findOne(campaignId)
  Svc --> Ctrl : campaign detail
end
deactivate Svc
Ctrl --> Screen : return data (200) / error
deactivate Ctrl
Screen --> User : campaign completed (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-cancel
title Cancel Campaign Sequence Diagram

actor "Charity Org" as User
participant ":CampaignManageScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Volunteers / Providers" as Others

User -> Screen : cancel the campaign, enter a reason
activate Screen
Screen -> Ctrl : PATCH /campaigns/:id/cancel (reason?)
activate Ctrl
Ctrl -> Svc : cancelCampaign(campaignId, userId, reason)
activate Svc
Svc -> Svc : assertOwner(campaignId, userId)
Svc -> Repo : kitchenCampaign.findUnique(id)
Repo -> DB : SELECT kitchen_campaigns
DB --> Repo : campaign | null
Repo --> Svc : campaign
alt Campaign not found
  Svc --> Ctrl : 404 NotFound
else caller does not own the campaign
  Svc --> Ctrl : 403 Forbidden
else status not in (pending_approval, approved)
  Svc --> Ctrl : 400 "Only a campaign that has not started can be cancelled"
else valid
  group $transaction
    Svc -> Repo : assignments.findMany(pending / assigned) · donations.findMany(pledged)
    Svc -> Repo : kitchenCampaign.update(status = cancelled, notes = reason)
    Svc -> Repo : campaignVolunteerAssignment.updateMany(status = cancelled)
    Svc -> Repo : campaignDonation.updateMany(status = cancelled)
    Svc -> Repo : kitchenCampaign / campaignShift slotsFilled = 0
    Repo -> DB : UPDATE kitchen_campaigns / assignments / donations / campaign_shifts
  end
  Svc -> Notif : notify(each volunteer and provider, "The campaign was cancelled")
  Notif --> Others : realtime notification
  Svc --> Ctrl : campaign detail
end
deactivate Svc
Ctrl --> Screen : return data (200) / error
deactivate Ctrl
Screen --> User : campaign cancelled (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-pledge-donation
title Pledge Campaign Donation Sequence Diagram

actor "Provider" as User
participant ":CampaignDetailScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Charity Org" as Org

User -> Screen : choose a required ingredient and the quantity to donate
activate Screen
Screen -> Ctrl : POST /campaigns/:id/donations (itemName, quantity, unit?, note?)
activate Ctrl
Ctrl -> Svc : pledgeDonation(campaignId, providerUserId, dto)
activate Svc
Svc -> Repo : providerProfile.findUnique(userId) include user.status
Svc -> Repo : kitchenCampaign.findUnique(id) include donations
Repo -> DB : SELECT provider_profiles / kitchen_campaigns
DB --> Repo : provider, campaign
Repo --> Svc : provider, campaign
alt Provider profile not found
  Svc --> Ctrl : 404 NotFound
else provider not approved / not active
  Svc --> Ctrl : 403 "The provider must be approved before donating"
else Campaign not found
  Svc --> Ctrl : 404 NotFound
else the item is not in the campaign's supply targets OR the unit differs
  Svc --> Ctrl : 400 BadRequest
else quantity exceeds what is still needed
  Svc --> Ctrl : 400 "Only {remaining} {unit} still needed"
else the provider already has an open pledge for this item
  Svc --> Ctrl : 400 "You already pledged this item"
else valid
  Svc -> Repo : campaignDonation.create(status = pledged, itemName, quantity, unit)
  Repo -> DB : INSERT campaign_donations
  Svc -> Notif : notify(org, "New donation pledge")
  Notif --> Org : realtime notification
  Svc --> Ctrl : donation
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : pledge recorded (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-confirm-donation
title Confirm Campaign Donation Sequence Diagram

actor "Charity Org" as User
participant ":CampaignManageScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Provider" as Provider

User -> Screen : confirm that the pledged goods arrived
activate Screen
Screen -> Ctrl : PATCH /campaigns/donations/:id/confirm (note?)
activate Ctrl
Ctrl -> Svc : confirmDonation(donationId, charityUserId, dto)
activate Svc
Svc -> Repo : campaignDonation.findUnique(id) include campaign, provider
Svc -> Repo : receiverProfile.findUnique(userId)
Repo -> DB : SELECT campaign_donations / receiver_profiles
DB --> Repo : donation, receiver
Repo --> Svc : donation, receiver
alt Donation not found
  Svc --> Ctrl : 404 NotFound
else caller does not own the campaign
  Svc --> Ctrl : 403 Forbidden
else status != pledged
  Svc --> Ctrl : 400 "This donation was already processed"
else the donation came from a provider request (confirmed through the pickup flow)
  Svc --> Ctrl : 400 BadRequest
else campaign cancelled or finished
  Svc --> Ctrl : 400 BadRequest
else valid
  Svc -> Repo : campaignDonation.update(status = received, receivedAt, note)
  Repo -> DB : UPDATE campaign_donations
  Svc -> Notif : notify(provider, "The organization received your donation")
  Notif --> Provider : realtime notification
  Svc --> Ctrl : { id, status: received }
end
deactivate Svc
Ctrl --> Screen : return data (200) / error
deactivate Ctrl
Screen --> User : donation marked as received (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-change-request
title Submit Campaign Change Request Sequence Diagram

actor "Charity Org" as User
participant ":CampaignManageScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":NotificationsService" as Notif
participant ":PrismaService" as Repo
database "Database" as DB
actor "Admin" as Admin

User -> Screen : propose new dates / location / staffing for an approved campaign
activate Screen
Screen -> Ctrl : POST /campaigns/:id/change-requests (SubmitCampaignChangeDto)
activate Ctrl
Ctrl -> Svc : submitChangeRequest(campaignId, userId, dto)
activate Svc
Svc -> Svc : assertOwner(campaignId, userId)
alt Caller does not own the campaign
  Svc --> Ctrl : 403 Forbidden
else status != approved
  Svc --> Ctrl : 400 "Only an approved campaign that has not started can be changed"
else no change proposed / only one of lng, lat
  Svc --> Ctrl : 400 BadRequest
else new date in the past OR end before start OR lead time too short
  Svc --> Ctrl : 400 BadRequest
else new slot count below the number already filled
  Svc --> Ctrl : 400 "Slots cannot be lower than the filled count"
else valid
  Svc -> Repo : campaignChangeRequest.findFirst(campaignId, status = pending)
  Repo --> Svc : existing | null
  alt a request is already pending
    Svc --> Ctrl : 409 "A change request is already awaiting review"
  else none pending
    Svc -> Repo : campaignChangeRequest.create(status = pending, proposed fields, reason)
    Repo -> DB : INSERT campaign_change_requests
    Svc -> Notif : notifyAdmins("Campaign change request awaiting review")
    Notif --> Admin : realtime notification
    Svc --> Ctrl : change request
  end
end
deactivate Svc
Ctrl --> Screen : return data (201) / error
deactivate Ctrl
Screen --> User : request sent to admin (or show error message)
deactivate Screen
@enduml

@startuml seq-campaign-cancel-change-request
title Cancel Campaign Change Request Sequence Diagram

actor "Charity Org" as User
participant ":CampaignManageScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : withdraw a pending change request
activate Screen
Screen -> Ctrl : PATCH /campaigns/change-requests/:id/cancel
activate Ctrl
Ctrl -> Svc : cancelChangeRequest(changeRequestId, userId)
activate Svc
Svc -> Repo : campaignChangeRequest.findUnique(id)
Repo -> DB : SELECT campaign_change_requests
DB --> Repo : request | null
Repo --> Svc : request
alt Request not found
  Svc --> Ctrl : 404 NotFound
else caller does not own the campaign
  Svc --> Ctrl : 403 Forbidden
else status != pending
  Svc --> Ctrl : 400 "Only a pending request can be cancelled"
else valid
  Svc -> Repo : campaignChangeRequest.update(status = cancelled)
  Repo -> DB : UPDATE campaign_change_requests
  Svc --> Ctrl : { id, status: cancelled }
end
deactivate Svc
Ctrl --> Screen : return data (200) / error
deactivate Ctrl
Screen --> User : request withdrawn (or show error message)
deactivate Screen
@enduml
