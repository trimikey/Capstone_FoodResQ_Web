@startuml class-bulk-run
title Bulk Run Class Diagram

skinparam classAttributeIconSize 0
hide empty members

package "Bulk Run" {
  class BulkRunsController {
    +request()
    +my()
    +provider()
    +approve()
    +reject()
    +pickup()
    +addStop()
    +updateStop()
    +removeStop()
    +serve()
    +complete()
    +cancel()
  }

  class BulkRunsService {
    +request()
    +myRuns()
    +providerRuns()
    +approve()
    +reject()
    +pickup()
    +addStop()
    +updateStop()
    +removeStop()
    +serve()
    +complete()
    +cancel()
    +saveProofPhoto()
    +expireStalled()
  }

  class BulkRunsCron {
    +handleStalled()
  }
}

class Redlock
class SystemConfigService
class StorageService
class TrustService
class NotificationsService
class PrismaService

BulkRunsController --> BulkRunsService
BulkRunsCron --> BulkRunsService

BulkRunsService --> Redlock
BulkRunsService --> SystemConfigService
BulkRunsService --> StorageService
BulkRunsService --> TrustService
BulkRunsService --> NotificationsService
BulkRunsService --> PrismaService
@enduml
