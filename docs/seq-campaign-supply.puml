'──────────────────── 8. Create Distribution Round ───────────
@startuml seq-campaign-create-distribution
!include _seq-style.iuml
title Create Distribution Round Sequence Diagram

actor "Charity Org" as User
participant ":DistributionScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
participant ":NotificationsService" as Notif
database "Database" as DB
actor "Campaign Shippers" as Shippers

User -> Screen : plan a round (servings, people, points, assignees)
activate Screen
Screen -> Ctrl : POST /campaigns/:id/manage/distributions (CreateDistributionDto)
activate Ctrl
Ctrl -> Svc : createDistribution(campaignId, userId, dto)
activate Svc
Svc -> Svc : assertOwner(campaignId, userId)
Svc -> Repo : kitchenCampaign.findUnique(id) select status, expectedServings
Repo --> Svc : campaign | null
alt Not found
  Svc --> Ctrl : 404 NotFound
else status not in (in_progress, completed)
  Svc --> Ctrl : 400 "Chỉ ghi nhận đợt phát khi chiến dịch đang diễn ra"
else peopleServed > servingsServed
  Svc --> Ctrl : 400 "Số người nhận không thể lớn hơn số suất đã phát"
  note right of Svc : mỗi người nhận ít nhất 1 suất
else quota check
  Svc -> Repo : mealDistribution.aggregate(SUM servingsServed + leftoverServings)
  Repo --> Svc : used
  alt servingsServed + leftover > expectedServings − used
    Svc --> Ctrl : 400 "Chỉ còn {remaining} suất"
    note right of Svc : suất thừa cũng từ cùng mẻ nấu\n→ tính chung vào hạn mức
  else within quota
    opt assigneeVolunteerIds provided
      Svc -> Repo : campaignVolunteerAssignment.findMany(campaignId, volunteerId in …,\nrole = shipper, status in assigned/checked_in/in_progress/completed)
      Repo --> Svc : valid[]
      alt some requested assignees are not approved campaign shippers
        Svc --> Ctrl : 400 "{n} người được chọn không phải TNV giao hàng đã duyệt"
        note right of Svc : thiếu người nào là chặn cả yêu cầu,\nkhông âm thầm bỏ bớt
      end
    end
    loop for each pair of pinned points
      Svc -> Svc : distanceMeters(p[i], p[j])
      alt distance < MIN_POINT_DISTANCE_M
        Svc --> Ctrl : 400 "Hai điểm phát phải cách nhau tối thiểu {d} m"
        note right of Svc : tránh phục vụ trùng một nhóm dân cư
      end
    end
    alt servedByVolunteerId given
      Svc -> Repo : campaignVolunteerAssignment.findFirst(campaignId, volunteerId, status approved)
      alt not an approved volunteer of this campaign
        Svc --> Ctrl : 400 "Người phụ trách phải là TNV đã được duyệt"
      end
    else not given
      Svc -> Repo : campaignVolunteerAssignment.findFirst(campaignId, status approved) order role, createdAt
      alt no approved volunteer at all
        Svc --> Ctrl : 400 "Hãy duyệt ít nhất 1 đăng ký trước"
      end
    end
    Svc -> Repo : mealDistribution.create(servingsServed, peopleServed, leftover, points, assigneeIds, distributedAt)
    Repo -> DB : INSERT meal_distributions
    DB --> Repo : distribution
    loop for each assignee
      Svc -> Notif : notify(shipper, "Bạn được phân công đi phát suất ăn")
    end
    Notif --> Shippers : realtime dispatch notification
    note right of Svc : không await — lỗi gửi thông báo\nkhông làm rớt đợt phát vừa ghi
    Svc --> Ctrl : distribution
    Ctrl --> Screen : return data (201)
    Screen --> User : round created & shippers dispatched
  end
end
Ctrl --> Screen : return error (on any failure)
Screen --> User : show error message
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 9. Complete Distribution Round ─────────
@startuml seq-campaign-complete-distribution
!include _seq-style.iuml
title Complete Distribution Round Sequence Diagram

actor "Shipper / Charity Org" as User
participant ":DistributionScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
participant ":NotificationsService" as Notif
database "Database" as DB
actor "Charity Org" as Charity

User -> Screen : report the round as finished (actual servings / people)
activate Screen
Screen -> Ctrl : POST /campaigns/distributions/:distributionId/complete (report)
activate Ctrl
Ctrl -> Svc : completeDistribution(distributionId, userId, report)
activate Svc
Svc -> Repo : mealDistribution.findUnique(id) include campaign.charityReceiver
Repo -> DB : SELECT meal_distributions JOIN kitchen_campaigns
DB --> Repo : dist | null
Repo --> Svc : dist
alt Not found
  Svc --> Ctrl : 404 "Không tìm thấy đợt phát"
else dist.completedAt already set
  Svc --> Ctrl : { completedAt, alreadyCompleted: true }
  note right of Svc : idempotent — không ghi đè\nngười xác nhận đầu tiên
else open round
  Svc -> Svc : actualServings = report.actualServings ?? dist.servingsServed
  alt actualServings outside 0..dist.servingsServed
    Svc --> Ctrl : 400 "Số suất thực phát phải trong khoảng 0–{planned}"
    note right of Svc : hàng lấy từ đúng mẻ đó — báo nhiều hơn\nlà số liệu sai, không phải phát được nhiều hơn
  else actualPeople > actualServings
    Svc --> Ctrl : 400 "Số người nhận không thể lớn hơn số suất đã phát"
  else plausible
    Svc -> Repo : volunteerProfile.findUnique(userId)
    Repo --> Svc : volunteer | null
    Svc -> Svc : isAssignedShipper = assigneeIds includes volunteer.id\nisOwner = campaign.charityReceiver.userId = userId
    alt neither assigned shipper nor owner
      Svc --> Ctrl : 403 "Chỉ shipper được phân công hoặc tổ chức chủ chiến dịch"
    else authorized
      opt isAssignedShipper AND not owner
        Svc -> Repo : campaignVolunteerAssignment.findFirst(campaignId, volunteerId, status in checked_in/in_progress/completed)
        Repo --> Svc : attended | null
        alt not checked in
          Svc --> Ctrl : 400 "Bạn cần điểm danh tại bếp trước"
          note right of Svc : tổ chức chủ chiến dịch không cần điểm danh —\nhọ chốt hộ khi shipper quên bấm
        end
      end
      Svc -> Repo : mealDistribution.updateMany(id, completedAt IS NULL → completedAt,\ncompletedByVolunteerId, actualServings, actualPeopleServed, completionNote)
      Repo -> DB : UPDATE meal_distributions
      DB --> Repo : count
      alt count != 1 (two shippers pressed at once)
        Svc -> Repo : mealDistribution.findUnique(id) select completedAt
        Svc --> Ctrl : { completedAt, alreadyCompleted: true }
      else claimed
        opt confirmed by the shipper
          Svc -> Notif : notify(charity, "Đợt phát đã hoàn tất — {actual}/{planned} suất")
          Notif --> Charity : realtime notification
        end
        Svc --> Ctrl : { completedAt, actualServings, actualPeopleServed, leftover }
        Ctrl --> Screen : return data (201)
        Screen --> User : round closed — counted into campaign stats
      end
    end
  end
end
Ctrl --> Screen : return error (on any failure)
Screen --> User : show error message
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml
