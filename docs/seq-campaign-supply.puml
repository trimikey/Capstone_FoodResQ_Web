'==============================================================
' FoodResQ — Sequence Diagrams: Campaign Supply Chain
' (campaigns module — phần chuỗi cung ứng nguyên liệu & đợt phát)
'
' Chuỗi: charity tìm NCC gần bếp (PostGIS) → gửi yêu cầu hợp tác →
'        NCC duyệt (tạo Delivery + CampaignTransport + broadcast shipper)
'        → TNV lấy nguyên liệu / shipper giao về bếp → charity xác nhận nhận hàng
'        → tổ chức tạo đợt phát & điều shipper → shipper chốt đợt phát
'==============================================================

'──────────────────── 1. Suggest Nearby Suppliers ────────────
@startuml seq-campaign-suggest-suppliers
!include _seq-style.iuml
title Suggest Nearby Suppliers Sequence Diagram

actor "Charity Org" as User
participant ":SuppliersSection" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB

User -> Screen : open "tìm nhà cung cấp gần bếp"
activate Screen
Screen -> Ctrl : GET /campaigns/:id/supplier-matches?radiusKm&category
activate Ctrl
Ctrl -> Svc : suggestSuppliersForCampaign(campaignId, charityUserId, opts)
activate Svc
Svc -> Svc : assertOwner(campaignId, charityUserId)
alt Not the owning organization
  Svc --> Ctrl : 403 Forbidden
  Ctrl --> Screen : return error
  Screen --> User : show error message
else owner
  Svc -> Svc : radiusKm = clamp(radiusKm ?? 5, 0.5, 50)
  Svc -> Repo : $queryRaw ST_X / ST_Y (kitchen_location)
  Repo -> DB : SELECT kitchen_campaigns
  DB --> Repo : { lng, lat } | null
  alt Kitchen has no pinned location
    Svc --> Ctrl : { matches: [], reason: 'NO_KITCHEN_LOCATION' }
    note right of Svc : trả cờ để FE nhắc ghim toạ độ bếp,\nthay vì im lặng như thể không có NCC nào
    Ctrl --> Screen : return data (200)
    Screen --> User : "hãy ghim vị trí bếp trước"
  else has coordinates
    Svc -> Repo : $queryRaw provider_profiles JOIN food_listings\nST_DWithin(radius) + ST_Distance ORDER BY distance LIMIT 10
    note right of Svc : chỉ NCC approved + user active,\nlisting active còn hạn & còn hàng
    Repo -> DB : SELECT ... GROUP BY provider
    DB --> Repo : rows[]
    Repo --> Svc : rows
    Svc -> Svc : map → { distanceKm, listingCount, totalRemaining, estimatedKg }
    note right of Svc : estimatedKg chỉ cộng tin đã khai weight_per_unit_kg\n→ là CẬN DƯỚI, FE phải ghi "ước tính tối thiểu"
    Svc --> Ctrl : { radiusKm, kitchen, matches[] }
    Ctrl --> Screen : return data (200)
    Screen --> User : render suppliers on map + list
  end
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 2. Send Provider Request ───────────────
@startuml seq-campaign-send-provider-request
!include _seq-style.iuml
title Send Provider Request Sequence Diagram

actor "Charity Org" as User
participant ":SuppliersSection" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
participant ":NotificationsService" as Notif
database "Database" as DB
actor "Provider" as Provider

User -> Screen : fill demand details + non-commercial waiver
activate Screen
Screen -> Ctrl : POST /campaigns/requests (SendProviderRequestDto)
activate Ctrl
Ctrl -> Svc : sendProviderRequest(charityUserId, dto)
activate Svc
Svc -> Repo : receiverProfile.findUnique(userId) include user
Svc -> Repo : user.findFirst(providerProfile.id = dto.providerId)
Repo --> Svc : receiver, provider
alt Receiver profile not found
  Svc --> Ctrl : 404 "Không tìm thấy hồ sơ tổ chức"
else Provider not found
  Svc --> Ctrl : 404 "Không tìm thấy nhà cung cấp"
else demandDetails without nonCommercialWaiver
  Svc --> Ctrl : 400 "Bếp phải cam kết sử dụng phi thương mại"
  note right of Svc : điều kiện pháp lý — chặn ở BE,\nkhông tin FE có tick hay không
else neededTo <= neededFrom
  Svc --> Ctrl : 400 "Giờ kết thúc phải sau giờ bắt đầu"
else valid
  Svc -> Svc : demandDetails.waiverAcceptedAt = now()
  note right of Svc : đóng dấu thời điểm cam kết để đối chiếu khi tranh chấp
  Svc -> Repo : campaignProviderRequest.findFirst(campaignId, providerId)
  Repo --> Svc : existing | null
  alt existing request found
    Svc -> Repo : campaignProviderRequest.update(status = pending, reset reviewedAt/Note)
    note right of Svc : upsert THỦ CÔNG — DB chỉ có partial unique index\nnên prisma.upsert() sẽ lỗi 42P10
  else first time
    Svc -> Repo : campaignProviderRequest.create(status = pending)
  end
  Repo -> DB : INSERT / UPDATE campaign_provider_requests
  DB --> Repo : request
  Svc -> Notif : notify(provider, "Yêu cầu hợp tác mới")
  Notif --> Provider : realtime notification
  Svc --> Ctrl : { message, requestId, providerId }
  Ctrl --> Screen : return data (201)
  Screen --> User : request sent, awaiting provider
end
Ctrl --> Screen : return error (on any failure)
Screen --> User : show error message
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 3. Provider Reviews Request ────────────
@startuml seq-campaign-review-provider-request
!include _seq-style.iuml
title Review Provider Request Sequence Diagram

actor "Provider" as User
participant ":ProviderRequestsScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
participant ":DeliveriesService" as Deliveries
participant ":NotificationsService" as Notif
database "Database (PostGIS)" as DB
actor "Charity Org" as Charity

User -> Screen : accept (pickup time, needs transport?) or reject
activate Screen
Screen -> Ctrl : PATCH /campaigns/provider-requests/:requestId/review (action, note, opts)
activate Ctrl
Ctrl -> Svc : reviewProviderRequest(providerUserId, requestId, action, note, opts)
activate Svc
Svc -> Repo : providerProfile.findUnique(userId)
Svc -> Repo : campaignProviderRequest.findUnique(requestId)
Repo --> Svc : profile, request
alt Profile / request not found
  Svc --> Ctrl : 404 NotFound
else request.providerId != profile.id
  Svc --> Ctrl : 403 "Bạn không sở hữu yêu cầu này"
else status != pending
  Svc --> Ctrl : 400 "Yêu cầu đang ở trạng thái {status}"
else pickupTime not HH:mm
  Svc --> Ctrl : 400 BadRequest
else valid
  opt action = accept
    Svc -> Repo : kitchenCampaign.findUnique(campaignId) + $queryRaw ST_X/ST_Y(kitchen_location)
    Repo --> Svc : campaignSnapshot
    alt Campaign not found
      Svc --> Ctrl : 404 NotFound
    else needsTransport AND kitchen has no coordinates
      Svc --> Ctrl : 400 "Chiến dịch chưa có toạ độ bếp hợp lệ"
    end
    opt needsTransport
      Svc -> Repo : $queryRaw ST_X/ST_Y(provider_profiles.location)
      Repo --> Svc : pickupCoords | null
      alt Provider has no coordinates
        Svc --> Ctrl : 400 "NCC chưa có toạ độ điểm lấy hàng hợp lệ"
      end
    end
  end

  group $transaction
    Svc -> Repo : campaignProviderRequest.updateMany(id, status = pending → accepted/rejected,\nreviewedAt, scheduledDate, pickupStart/EndTime, needsTransport)
    alt updated count != 1
      Svc --> Ctrl : 409 "Yêu cầu đã được xử lý bởi thao tác khác"
      note right of Svc : updateMany + điều kiện status = pending\n→ chống double-review
    end
    opt needsTransport
      Svc -> Svc : createTransportForRequest(tx, requestId, campaign, pickup)
      Svc -> Repo : $queryRaw WITH created_delivery AS (INSERT deliveries …)\nINSERT campaign_transports SELECT … RETURNING id, delivery_id
      note right of Svc : 1 câu SQL: tạo Delivery (pending_assignment,\npickup/delivery geography, distance_km) + CampaignTransport
      Repo -> DB : INSERT deliveries + campaign_transports
      DB --> Repo : { id, delivery_id }
    end
  end

  opt transport created
    Svc -> Deliveries : broadcastToNearbyShippers(deliveryId, lng, lat)
    note right of Svc : lỗi broadcast chỉ log —\nkhông rollback quyết định đã duyệt
  end

  Svc -> Repo : receiverProfile.findUnique(request.receiverId) select userId
  alt action = reject
    Svc -> Notif : notify(charity, "Nhà cung cấp từ chối hợp tác" + lý do)
  else accept + needsTransport
    Svc -> Notif : notify(charity, "Đã chấp nhận — hệ thống tìm TNV giao hàng")
  else accept, charity tự lấy
    Svc -> Notif : notify(charity, "Đã chấp nhận — TNV của bạn đến lấy lúc {giờ}")
  end
  Notif --> Charity : realtime notification
  Svc --> Ctrl : { ...updatedRequest, transportId }
  Ctrl --> Screen : return data (200)
  Screen --> User : decision saved
end
Ctrl --> Screen : return error (on any failure)
Screen --> User : show error message
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 4. Confirm Ingredient Pickup ───────────
@startuml seq-campaign-ingredient-pickup
!include _seq-style.iuml
title Confirm Ingredient Pickup Sequence Diagram

actor "Campaign Shipper" as User
participant ":PickupOrderScreen\n(Camera)" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":StorageService" as Storage
participant ":PrismaService" as Repo
participant ":NotificationsService" as Notif
database "Database" as DB
actor "Charity Org" as Charity

User -> Screen : photograph collected ingredients + enter received kg
activate Screen
Screen -> Ctrl : POST /campaigns/pickup-orders/:requestId/confirm (photo, receivedKg, note?)
activate Ctrl
opt photo provided
  Ctrl -> Storage : saveImage(photo, …)
  Storage --> Ctrl : photoUrl
end
Ctrl -> Svc : confirmIngredientPickup(providerRequestId, userId, dto, photoUrl)
activate Svc
alt No photo
  Svc --> Ctrl : 400 "Cần ảnh chụp nguyên liệu đã lấy"
else photo present
  Svc -> Repo : campaignProviderRequest.findUnique(id) include delivery, campaign, provider
  Repo --> Svc : request | null
  alt Request not found
    Svc --> Ctrl : 404 "Không tìm thấy đơn nguyên liệu"
  else request.status != accepted
    Svc --> Ctrl : 400 "Đơn chưa được NCC chấp nhận"
  else valid request
    Svc -> Repo : volunteerProfile.findUnique(userId)
    Repo --> Svc : volunteer | null
    alt Volunteer not found
      Svc --> Ctrl : 404 NotFound
    else delivery.status = delivered
      Svc --> Ctrl : 400 "Shipper đã giao về bếp — không cần xác nhận lại"
      note right of Svc : chặn hai nguồn sự thật cho cùng một lần lấy hàng
    else caller is the shipper running this very delivery
      Svc --> Ctrl : 400 "Chụp ảnh QC ở bước 'Đã lấy hàng' tại màn giao hàng"
    else no conflict
      Svc -> Repo : campaignVolunteerAssignment.findFirst(campaignId, volunteerId, role = shipper)
      Repo --> Svc : assignment | null
      alt Not a campaign shipper
        Svc --> Ctrl : 403 "Bạn không phải shipper của chiến dịch này"
      else status not in checked_in/in_progress/completed
        Svc --> Ctrl : 400 "Cần điểm danh tại bếp trước"
        note right of Svc : không điểm danh thì người ở nhà\nvẫn "xác nhận đã lấy" được
      else attended
        Svc -> Svc : requestedKg = demandDetails.quantityKg
        alt receivedKg > requestedKg × 1.5
          Svc --> Ctrl : 400 "Số kg thực nhận vượt 150% số đã đặt"
        else plausible
          Svc -> Repo : campaignIngredientPickup.findUnique(providerRequestId)
          Repo --> Svc : existing | null
          alt Already confirmed
            Svc --> Ctrl : 400 "Đơn này đã được xác nhận lấy hàng rồi"
            note right of Svc : unique(providerRequestId) — người bấm sau\nnhận lỗi rõ ràng thay vì ghi đè biên nhận
          else first confirmation
            Svc -> Repo : campaignIngredientPickup.create(requestedKg, receivedKg, photoUrl, note)
            Svc -> Repo : campaignVolunteerAssignment.update(ingredientProofUrl, ingredientProofAt)
            Repo -> DB : INSERT campaign_ingredient_pickups / UPDATE assignment
            Svc -> Svc : shortfall = max(0, requestedKg − receivedKg)
            Svc -> Notif : notify(charity, shortfall > 0 ? "Nguyên liệu về THIẾU" : "Đã lấy nguyên liệu")
            Notif --> Charity : realtime notification
            Svc --> Ctrl : { id, receivedKg, requestedKg, shortfallKg, photoUrl, confirmedAt }
            Ctrl --> Screen : return data (201)
            Screen --> User : pickup recorded
          end
        end
      end
    end
  end
end
Ctrl --> Screen : return error (on any failure)
Screen --> User : show error message
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 5. Confirm Transport Receipt ───────────
@startuml seq-campaign-transport-receive
!include _seq-style.iuml
title Confirm Transport Receipt Sequence Diagram

actor "Charity Org" as User
participant ":CampaignManageScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
participant ":NotificationsService" as Notif
database "Database" as DB
actor "Provider" as Provider

User -> Screen : confirm ingredients arrived at the kitchen
activate Screen
Screen -> Ctrl : POST /campaigns/:id/transports/:transportId/receive (note?, receiptPhotoUrl?)
activate Ctrl
Ctrl -> Svc : confirmTransportReceipt(campaignId, transportId, charityUserId, dto)
activate Svc
Svc -> Repo : receiverProfile.findUnique(userId)
Repo --> Svc : receiver | null
alt Receiver profile not found
  Svc --> Ctrl : 404 NotFound
else found
  Svc -> Repo : campaignTransport.findFirst(id, providerRequest.campaignId, receiverId)
  Repo -> DB : SELECT campaign_transports JOIN campaign_provider_requests
  DB --> Repo : transport | null
  Repo --> Svc : transport
  alt Transport not in this campaign
    Svc --> Ctrl : 404 NotFound
  else status = received already
    Svc --> Ctrl : current transport (idempotent)
  else status != delivered
    Svc --> Ctrl : 400 "Chỉ xác nhận khi shipper đã bàn giao đến bếp"
  else delivered
    Svc -> Repo : campaignTransport.updateMany(id, status = delivered → received,\nreceivedAt, receivedByUserId, receiptNote, receiptPhotoUrl)
    Repo -> DB : UPDATE campaign_transports
    DB --> Repo : count
    alt count != 1 (raced)
      Svc --> Ctrl : current transport
    else claimed
      Svc -> Repo : campaignTransport.findUnique(id) include providerRequest
      Svc -> Notif : notify(provider, "Tổ chức đã xác nhận nhận hàng")
      Notif --> Provider : realtime notification
      Svc --> Ctrl : transport (status = received)
      Ctrl --> Screen : return data (201)
      Screen --> User : receipt confirmed
    end
  end
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 6. List Provider Requests (both sides) ─
@startuml seq-campaign-list-provider-requests
!include _seq-style.iuml
title List Provider Requests Sequence Diagram

actor "Provider / Charity Org" as User
participant ":RequestsScreen" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : open requests inbox
activate Screen
alt provider side (received)
  Screen -> Ctrl : GET /campaigns/provider-requests
  activate Ctrl
  Ctrl -> Svc : listMyProviderRequests(providerUserId)
  activate Svc
  Svc -> Repo : providerProfile.findUnique(userId)
  Repo --> Svc : profile | null
  alt Not found
    Svc --> Ctrl : 404 "Không tìm thấy hồ sơ provider"
  else found
    Svc -> Repo : campaignProviderRequest.findMany(providerId) include receiver, campaign, transport
  end
else charity side (sent)
  Screen -> Ctrl : GET /campaigns/my-sent-requests
  Ctrl -> Svc : listMySentRequests(charityUserId)
  Svc -> Repo : receiverProfile.findUnique(userId)
  Repo --> Svc : receiver | null
  alt Not found
    Svc --> Ctrl : 404 "Không tìm thấy hồ sơ tổ chức"
  else found
    Svc -> Repo : campaignProviderRequest.findMany(receiverId) include provider, campaign,\ntransport (assignedAt, pickedUpAt, deliveredAt, receivedAt, failedAt…)
  end
end
Repo -> DB : SELECT campaign_provider_requests JOIN …
DB --> Repo : requests[]
Svc --> Ctrl : requests[] order createdAt desc
deactivate Svc
Ctrl --> Screen : return data (200)
deactivate Ctrl
Screen --> User : render request cards + transport timeline
deactivate Screen
@enduml

'──────────────────── 7. Submit Provider Proposal ────────────
@startuml seq-campaign-provider-proposal
!include _seq-style.iuml
title Submit Provider Proposal Sequence Diagram

actor "Charity Org" as User
participant ":SuppliersSection" as Screen
participant ":CampaignsController" as Ctrl
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
