'==============================================================
' FoodResQ — Sequence Diagrams: Scheduled Jobs (@nestjs/schedule)
'
' | Cron                        | Tần suất      | Việc                          |
' |-----------------------------|---------------|-------------------------------|
' | ReservationsCron.noShows    | mỗi phút      | confirmed quá hạn → no_show   |
' | ReservationsCron.dailyReset | 00:00         | reset reservationsToday       |
' | DeliveriesCron.offerSweep   | mỗi 30 giây   | hết hạn offer + mời shipper kế|
' | DeliveriesCron.stalled      | mỗi 5 phút    | delivery treo 6h → failed     |
' | ListingsCron.expiryAlerts   | mỗi 30 phút   | nhắc NCC tin sắp hết hạn      |
' | CampaignsCron.expireOverdue | 00:00         | campaign 'open' quá hạn → huỷ |
' | CampaignsCron.autoComplete  | mỗi giờ       | campaign 'in_progress' → done |
' | CampaignsCron.nudgeTasks    | mỗi 5 phút    | nhắc TNV sắp/quá giờ ca       |
' | CampaignsCron.openDishSteps | mỗi 30 giây   | mở khoá khâu đến giờ          |
' | BulkRunsCron.stalled        | mỗi 10 phút   | dọn chuyến giao sỉ bỏ quên    |
'
' Mọi handler bọc try/catch + logCronError — một job lỗi không làm chết scheduler.
' (Chi tiết autoOpenAvailableSteps xem seq-dish-steps.puml ·
'  expireStalled bulk run xem seq-bulk-run.puml)
'==============================================================

'──────────────────── 1. Expire No-shows ─────────────────────
@startuml seq-cron-no-show
!include _seq-style.iuml
title Expire No-show Reservations Sequence Diagram

participant ":ReservationsCron\n(every minute)" as Cron
participant ":ReservationsService" as Svc
participant ":PrismaService" as Repo
participant ":TrustService" as Trust
database "Database" as DB

Cron -> Svc : expireNoShows()
activate Svc

group A. Đơn TỰ ĐẾN LẤY quá hạn → no_show + phạt
  Svc -> Repo : reservation.findMany(status = confirmed, qrExpiresAt < now,\ndelivery IS NULL OR delivery.status = cancelled) take 200
  note right of Svc : gồm cả đơn mà người nhận đã bấm "tự đến lấy"\n(delivery cancelled) — nhóm này từng kẹt 'confirmed' vĩnh viễn
  Repo -> DB : SELECT reservations LEFT JOIN deliveries
  DB --> Repo : overdue[]
  Repo --> Svc : overdue
  loop for each reservation
    group $transaction
      Svc -> Repo : reservation.update(status = no_show)
      Svc -> Repo : $executeRaw quantity_remaining = LEAST(total, remaining + qty), status = active
      Svc -> Repo : receiverProfile.update(reservationsToday −1)
      Repo -> DB : UPDATE reservations / food_listings / receiver_profiles
    end
    Svc -> Trust : applyDelta(receiver, −20, NO_SHOW)
    note right of Svc : giữ suất ăn rồi không đến = thiệt hại thật → phạt
  end
end

group B. Đơn GIAO HÀNG quá hạn chưa có shipper → expired, KHÔNG phạt
  Svc -> Repo : reservation.findMany(status = confirmed, qrExpiresAt < now,\ndelivery.status in pending_assignment/failed) take 200
  Repo --> Svc : unassigned[]
  loop for each reservation
    group $transaction
      Svc -> Repo : reservation.update(status = expired)
      opt delivery still pending_assignment
        Svc -> Repo : delivery.update(status = failed)
        note right of Svc : delivery đã 'failed' thì giữ nguyên lý do gốc,\nkhông ghi đè
      end
      Svc -> Repo : restore listing stock
      Repo -> DB : UPDATE reservations / deliveries / food_listings
    end
  end
  note right of Svc : không ai nhận đơn là lỗi hệ thống,\nkhông phải lỗi người nhận → không trừ điểm
end

Svc --> Cron : số đơn đã xử lý
deactivate Svc
@enduml

'──────────────────── 2. Daily Reset ─────────────────────────
@startuml seq-cron-daily-reset
!include _seq-style.iuml
title Reset Daily Reservation Counters Sequence Diagram

participant ":ReservationsCron\n(00:00 daily)" as Cron
participant ":ReservationsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

Cron -> Svc : resetDailyReservationCounters()
activate Svc
Svc -> Repo : receiverProfile.updateMany(reservationsToday = 0)
note right of Svc : hạn mức MAX_RESERVATIONS_PER_DAY tính theo ngày —\nkhông reset thì user bị khoá đặt vĩnh viễn
Repo -> DB : UPDATE receiver_profiles SET reservations_today = 0
DB --> Repo : count
Svc --> Cron : done
deactivate Svc
@enduml

'──────────────────── 3. Offer Sweep & Re-broadcast ──────────
@startuml seq-cron-offer-sweep
!include _seq-style.iuml
title Sweep Shipper Offers Sequence Diagram

participant ":DeliveriesCron\n(every 30s)" as Cron
participant ":DeliveriesService" as Svc
participant ":PrismaService" as Repo
participant ":NotificationsGateway" as WS
database "Database (PostGIS)" as DB
actor "Shipper" as Shipper
actor "Receiver" as Receiver

Cron -> Svc : sweepOffersAndRebroadcast()
activate Svc
Svc -> Repo : shipperTaskOffer.findMany(status = pending, expiresAt < now)
Repo -> DB : SELECT shipper_task_offers
DB --> Repo : expired[]
loop for each lapsed offer
  Svc -> Repo : offer.update(status = expired)
  Svc -> Repo : volunteerProfile.update(isAvailable = false)
  note right of Svc : offer lapse (không accept, không reject) = không ai ở máy.\nTắt sẵn sàng để tài khoản chết không chặn hàng đợi.
end
Svc -> Repo : delivery.findMany(status = pending_assignment) with no live offer
Repo --> Svc : unassigned[]
loop for each unassigned delivery
  alt time since creation >= ASSIGNMENT_TIMEOUT_MS (4m30s)
    Svc -> Repo : delivery.update(status = failed) + reservation.update(cancelled) + restore stock
    Svc -> WS : emitToUser(receiver, "không tìm được TNV — vui lòng đặt lại")
    WS --> Receiver : notification
    note right of Svc : huỷ KHÔNG phạt uy tín người nhận
  else still within the window
    Svc -> Repo : $queryRaw nearest available VERIFIED shipper\nST_DWithin(5km), chưa từng được mời delivery này
    Repo -> DB : SELECT volunteer_profiles ORDER BY distance LIMIT 1
    DB --> Repo : shipper | null
    alt A shipper is available
      Svc -> Repo : shipperTaskOffer.create(expiresAt = +15s)
      Svc -> WS : emitToUser(shipper, 'delivery:offer')
      WS --> Shipper : accept popup
      note right of Svc : mời TUẦN TỰ từng người (mô hình gọi xe),\ntối đa 5 lượt mời mỗi đơn
    else nobody left in range
      Svc -> Svc : chờ vòng quét sau
    end
  end
end
Svc --> Cron : số đơn đã re-broadcast
deactivate Svc
@enduml

'──────────────────── 4. Stalled Deliveries ──────────────────
@startuml seq-cron-stalled-delivery
!include _seq-style.iuml
title Auto-fail Stalled Deliveries Sequence Diagram

participant ":DeliveriesCron\n(every 5 min)" as Cron
participant ":DeliveriesService" as Svc
participant ":PrismaService" as Repo
participant ":NotificationsService" as Notif
database "Database" as DB
actor "Receiver" as Receiver

Cron -> Svc : expireStalledDeliveries()
activate Svc
Svc -> Repo : delivery.findMany(status in assigned/heading_to_provider/qc_completed/in_transit,\nupdatedAt < now − DELIVERY_STALL_HOURS (6h))
Repo -> DB : SELECT deliveries
DB --> Repo : stalled[]
Repo --> Svc : stalled
alt No stalled delivery
  Svc --> Cron : 0
else has stalled deliveries
  loop for each delivery
    group $transaction
      Svc -> Repo : delivery.update(status = failed, failureReason = "quá {6}h không cập nhật")
      Svc -> Repo : reservation.update(status = cancelled)
      Svc -> Repo : restore listing stock
      Svc -> Repo : volunteerProfile.update(free the shipper)
      Repo -> DB : UPDATE deliveries / reservations / food_listings / volunteer_profiles
    end
    Svc -> Notif : notify(receiver, "Chuyến giao đã thất bại")
    Notif --> Receiver : realtime notification
  end
  Svc --> Cron : count
end
deactivate Svc
@enduml

'──────────────────── 5. Listing Expiry Alerts ───────────────
@startuml seq-cron-listing-expiry-alert
!include _seq-style.iuml
title Listing Expiry Alert Sequence Diagram

participant ":ListingsCron\n(every 30 min)" as Cron
participant ":PrismaService" as Repo
participant ":NotificationsService" as Notif
database "Database" as DB
actor "Provider" as Provider

Cron -> Cron : thirtyMinutesFromNow / oneHourFromNow
activate Cron
Cron -> Repo : foodListing.findMany(status = active, deletedAt = null,\nexpiryTime > now AND <= now + 1h) include provider.user
Repo -> DB : SELECT food_listings JOIN provider_profiles JOIN users
DB --> Repo : expiringListings[]
Repo --> Cron : listings
loop for each listing
  Cron -> Cron : isNear = expiryTime <= now + 30 min\nminutesLeft = round((expiryTime − now) / 60000)
  alt isNear
    Cron -> Notif : notify(provider, type = listing_expiring_urgent, "Tin sắp hết hạn!")
  else within the hour
    Cron -> Notif : notify(provider, type = listing_expiring_soon, "Thông báo hết hạn")
  end
  Notif --> Provider : realtime notification
end
note right of Cron : nhắc sớm để NCC kịp hạ giá / gia hạn /\nchuyển sang giao sỉ thay vì để thức ăn bỏ đi
deactivate Cron
@enduml

'──────────────────── 6. Expire Overdue Campaigns ────────────
@startuml seq-cron-campaign-expire
!include _seq-style.iuml
title Expire Overdue Campaigns Sequence Diagram

participant ":CampaignsCron\n(00:00 daily)" as Cron
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
participant ":NotificationsService" as Notif
database "Database" as DB
actor "Charity Org" as Charity

Cron -> Svc : expireOverdueCampaigns()
activate Svc
Svc -> Repo : kitchenCampaign.findMany(status = open, endDate NOT NULL) include charityReceiver
Repo -> DB : SELECT kitchen_campaigns
DB --> Repo : candidates[]
Repo --> Svc : candidates
loop for each campaign
  Svc -> Svc : endAt = endDate + endTime (UTC)
  alt endAt < now
    Svc -> Svc : push to overdueIds[]
  end
end
alt overdueIds is empty
  Svc --> Cron : 0
else has overdue campaigns
  Svc -> Repo : kitchenCampaign.updateMany(id in overdueIds, status = cancelled)
  Repo -> DB : UPDATE kitchen_campaigns
  loop for each cancelled campaign
    Svc -> Notif : notify(charity, "Chiến dịch đã quá hạn — tự động huỷ")
    Notif --> Charity : realtime notification
  end
  note right of Svc : chiến dịch 'open' qua ngày diễn ra mà chưa ai bấm bắt đầu\n→ đóng lại để TNV không đăng ký vào việc không tồn tại
  Svc --> Cron : count
end
deactivate Svc
@enduml

'──────────────────── 7. Auto-complete Campaigns ─────────────
@startuml seq-cron-campaign-autocomplete
!include _seq-style.iuml
title Auto-complete Expired Campaigns Sequence Diagram

participant ":CampaignsCron\n(hourly)" as Cron
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
participant ":NotificationsService" as Notif
database "Database" as DB
actor "Charity Org" as Charity

Cron -> Svc : autoCompleteExpiredCampaigns()
activate Svc
Svc -> Repo : kitchenCampaign.findMany(status = in_progress, endDate NOT NULL)
Repo -> DB : SELECT kitchen_campaigns
DB --> Repo : candidates[]
loop for each campaign
  Svc -> Svc : endAt = endDate + endTime (UTC); expired if endAt < now
end
alt none expired
  Svc --> Cron : 0
else has expired campaigns
  Svc -> Repo : kitchenCampaign.updateMany(id in expiredIds, status = completed)
  note right of Svc : KHÔNG tự nhập actualServings —\nchiến dịch chạy thật vẫn dùng nút "Hoàn tất" ở UI.\nCron chỉ đóng campaign bị bỏ quên.
  Repo -> DB : UPDATE kitchen_campaigns
  loop for each campaign
    Svc -> Notif : notify(charity, "Chiến dịch đã được tự kết thúc")
    Notif --> Charity : realtime notification
  end
  Svc --> Cron : count
end
deactivate Svc
@enduml

'──────────────────── 8. Nudge Upcoming Tasks ────────────────
@startuml seq-cron-nudge-tasks
!include _seq-style.iuml
title Nudge Volunteer Shift Tasks Sequence Diagram

participant ":CampaignsCron\n(every 5 min)" as Cron
participant ":CampaignsService" as Svc
participant ":PrismaService" as Repo
participant ":NotificationsService" as Notif
database "Database" as DB
actor "Volunteer" as Volunteer

Cron -> Svc : nudgeUpcomingTasks()
activate Svc

group 1. Ca bắt đầu trong 30 phút tới
  Svc -> Repo : $queryRaw assignments JOIN campaigns JOIN shifts JOIN users\nWHERE campaign in_progress AND assignment in (assigned, checked_in)\nAND (shift.start_time − LOCALTIME) BETWEEN 0 AND 30 min LIMIT 200
  Repo -> DB : SELECT campaign_volunteer_assignments JOIN …
  DB --> Repo : upcoming[]
  Repo --> Svc : upcoming
  loop for each assignment
    Svc -> Repo : notification.findFirst(userId, type = campaign_urgent, createdAt > now − 6h)
    Repo --> Svc : recent | null
    alt already nudged for this assignment within 6h
      Svc -> Svc : skip
      note right of Svc : chống spam — mỗi assignment + kind\nchỉ nhắc 1 lần / 6 giờ
    else not nudged yet
      Svc -> Notif : notify(volunteer, "Sắp đến giờ ca của bạn")
      Notif --> Volunteer : realtime notification
    end
  end
end

group 2. Ca đã kết thúc quá 15 phút mà assignment vẫn assigned/checked_in
  Svc -> Repo : $queryRaw overdue shifts
  Repo --> Svc : passed[]
  loop for each assignment
    Svc -> Notif : notify(volunteer, kind = deadline_quarter_passed)
    Notif --> Volunteer : realtime notification
  end
end

Svc --> Cron : tổng số thông báo đã gửi
deactivate Svc
@enduml
