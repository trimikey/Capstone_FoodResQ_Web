'==============================================================
' FoodResQ — Sequence Diagrams: Food Listing (listings module)
' Search nearby · View detail · Create · My listings · Publish · Cancel
'==============================================================

'──────────────────── 1. Search Nearby Listings ──────────────
@startuml seq-listing-search
!include _seq-style.iuml
title Search Nearby Listings Sequence Diagram

actor "Receiver" as User
participant ":ListingsScreen" as Screen
participant ":ListingsController" as Ctrl
participant ":ListingsService" as Svc
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB

User -> Screen : open map / list (lat, lng, radius)
activate Screen
Screen -> Ctrl : GET /listings?lat&lng&radiusKm&category&search
activate Ctrl
Ctrl -> Svc : findNearby(query)
activate Svc
alt lat & lng provided
  Svc -> Repo : $queryRaw spatial search\n(ST_DWithin + ST_Distance ORDER BY distance)
  Repo -> DB : SELECT food_listings JOIN provider_profiles\nWHERE active, not deleted, qty>0, within radius
else no location
  Svc -> Repo : $queryRaw latest active listings\n(ORDER BY created_at DESC)
  Repo -> DB : SELECT food_listings (latest active)
end
DB --> Repo : rows[]
Repo --> Svc : rows[]
Svc -> Svc : map rows → DTO (distanceM, lng/lat, provider)
Svc --> Ctrl : listings[]
Ctrl --> Screen : return data (200)
Screen --> User : render markers / cards
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 2. View Listing Detail ─────────────────
@startuml seq-listing-detail
!include _seq-style.iuml
title Listing Detail Sequence Diagram

actor "Receiver" as User
participant ":DetailScreen" as Screen
participant ":ListingsController" as Ctrl
participant ":ListingsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : open listing
activate Screen
Screen -> Ctrl : GET /listings/:id
activate Ctrl
Ctrl -> Svc : findOne(id)
activate Svc
Svc -> Repo : $queryRaw SELECT listing + provider (ST_X/ST_Y)
Repo -> DB : SELECT food_listings JOIN provider_profiles WHERE id, not deleted
DB --> Repo : row | empty
Repo --> Svc : row | empty
alt Not found
  Svc --> Ctrl : 404 NotFound
  Ctrl --> Screen : return error
  Screen --> User : show error message
else Found
  Svc --> Ctrl : listing detail (with coords)
  Ctrl --> Screen : return data (200)
  Screen --> User : render detail
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 3. Create Listing ──────────────────────
@startuml seq-listing-create
!include _seq-style.iuml
title Create Listing Sequence Diagram

actor "Provider" as User
participant ":CreateListingScreen" as Screen
participant ":ListingsController" as Ctrl
participant ":ListingsService" as Svc
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB

User -> Screen : fill listing form + location
activate Screen
Screen -> Ctrl : POST /listings (CreateListingDto)
activate Ctrl
Ctrl -> Svc : create(userId, dto)
activate Svc
Svc -> Repo : providerProfile.findUnique(userId) → providerId
Repo --> Svc : providerId
alt No provider profile
  Svc --> Ctrl : 404 "Provider profile not found"
  Ctrl --> Screen : return error
  Screen --> User : show error message
else valid provider
  alt pickupEnd <= pickupStart OR expiry < pickupEnd
    Svc --> Ctrl : 400 "Invalid time range"
    Ctrl --> Screen : return error
    Screen --> User : show error message
  else valid times
    Svc -> Repo : $queryRaw INSERT food_listings\n(status=draft, ST_MakePoint location)
    Repo -> DB : INSERT food_listings
    DB --> Repo : { id }
    Svc -> Svc : findOne(id)
    Svc --> Ctrl : listing (draft)
    Ctrl --> Screen : return data (201)
    Screen --> User : listing created (draft)
  end
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 4. My Listings (Provider) ──────────────
@startuml seq-listing-mine
!include _seq-style.iuml
title My Listings Sequence Diagram

actor "Provider" as User
participant ":ProviderScreen" as Screen
participant ":ListingsController" as Ctrl
participant ":ListingsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : open my listings
activate Screen
Screen -> Ctrl : GET /listings/provider/my?page&limit
activate Ctrl
Ctrl -> Svc : findByProvider(userId, page, limit)
activate Svc
Svc -> Repo : providerProfile.findUnique(userId) → providerId
Svc -> Repo : $transaction [ foodListing.findMany(providerId, deletedAt=null), count ]
Repo -> DB : SELECT food_listings + COUNT
DB --> Repo : items[], total
Repo --> Svc : items[], total
Svc --> Ctrl : { items, total, page, totalPages }
Ctrl --> Screen : return data (200)
Screen --> User : render listing table
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 5. Publish Listing ─────────────────────
@startuml seq-listing-publish
!include _seq-style.iuml
title Publish Listing Sequence Diagram

actor "Provider" as User
participant ":ProviderScreen" as Screen
participant ":ListingsController" as Ctrl
participant ":ListingsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : tap Publish
activate Screen
Screen -> Ctrl : PATCH /listings/:id/publish
activate Ctrl
Ctrl -> Svc : publish(listingId, userId)
activate Svc
Svc -> Repo : providerProfile.findUnique(userId) → providerId
Svc -> Repo : foodListing.findUnique(listingId)
Repo --> Svc : listing | null
alt Not found OR not owner OR status != draft
  Svc --> Ctrl : 400 / 403 / 404 error
  Ctrl --> Screen : return error
  Screen --> User : show error message
else draft & owner
  Svc -> Repo : foodListing.update(status=active)
  Repo -> DB : UPDATE food_listings
  Svc --> Ctrl : listing (active)
  Ctrl --> Screen : return data (200)
  Screen --> User : listing is now live
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 6. Cancel Listing ──────────────────────
@startuml seq-listing-cancel
!include _seq-style.iuml
title Cancel Listing Sequence Diagram

actor "Provider" as User
participant ":ProviderScreen" as Screen
participant ":ListingsController" as Ctrl
participant ":ListingsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : tap Cancel (reason?)
activate Screen
Screen -> Ctrl : PATCH /listings/:id/cancel
activate Ctrl
Ctrl -> Svc : cancel(listingId, userId, reason)
activate Svc
Svc -> Repo : providerProfile.findUnique(userId) → providerId
Svc -> Repo : foodListing.findUnique(listingId)
Repo --> Svc : listing | null
alt Not found OR not owner
  Svc --> Ctrl : 403 / 404 error
  Ctrl --> Screen : return error
  Screen --> User : show error message
else owner
  Svc -> Repo : foodListing.update(status=cancelled, cancelledReason)
  Repo -> DB : UPDATE food_listings
  Svc --> Ctrl : listing (cancelled)
  Ctrl --> Screen : return data (200)
  Screen --> User : listing cancelled
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 7. Update Listing ──────────────────────
@startuml seq-listing-update
!include _seq-style.iuml
title Update Listing Sequence Diagram

actor "Provider" as User
participant ":EditListingScreen" as Screen
participant ":ListingsController" as Ctrl
participant ":ListingsService" as Svc
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB

User -> Screen : edit a listing
activate Screen
Screen -> Ctrl : PATCH /listings/:id (UpdateListingDto)
activate Ctrl
Ctrl -> Svc : update(listingId, userId, dto)
activate Svc
Svc -> Svc : resolveProviderId(userId)
Svc -> Repo : foodListing.findUnique(id)
Repo -> DB : SELECT food_listings
DB --> Repo : listing | null
Repo --> Svc : listing
alt Not found
  Svc --> Ctrl : 404 NotFound
else listing.providerId != providerId
  Svc --> Ctrl : 403 "Bạn không sở hữu tin này"
else status not in (draft, active, fully_reserved)
  Svc --> Ctrl : 400 "Tin đang ở trạng thái {status} — không thể chỉnh sửa"
else editable
  alt status = draft
    Svc -> Svc : validate pickupEnd > pickupStart AND expiry >= pickupEnd
    note right of Svc : bản nháp sửa được MỌI field,\nkể cả toạ độ (qua raw SQL)
    alt Invalid time ordering
      Svc --> Ctrl : 400 BadRequest
    end
  else status = active / fully_reserved
    loop for each field in dto
      alt field not in EDITABLE_WHEN_ACTIVE
        Svc --> Ctrl : 400 "Không thể sửa {field} khi tin đã đăng"
        note right of Svc : chỉ cho sửa field mềm (mô tả, ảnh,\nbảo quản, dị ứng) — người nhận đã đặt theo\nđịa điểm/giờ/số lượng cũ
      end
    end
    Svc -> Svc : chỉ cho GIA HẠN, không rút ngắn\n(pickupEnd mới phải > pickupEnd cũ và ở tương lai)
    alt Attempt to shorten the window OR set it in the past
      Svc --> Ctrl : 400 BadRequest
    end
  end
  alt quantityTotal mới < quantityRemaining
    Svc --> Ctrl : 400 BadRequest
    note right of Svc : giảm tổng xuống dưới số còn lại\n= số liệu vô nghĩa
  else valid
    Svc -> Repo : foodListing.update(whitelisted fields)
    opt draft + coordinates changed
      Svc -> Repo : $executeRaw UPDATE pickup_location = ST_MakePoint(lng, lat)
    end
    Repo -> DB : UPDATE food_listings
    Svc --> Ctrl : updated listing
    Ctrl --> Screen : return data (200)
    Screen --> User : listing saved
  end
end
Ctrl --> Screen : return error (on any failure)
Screen --> User : show error message
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 8. Delete Draft ────────────────────────
@startuml seq-listing-delete-draft
!include _seq-style.iuml
title Delete Draft Listing Sequence Diagram

actor "Provider" as User
participant ":MyListingsScreen" as Screen
participant ":ListingsController" as Ctrl
participant ":ListingsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : delete a draft
activate Screen
Screen -> Ctrl : DELETE /listings/:id
activate Ctrl
Ctrl -> Svc : removeDraft(listingId, userId)
activate Svc
Svc -> Svc : resolveProviderId(userId)
Svc -> Repo : foodListing.findUnique(id)
Repo -> DB : SELECT food_listings
DB --> Repo : listing | null
Repo --> Svc : listing
alt Not found OR already soft-deleted
  Svc --> Ctrl : 404 NotFound
else not the owner
  Svc --> Ctrl : 403 Forbidden
else status != draft
  Svc --> Ctrl : 400 "Chỉ xoá được bản nháp — tin đã đăng hãy dùng chức năng huỷ"
  note right of Svc : tin đã đăng có thể đã có đơn đặt →\nxoá thẳng sẽ làm mồ côi reservation
else draft
  Svc -> Repo : foodListing.update(deletedAt = NOW())
  note right of Svc : soft delete (CLAUDE.md §5)
  Repo -> DB : UPDATE food_listings SET deleted_at
  Svc --> Ctrl : { id, message }
  Ctrl --> Screen : return data (200)
  Screen --> User : draft removed
end
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 9. Duplicate Listing ───────────────────
@startuml seq-listing-duplicate
!include _seq-style.iuml
title Duplicate Listing Sequence Diagram

actor "Provider" as User
participant ":MyListingsScreen" as Screen
participant ":ListingsController" as Ctrl
participant ":ListingsService" as Svc
participant ":PrismaService" as Repo
database "Database (PostGIS)" as DB

User -> Screen : "đăng lại tin này"
activate Screen
Screen -> Ctrl : POST /listings/:id/duplicate
activate Ctrl
Ctrl -> Svc : duplicate(listingId, userId)
activate Svc
Svc -> Svc : resolveProviderId(userId)
Svc -> Repo : foodListing.findUnique(id)
Repo --> Svc : original | null
alt Not found
  Svc --> Ctrl : 404 NotFound
else not the owner
  Svc --> Ctrl : 403 Forbidden
else owner
  Svc -> Repo : $queryRaw ST_X / ST_Y (pickup_location)
  Repo -> DB : SELECT food_listings
  DB --> Repo : { lng, lat }
  Svc -> Repo : $queryRaw INSERT food_listings (copy fields,\nquantity_remaining = quantity_total, ST_MakePoint(lng, lat), status = 'draft') RETURNING id
  note right of Svc : bản sao luôn là DRAFT —\nNCC phải rà lại giờ nhận rồi mới đăng
  Repo -> DB : INSERT food_listings
  DB --> Repo : { id }
  alt Insert returned nothing
    Svc --> Ctrl : 400 "Nhân bản tin thất bại"
  else created
    Svc -> Svc : findOne(newId)
    Svc --> Ctrl : new listing (draft)
    Ctrl --> Screen : return data (201)
    Screen --> User : open the copy for editing
  end
end
Ctrl --> Screen : return error (on any failure)
Screen --> User : show error message
deactivate Svc
deactivate Ctrl
deactivate Screen
@enduml

'──────────────────── 10. Provider Listing Stats ─────────────
@startuml seq-listing-provider-stats
!include _seq-style.iuml
title Provider Listing Stats Sequence Diagram

actor "Provider" as User
participant ":ProviderDashboard" as Screen
participant ":ListingsController" as Ctrl
participant ":ListingsService" as Svc
participant ":PrismaService" as Repo
database "Database" as DB

User -> Screen : open dashboard
activate Screen
Screen -> Ctrl : GET /listings/provider/stats
activate Ctrl
Ctrl -> Svc : getProviderStats(userId)
activate Svc
Svc -> Svc : resolveProviderId(userId)
Svc -> Repo : $transaction([ count listings, count active,\ncount reservations, count completed ])
note right of Svc : 4 count trong 1 transaction —\nsố liệu chụp cùng một thời điểm
Repo -> DB : SELECT COUNT(*) × 4
DB --> Repo : counts
Repo --> Svc : totals
Svc -> Svc : completionRate = round(completed / total × 100)
Svc --> Ctrl : { totalListings, activeListings, totalReservations, completedReservations, completionRate }
deactivate Svc
Ctrl --> Screen : return data (200)
deactivate Ctrl
Screen --> User : render KPI tiles
deactivate Screen
@enduml
