  slotsFilled Int                           @default(0) @map("slots_filled") @db.SmallInt
  createdAt   DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign    KitchenCampaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  assignments CampaignVolunteerAssignment[]

  @@index([campaignId])
  @@map("campaign_shifts")
}

model KitchenSafetyLog {
  id                   String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId           String            @map("campaign_id") @db.Uuid
  checkedByVolunteerId String            @map("checked_by_volunteer_id") @db.Uuid
  checkType            SafetyCheckType   @map("check_type")
  measuredValue        String?           @map("measured_value") @db.VarChar(50)
  result               SafetyCheckResult @default(pass)
  photoUrl             String?           @map("photo_url")
  note                 String?
  checkedAt            DateTime          @default(now()) @map("checked_at") @db.Timestamptz(6)
  campaign             KitchenCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  checkedBy            VolunteerProfile  @relation(fields: [checkedByVolunteerId], references: [id])

  @@index([campaignId])
  @@index([checkedByVolunteerId])
  @@map("kitchen_safety_logs")
}

model MealDistribution {
  id                  String                                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId          String                                 @map("campaign_id") @db.Uuid
  servedByVolunteerId String                                 @map("served_by_volunteer_id") @db.Uuid
  roundLabel          String?                                @map("round_label") @db.VarChar(100)
  servingsServed      Int                                    @default(0) @map("servings_served")
  peopleServed        Int                                    @default(0) @map("people_served")
  leftoverServings    Int                                    @default(0) @map("leftover_servings")
  location            Unsupported("geography(Point, 4326)")?
  photoUrl            String?                                @map("photo_url")
  note                String?
  distributedAt       DateTime                               @default(now()) @map("distributed_at") @db.Timestamptz(6)
  campaign            KitchenCampaign                        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  servedBy            VolunteerProfile                       @relation(fields: [servedByVolunteerId], references: [id])
  feedback            MealFeedback[]
  handoffs            MealHandoff[]

  @@index([campaignId])
  @@index([servedByVolunteerId])
  @@map("meal_distributions")
}

model MealFeedback {
  id             String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  distributionId String           @map("distribution_id") @db.Uuid
  satisfaction   Int              @db.SmallInt
  comment        String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  distribution   MealDistribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)

  @@index([distributionId])
  @@map("meal_feedback")
}

model ReceiverHandoffQr {
  id          String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  receiverId  String          @map("receiver_id") @db.Uuid
  qrToken     String          @unique @map("qr_token") @db.VarChar(64)
  qrExpiresAt DateTime        @map("qr_expires_at") @db.Timestamptz(6)
  consumedAt  DateTime?       @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  receiver    ReceiverProfile @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  handoff     MealHandoff?

  @@index([receiverId, qrExpiresAt])
  @@map("receiver_handoff_qr_tokens")
}

model MealHandoff {
  id                    String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  distributionId        String            @map("distribution_id") @db.Uuid
  receiverId            String            @map("receiver_id") @db.Uuid
  scannedByVolunteerId  String            @map("scanned_by_volunteer_id") @db.Uuid
  qrTokenId             String            @unique @map("qr_token_id") @db.Uuid
  servedAt              DateTime          @default(now()) @map("served_at") @db.Timestamptz(6)
  distribution          MealDistribution  @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  receiver              ReceiverProfile   @relation(fields: [receiverId], references: [id], onDelete: Cascade)
  scannedBy             VolunteerProfile  @relation(fields: [scannedByVolunteerId], references: [id])
  qrToken               ReceiverHandoffQr @relation(fields: [qrTokenId], references: [id])
  feedback              BeneficiaryFeedback?

  @@unique([distributionId, receiverId])
  @@index([receiverId, servedAt])
  @@index([distributionId])
  @@map("meal_handoffs")
}

model BeneficiaryFeedback {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  handoffId    String      @unique @map("handoff_id") @db.Uuid
  satisfaction Int         @db.SmallInt
  comment      String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  handoff      MealHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)

  @@map("beneficiary_feedback")
}
