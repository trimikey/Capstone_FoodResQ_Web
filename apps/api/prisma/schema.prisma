enum CampaignMenuStepStatus {
  /// Bếp trưởng tạo step, đang chờ đến giờ VÀ/HOẶC khâu trước xong mới mở.
  locked
  /// Đủ 2 điều kiện (đến giờ + khâu trước done) — chef có thể tick "bắt đầu" (optional) hoặc "xong".
  available
  /// Đã tick "đang làm" — dùng cho UX (đang thao tác).
  in_progress
  /// Đã tick "hoàn thành" kèm ảnh bằng chứng — không thể chỉnh sửa.
  done

  @@map("campaign_dish_step_status")
}

/// Quy trình 4 khâu cố định cho mỗi món trong chiến dịch:
/// 1. Sơ chế → 2. Nấu → 3. Trình bày → 4. Sẵn sàng phát xuất
/// Mỗi món có 1 bản ghi step cho mỗi khâu; chef tick "xong" kèm ảnh bằng chứng.
/// Mở khâu: locked → available chỉ khi ĐỦ 2 điều kiện AND:
///   1. Đến `scheduled_time` của khâu đó (so với giờ thực tế).
///   2. Khâu trước cùng món đã ở trạng thái `done`.
model CampaignDishStep {
  id                     String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId             String                 @map("campaign_id") @db.Uuid
  menuItemId             String                 @map("menu_item_id") @db.Uuid
  /// 1 = Sơ chế, 2 = Nấu, 3 = Trình bày, 4 = Sẵn sàng phát xuất
  stepOrder              Int                    @map("step_order") @db.SmallInt
  stepName               String                 @map("step_name") @db.VarChar(100)
  /// Giờ dự kiến bắt đầu trong ngày (HH:mm, giờ VN). Lưu chuỗi để tránh timezone.
  scheduledTime          String                 @map("scheduled_time") @db.VarChar(8)
  status                 CampaignMenuStepStatus @default(locked)
  completedAt            DateTime?              @map("completed_at") @db.Timestamptz
  completedByVolunteerId String?                @map("completed_by_volunteer_id") @db.Uuid
  proofUrl               String?                @map("proof_url")
  note                   String?                @db.VarChar(500)
  /// Đánh dấu thời điểm server xác nhận khâu đủ điều kiện mở (đến giờ + khâu trư�c done).
  /// Dùng để debug + analytics, không ảnh hưởng logic.
  openedAt               DateTime?              @map("opened_at") @db.Timestamptz
  /// Bếp trưởng / QC đánh dấu khâu này fail chất lượng (ngắt khẩn cấp từ QC step).
  /// Món vẫn chạy tiếp từng phần — các món khác trong campaign không bị ảnh hưởng.
  qcFailedAt             DateTime?              @map("qc_failed_at") @db.Timestamptz
  qcFailedByVolunteerId  String?                @map("qc_failed_by_volunteer_id") @db.Uuid
  qcFailureReason        String?                @map("qc_failure_reason") @db.VarChar(500)
  /// Duyệt ảnh khâu QC (stepOrder=3) bởi TỔ CHỨC: chef chụp ảnh xong → 'pending';
  /// tổ chức duyệt → 'approved' (mới mở được khâu 4); từ chối → 'rejected' + khâu 3
  /// quay về available để chef chụp lại.
  reviewStatus           String?                @map("review_status") @db.VarChar(20)
  reviewedAt             DateTime?              @map("reviewed_at") @db.Timestamptz
  reviewNote             String?                @map("review_note") @db.VarChar(500)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  campaign             KitchenCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  menuItem             CampaignMenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  completedByVolunteer VolunteerProfile? @relation(fields: [completedByVolunteerId], references: [id], onDelete: SetNull)
  qcFailedByVolunteer  VolunteerProfile? @relation("CampaignDishStep_QCFailure", fields: [qcFailedByVolunteerId], references: [id], onDelete: SetNull)

  @@unique([campaignId, menuItemId, stepOrder])
  @@index([campaignId])
  @@index([menuItemId])
  @@index([status])
  @@index([scheduledTime])
  @@map("campaign_dish_steps")
}

/**
 * Danh mục thực phẩm do admin tự quản lý.
 * `food_category` (enum) chỉ có 9 nhóm lớn cố định — quá thô để mô tả thứ thực tế
 * nhận được. Bảng này là lớp CHI TIẾT bên dưới mỗi nhóm, admin thêm/sửa được mà
 * không cần đổi enum hay migrate:
 * canned_packaged → "Đồ hộp móp méo", "Đồ hộp cận date"
 * cooked_meal     → "Cơm gà còn dư", "Cháo dinh dưỡng"
 * fresh_fruit     → "Chuối", "Nho"
 */
/// Nhóm thực phẩm do admin tự tạo (vd "Đồ hộp / đóng gói", "Trái cây tươi").
model FoodCatalogCategory {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String    @db.VarChar(120)
  /// 'ready_to_eat' | 'raw_ingredient' | 'other' — nhóm lớn để xếp thứ tự hiển thị.
  /// Để chuỗi thay vì enum Postgres: đây là cách gom nhóm cho UI, còn thay đổi theo
  /// nghiệp vụ, không đáng tạo thêm một enum type phải migrate mỗi lần sửa.
  group       String    @default("other") @db.VarChar(20)
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  items FoodCatalogItem[]

  @@map("food_catalog_categories")
}

/// Một loại thực phẩm cụ thể nằm trong một nhóm (vd "Đồ hộp móp méo").
model FoodCatalogItem {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  name        String    @db.VarChar(255)
  description String?
  /// Tắt thay vì xoá khi một loại không còn dùng nhưng vẫn cần giữ lịch sử.
  isActive    Boolean   @default(true) @map("is_active")
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  category FoodCatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
  @@map("food_catalog_items")
}

model BeneficiaryFeedback {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  handoffId    String      @unique @map("handoff_id") @db.Uuid
  satisfaction Int         @db.SmallInt
  comment      String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  handoff      MealHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade)

  @@map("beneficiary_feedback")
}
