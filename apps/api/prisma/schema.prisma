model MealDistribution {
  id                     String                                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId             String                                 @map("campaign_id") @db.Uuid
  /// TNV đứng tên chính cho đợt phát (giữ FK để báo cáo cũ không vỡ).
  /// Khi phân công nhiều shipper thì đây là người đầu tiên trong `assigneeIds`.
  servedByVolunteerId    String                                 @map("served_by_volunteer_id") @db.Uuid
  /// Danh sách volunteer_profiles.id của TẤT CẢ shipper được phân công đi phát đợt này.
  /// JSONB array<uuid>. Null/rỗng = chỉ có một người là `servedByVolunteerId`.
  assigneeIds            Json?                                  @map("assignee_ids")
  /// Các điểm phát của đợt: JSONB array<{ label, address, lng?, lat? }>.
  /// Để JSONB thay vì bảng riêng cho nhất quán với `demand_details` — bộ field này
  /// còn thay đổi và không cần truy vấn không gian trên từng điểm.
  points                 Json?
  /// NULL = mới lên kế hoạch (đã điều shipper, chưa đi phát).
  /// Có giá trị = shipper/tổ chức đã xác nhận phát xong.
  /// Thống kê "đã phát" của chiến dịch CHỈ tính các đợt đã xác nhận, nếu không số
  /// liệu bị đội lên ngay lúc lập kế hoạch.
  completedAt            DateTime?                              @map("completed_at") @db.Timestamptz
  /// volunteer_profiles.id của người bấm xác nhận. Không khai relation để khỏi thêm
  /// khoá ngoại thứ hai lên VolunteerProfile — chỉ cần lưu vết ai xác nhận.
  completedByVolunteerId String?                                @map("completed_by_volunteer_id") @db.Uuid
  /// Số suất shipper BÁO CÁO đã phát thực tế (khác `servingsServed` là số tổ chức
  /// lên kế hoạch). Thống kê ưu tiên con số này khi có — kế hoạch và thực tế lệch
  /// nhau là chuyện thường (mưa, ít người tới, hàng hỏng).
  actualServings         Int?                                   @map("actual_servings")
  /// Số người thực nhận do shipper báo.
  actualPeopleServed     Int?                                   @map("actual_people_served")
  /// Ghi chú của shipper lúc chốt đợt phát (vd "còn dư 5 suất, đã gửi lại bếp").
  completionNote         String?                                @map("completion_note")
  roundLabel             String?                                @map("round_label") @db.VarChar(100)
  servingsServed         Int                                    @default(0) @map("servings_served")
  peopleServed           Int                                    @default(0) @map("people_served")
  leftoverServings       Int                                    @default(0) @map("leftover_servings")
  location               Unsupported("geography(Point, 4326)")?
  photoUrl               String?                                @map("photo_url")
  note                   String?
  distributedAt          DateTime                               @default(now()) @map("distributed_at") @db.Timestamptz(6)
  campaign               KitchenCampaign                        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  servedBy               VolunteerProfile                       @relation(fields: [servedByVolunteerId], references: [id])
  feedback               MealFeedback[]
  handoffs               MealHandoff[]

  @@index([campaignId])
  @@index([servedByVolunteerId])
  @@map("meal_distributions")
}

