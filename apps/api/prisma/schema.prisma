generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // prisma db push/migrate cần kết nối trực tiếp. Dùng pooler vì session mode Supabase
  // có thể không accessible từ mạng khác.
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  provider
  receiver
  volunteer

  @@map("user_role")
}

enum UserStatus {
  pending_verification
  active
  suspended
  banned

  @@map("user_status")
}

enum BusinessType {
  restaurant
  supermarket
  bakery
  hotel
  other

  @@map("business_type")
}

enum VerificationStatus {
  pending
  under_review
  approved
  rejected

  @@map("verification_status")
}

enum VolunteerRank {
  newcomer
  active
  experienced
  expert

  @@map("volunteer_rank")
}

enum VolunteerSpecialization {
  shipper
  chef
  waiter

  @@map("volunteer_specialization")
}

enum FoodCategory {
  // Giá trị thực tế đang dùng trong DB (Postgres enum food_category)
  cooked_meal
  bakery
  fresh_fruit
  beverage
  vegetables
  raw_protein
  dry_goods
  canned_packaged
  other
  // Giá trị cũ — giữ lại để không phá code đang tham chiếu (không còn dùng trong DB)
  prepared_meal
  raw_ingredients

  @@map("food_category")
}

enum ListingStatus {
  draft
  active
  fully_reserved
  completed
  expired
  cancelled

  @@map("listing_status")
}

enum QuantityUnit {
  kg
  portion
  item
  box
  liter

  @@map("quantity_unit")
}

enum ReservationStatus {
  confirmed
  picked_up
  completed
  cancelled
  expired
  no_show

  @@map("reservation_status")
}

enum PickupVerificationType {
  face
  id_card

  @@map("pickup_verification_type")
}

enum DeliveryStatus {
  pending_assignment
  assigned
  heading_to_provider
  qc_completed
  in_transit
  delivered
  failed
  cancelled // Người nhận hủy tìm shipper

  @@map("delivery_status")
}

enum CampaignStatus {
  pending_approval
  approved
  in_progress
  completed
  cancelled

  @@map("campaign_status")
}

enum RecruitmentStatus {
  scheduled
  open
  staffed
  expired_understaffed
  closed_ready

  @@map("recruitment_status")
}

enum CampaignShiftPeriod {
  midnight
  morning
  afternoon
  evening

  @@map("campaign_shift_period")
}

enum AssignmentConfirmationStatus {
  pending
  confirmed
  declined

  @@map("assignment_confirmation_status")
}

enum AssignmentRole {
  chef
  waiter
  shipper

  @@map("assignment_role")
}

enum AssignmentStatus {
  pending
  assigned
  checked_in
  in_progress
  completed
  absent
  rejected
  cancelled

  @@map("assignment_status")
}

enum VerificationRequestType {
  provider_registration
  charity_registration
  volunteer_chef_cert
  receiver_income_proof

  @@map("verification_request_type")
}

enum TrustScoreReason {
  late_cancellation
  no_show
  bad_rating_received
  food_safety_violation
  hoarding_detected
  manual_penalty
  successful_rescue
  high_rating_received
  manual_bonus
  /// Shipper đến điểm lấy hàng muộn ≥ 60 phút so với giờ hẹn.
  late_pickup
  /// Shipper huỷ chuyến giao sỉ SAU khi nhà cung cấp đã duyệt (kho đã bị giữ).
  bulk_run_cancelled_after_approval
  /// TNV điểm danh trễ quá thời gian ân hạn tại chiến dịch bếp ăn.
  late_check_in
  /// TNV đã được duyệt nhưng hết ngày trực vẫn không điểm danh.
  volunteer_no_show

  @@map("trust_score_reason")
}

enum OfferStatus {
  pending
  accepted
  rejected
  expired

  @@map("offer_status")
}

enum ReportTargetType {
  user
  listing
  delivery
  campaign

  @@map("report_target_type")
}

enum ReportReason {
  spoiled_food
  fake_account
  hoarding
  no_show_provider
  unsafe_food
  harassment
  fraud
  other

  @@map("report_reason")
}

enum ReportStatus {
  pending
  under_review
  resolved
  dismissed

  @@map("report_status")
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  email        String     @unique @db.VarChar(255)
  phone        String?    @unique @db.VarChar(20)
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name") @db.VarChar(255)
  avatarUrl    String?    @map("avatar_url")
  role         UserRole
  status       UserStatus @default(pending_verification)
  trustScore   Int        @default(100) @map("trust_score") @db.SmallInt
  fcmToken     String?    @map("fcm_token")
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime?  @map("deleted_at") @db.Timestamptz

  providerProfile                 ProviderProfile?
  receiverProfile                 ReceiverProfile?
  volunteerProfile                VolunteerProfile?
  liabilityWaivers                LiabilityWaiver[]
  refreshTokens                   RefreshToken[]
  verificationRequests            VerificationRequest[]
  notifications                   Notification[]
  ratingsGiven                    Rating[]                @relation("RaterRelation")
  ratingsReceived                 Rating[]                @relation("RateeRelation")
  trustScoreHistory               TrustScoreHistory[]
  auditLogs                       AuditLog[]
  reports                         Report[]                @relation("ReporterRelation")
  resolvedReports                 Report[]                @relation("ResolverRelation")
  recipes                         Recipe[]                @relation("RecipeAuthorRelation")
  campaignChangeRequestsRequested CampaignChangeRequest[] @relation("campaign_change_requests_requested_by_user_idTousers")
  campaignChangeRequestsReviewed  CampaignChangeRequest[] @relation("campaign_change_requests_reviewed_by_user_idTousers")
  providerProposalsProposed       ProviderProposal[]      @relation("provider_proposals_proposed_by")
  providerProposalsReviewed       ProviderProposal[]      @relation("provider_proposals_reviewed_by")
  receivedCampaignTransports      CampaignTransport[]     @relation("CampaignTransportReceipt")

  @@index([email])
  @@index([role, status])
  @@map("users")
}

model ProviderProfile {
  id                 String                                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String                                 @unique @map("user_id") @db.Uuid
  businessName       String                                 @map("business_name") @db.VarChar(255)
  businessType       BusinessType                           @map("business_type")
  taxCode            String?                                @map("tax_code") @db.VarChar(50)
  description        String?
  address            String
  // GEOGRAPHY: đọc/ghi qua $queryRaw; khai báo Unsupported để prisma db push KHÔNG xoá cột
  location           Unsupported("geography(Point, 4326)")?
  contactPhone       String?                                @map("contact_phone") @db.VarChar(20)
  websiteUrl         String?                                @map("website_url")
  isVerified         Boolean                                @default(false) @map("is_verified")
  verificationStatus VerificationStatus                     @default(pending) @map("verification_status")
  verifiedAt         DateTime?                              @map("verified_at") @db.Timestamptz
  verifiedBy         String?                                @map("verified_by") @db.Uuid
  totalFoodRescuedKg Decimal                                @default(0) @map("total_food_rescued_kg") @db.Decimal(10, 2)
  totalCo2SavedKg    Decimal                                @default(0) @map("total_co2_saved_kg") @db.Decimal(10, 2)
  avgRating          Decimal?                               @map("avg_rating") @db.Decimal(3, 2)
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  providerProposals ProviderProposal[]        @relation("provider_proposals_created_provider")
  foodListings      FoodListing[]
  esgSnapshots      EsgSnapshot[]
  campaignDonations CampaignDonation[]
  bulkRuns          BulkRun[]
  campaignRequests  CampaignProviderRequest[]

  @@index([userId])
  @@index([location], map: "idx_provider_location", type: Gist)
  @@map("provider_profiles")
}

model ReceiverProfile {
  id                 String                                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String                                 @unique @map("user_id") @db.Uuid
  isCharityOrg       Boolean                                @default(false) @map("is_charity_org")
  organizationName   String?                                @map("organization_name") @db.VarChar(255)
  idCardNumber       String?                                @map("id_card_number") @db.VarChar(50)
  idCardImageUrl     String?                                @map("id_card_image_url")
  faceImageUrl       String?                                @map("face_image_url")
  faceDescriptor     Json?                                  @map("face_descriptor")
  address            String?
  location           Unsupported("geography(Point, 4326)")?
  incomeProofUrl     String?                                @map("income_proof_url")
  verificationStatus VerificationStatus                     @default(pending) @map("verification_status")
  verifiedAt         DateTime?                              @map("verified_at") @db.Timestamptz
  verifiedBy         String?                                @map("verified_by") @db.Uuid
  reservationsToday  Int                                    @default(0) @map("reservations_today") @db.SmallInt
  avgRating          Decimal?                               @map("avg_rating") @db.Decimal(3, 2)
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz

  user             User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservations     Reservation[]
  kitchenCampaigns KitchenCampaign[]
  campaignRequests CampaignProviderRequest[]
  handoffQrTokens  ReceiverHandoffQr[]
  mealHandoffs     MealHandoff[]

  @@index([userId])
  @@map("receiver_profiles")
}

model VolunteerProfile {
  id                 String                                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId             String                                 @unique @map("user_id") @db.Uuid
  idCardNumber       String?                                @map("id_card_number") @db.VarChar(50)
  idCardImageUrl     String?                                @map("id_card_image_url")
  faceImageUrl       String?                                @map("face_image_url")
  faceDescriptor     Json?                                  @map("face_descriptor")
  currentLocation    Unsupported("geography(Point, 4326)")? @map("current_location")
  locationUpdatedAt  DateTime?                              @map("location_updated_at") @db.Timestamptz
  isAvailable        Boolean                                @default(false) @map("is_available")
  dedicationPoints   Int                                    @default(0) @map("dedication_points")
  rank               VolunteerRank                          @default(newcomer)
  vehicleType        String?                                @map("vehicle_type") @db.VarChar(50)
  vehiclePlate       String?                                @map("vehicle_plate") @db.VarChar(20)
  avgRating          Decimal?                               @map("avg_rating") @db.Decimal(3, 2)
  verificationStatus VerificationStatus                     @default(pending) @map("verification_status")
  verifiedAt         DateTime?                              @map("verified_at") @db.Timestamptz
  verifiedBy         String?                                @map("verified_by") @db.Uuid
  createdAt          DateTime                               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime                               @updatedAt @map("updated_at") @db.Timestamptz

  user                   User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  specializations        VolunteerSpecializationEntry[]
  availability           VolunteerAvailability[]
  deliveryShifts         DeliveryShiftRegistration[]
  deliveries             Delivery[]
  campaignAssignments    CampaignVolunteerAssignment[]
  dedicationPointHistory DedicationPointsHistory[]
  taskOffers             ShipperTaskOffer[]
  campaignExperiences    CampaignExperience[]
  kitchenSafetyLogs      KitchenSafetyLog[]
  mealDistributions      MealDistribution[]
  scannedMealHandoffs    MealHandoff[]
  bulkRuns               BulkRun[]
  dishStepsCompleted     CampaignDishStep[]
  dishStepsQcFailed      CampaignDishStep[]             @relation("CampaignDishStep_QCFailure")

  @@index([userId])
  @@index([isAvailable])
  @@index([currentLocation], map: "idx_volunteer_location", type: Gist)
  @@map("volunteer_profiles")
}

model VolunteerSpecializationEntry {
  id                String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  volunteerId       String                  @map("volunteer_id") @db.Uuid
  specialization    VolunteerSpecialization
  foodSafetyCertUrl String?                 @map("food_safety_cert_url")
  certExpiryDate    DateTime?               @map("cert_expiry_date") @db.Date
  isVerified        Boolean                 @default(false) @map("is_verified")
  verifiedAt        DateTime?               @map("verified_at") @db.Timestamptz

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, specialization])
  @@map("volunteer_specializations")
}

model LiabilityWaiver {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  waiverVersion String   @default("v1.0") @map("waiver_version") @db.VarChar(20)
  acceptedAt    DateTime @default(now()) @map("accepted_at") @db.Timestamptz
  ipAddress     String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, waiverVersion])
  @@map("liability_waivers")
}

model FoodListing {
  id                String                                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  providerId        String                                 @map("provider_id") @db.Uuid
  title             String                                 @db.VarChar(255)
  description       String?
  category          FoodCategory
  quantityTotal     Decimal                                @map("quantity_total") @db.Decimal(10, 2)
  quantityRemaining Decimal                                @map("quantity_remaining") @db.Decimal(10, 2)
  quantityUnit      QuantityUnit                           @default(portion) @map("quantity_unit")
  weightPerUnitKg   Decimal?                               @map("weight_per_unit_kg") @db.Decimal(6, 3)
  pickupStartTime   DateTime                               @map("pickup_start_time") @db.Timestamptz
  pickupEndTime     DateTime                               @map("pickup_end_time") @db.Timestamptz
  /// Khung giờ mở cửa TRONG NGÀY, tính bằng phút từ 00:00 giờ VN (7:00 → 420, 21:00 → 1260).
  /// Lưu số phút thay vì kiểu `time` để tránh nhập nhằng múi giờ khi server chạy UTC.
  /// Null = tin cũ chưa có khung giờ ngày → không áp ràng buộc này.
  dailyStartMinute  Int?                                   @map("daily_start_minute") @db.SmallInt
  dailyEndMinute    Int?                                   @map("daily_end_minute") @db.SmallInt
  expiryTime        DateTime                               @map("expiry_time") @db.Timestamptz
  pickupAddress     String                                 @map("pickup_address")
  pickupLocation    Unsupported("geography(Point, 4326)")? @map("pickup_location")
  storageConditions String?                                @map("storage_conditions")
  allergenNotes     String?                                @map("allergen_notes")
  maxPerReservation Int                                    @default(1) @map("max_per_reservation") @db.SmallInt
  imageUrls         Json                                   @default("[]") @map("image_urls")
  // Cột có sẵn trong DB (túi bất ngờ) — khai báo để db push không drop mất dữ liệu
  isSurpriseBag     Boolean                                @default(false) @map("is_surprise_bag")
  status            ListingStatus                          @default(draft)
  cancelledReason   String?                                @map("cancelled_reason")
  createdAt         DateTime                               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                               @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?                              @map("deleted_at") @db.Timestamptz

  provider     ProviderProfile @relation(fields: [providerId], references: [id])
  reservations Reservation[]
  bulkRuns     BulkRun[]

  @@index([providerId])
  @@index([pickupLocation], map: "idx_listing_location", type: Gist)
  @@map("food_listings")
}

model Reservation {
  id                     String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  listingId              String                  @map("listing_id") @db.Uuid
  receiverId             String                  @map("receiver_id") @db.Uuid
  bulkRunStopId          String?                 @unique @map("bulk_run_stop_id") @db.Uuid /// Điểm phát bulk tương ứng
  quantity               Decimal                 @db.Decimal(10, 2)
  status                 ReservationStatus       @default(confirmed)
  qrToken                String                  @unique @map("qr_token") @db.VarChar(64)
  qrExpiresAt            DateTime                @map("qr_expires_at") @db.Timestamptz
  pickupProofUrl         String?                 @map("pickup_proof_url")
  pickupProofAt          DateTime?               @map("pickup_proof_at") @db.Timestamptz
  pickupVerificationType PickupVerificationType? @map("pickup_verification_type")
  scannedBy              String?                 @map("scanned_by") @db.Uuid
  scannedAt              DateTime?               @map("scanned_at") @db.Timestamptz
  cancelledAt            DateTime?               @map("cancelled_at") @db.Timestamptz
  cancellationReason     String?                 @map("cancellation_reason")
  receiverNotes          String?                 @map("receiver_notes")
  /// Ảnh bằng chứng người nhận khó di chuyển (bệnh, gãy chân…) — BẮT BUỘC khi
  /// yêu cầu TNV giao tận nơi; shipper xem ảnh trong popup lời mời trước khi nhận.
  deliveryEvidenceUrl    String?                 @map("delivery_evidence_url")
  /// Điểm giao do người đặt chọn riêng cho đơn này (đang nằm viện, ở nhà người thân…).
  /// NULL = giao về địa chỉ mặc định trong hồ sơ người nhận.
  deliveryAddress        String?                 @map("delivery_address")
  /// Giờ hẹn giao do người nhận chọn. NULL = giao ngay khi có shipper nhận đơn.
  deliveryScheduledAt    DateTime?               @map("delivery_scheduled_at") @db.Timestamptz
  deliveryLocation       Unsupported("geography(Point, 4326)")? @map("delivery_location")
  trustPenaltyApplied    Boolean                 @default(false) @map("trust_penalty_applied")
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  listing     FoodListing     @relation(fields: [listingId], references: [id])
  receiver    ReceiverProfile @relation(fields: [receiverId], references: [id])
  delivery    Delivery?
  bulkRunStop BulkRunStop?    @relation(fields: [bulkRunStopId], references: [id])

  @@index([listingId, receiverId])
  @@index([receiverId])
  @@index([qrToken])
  @@index([status])
  @@index([receiverId, createdAt])
  @@map("reservations")
}

model Delivery {
  id                String                                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Reservation gốc (cho luồng đặt suất ăn). NULL khi delivery phục vụ cho campaign (campaign_transports).
  reservationId     String?                                @unique @map("reservation_id") @db.Uuid
  /// Nếu delivery này tạo cho CampaignProviderRequest thì tham chiếu tới request đó.
  providerRequestId String?                                @unique @map("provider_request_id") @db.Uuid
  shipperId         String?                                @map("shipper_id") @db.Uuid
  status            DeliveryStatus                         @default(pending_assignment)
  qcPhotoUrl        String?                                @map("qc_photo_url")
  qcPhotoAt         DateTime?                              @map("qc_photo_at") @db.Timestamptz
  pickupProofUrl    String?                                @map("pickup_proof_url")
  pickupProofAt     DateTime?                              @map("pickup_proof_at") @db.Timestamptz
  deliveryProofUrl  String?                                @map("delivery_proof_url")
  deliveryProofAt   DateTime?                              @map("delivery_proof_at") @db.Timestamptz
  pickupLocation    Unsupported("geography(Point, 4326)")? @map("pickup_location")
  deliveryLocation  Unsupported("geography(Point, 4326)")? @map("delivery_location")
  distanceKm        Decimal?                               @map("distance_km") @db.Decimal(8, 2)
  assignedAt        DateTime?                              @map("assigned_at") @db.Timestamptz
  pickedUpAt        DateTime?                              @map("picked_up_at") @db.Timestamptz
  deliveredAt       DateTime?                              @map("delivered_at") @db.Timestamptz
  failedReason      String?                                @map("failed_reason")
  createdAt         DateTime                               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                               @updatedAt @map("updated_at") @db.Timestamptz

  reservation       Reservation?             @relation(fields: [reservationId], references: [id])
  providerRequest   CampaignProviderRequest? @relation("DeliveryForProviderRequest", fields: [providerRequestId], references: [id], onDelete: SetNull)
  shipper           VolunteerProfile?        @relation(fields: [shipperId], references: [id])
  taskOffers        ShipperTaskOffer[]
  campaignTransport CampaignTransport?       @relation("DeliveryForTransport")

  @@index([shipperId])
  @@index([status])
  @@map("deliveries")
}

enum BulkRunStatus {
  requested
  approved
  rejected
  picked_up
  completed
  cancelled

  @@map("bulk_run_status")
}

/// Chuyến GIAO SỈ: shipper nhận số lượng lớn (≥10 phần) từ 1 listing rồi phát
/// tại nhiều điểm trên tuyến đường (điểm do nhà cung cấp hoặc shipper ghim).
model BulkRun {
  id                  String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  listingId           String        @map("listing_id") @db.Uuid
  providerId          String        @map("provider_id") @db.Uuid
  shipperId           String        @map("shipper_id") @db.Uuid
  quantity            Int
  quantityDistributed Int           @default(0) @map("quantity_distributed")
  status              BulkRunStatus @default(requested)
  note                String?
  rejectReason        String?       @map("reject_reason")
  qcPhotoUrl          String?       @map("qc_photo_url")
  approvedAt          DateTime?     @map("approved_at") @db.Timestamptz
  pickedUpAt          DateTime?     @map("picked_up_at") @db.Timestamptz
  completedAt         DateTime?     @map("completed_at") @db.Timestamptz
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  listing  FoodListing      @relation(fields: [listingId], references: [id])
  provider ProviderProfile  @relation(fields: [providerId], references: [id])
  shipper  VolunteerProfile @relation(fields: [shipperId], references: [id])
  stops    BulkRunStop[]

  @@index([shipperId, status])
  @@index([providerId, status])
  @@map("bulk_runs")
}

/// Điểm phát trên tuyến giao sỉ (ghim ad-hoc bởi 'provider' hoặc 'shipper')
/// Mỗi điểm phát được gắn 1 reservation khi shipper lấy hàng (pickup).
model BulkRunStop {
  id            String                                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  runId         String                                 @map("run_id") @db.Uuid
  reservationId String?                                @unique @map("reservation_id") @db.Uuid /// FK tới Reservation tương ứng
  label         String                                 @db.VarChar(255)
  address       String?
  location      Unsupported("geography(Point, 4326)")?
  plannedQty    Int?                                   @map("planned_qty")
  servedQty     Int                                    @default(0) @map("served_qty")
  photoUrl      String?                                @map("photo_url")
  note          String?
  createdBy     String                                 @map("created_by") @db.VarChar(10)
  orderIndex    Int                                    @default(0) @map("order_index")
  servedAt      DateTime?                              @map("served_at") @db.Timestamptz
  createdAt     DateTime                               @default(now()) @map("created_at") @db.Timestamptz

  run         BulkRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// relation: Prisma tự resolve qua bulkRunStopId unique trên phía Reservation
  reservation Reservation?

  @@index([runId])
  @@map("bulk_run_stops")
}

/// Khung giờ TNV tự khai là rảnh, lặp lại hằng tuần (lưới 7 ngày × 4 ca).
/// Chỉ dùng để LỌC / GỢI Ý — không tự động phân công.
model VolunteerAvailability {
  id          String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  volunteerId String              @map("volunteer_id") @db.Uuid
  /// 1 = Thứ 2 … 7 = Chủ nhật (ISO-8601, khớp EXTRACT(ISODOW FROM date)).
  dayOfWeek   Int                 @map("day_of_week") @db.SmallInt
  period      CampaignShiftPeriod
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, dayOfWeek, period], map: "volunteer_availability_unique_cell")
  @@index([dayOfWeek, period], map: "idx_volunteer_availability_slot")
  @@index([volunteerId], map: "idx_volunteer_availability_volunteer")
  @@map("volunteer_availability")
}

/// Ca GIAO HÀNG tình nguyện viên đã đăng ký cho một ngày cụ thể.
/// Khác volunteer_availability (khai báo rảnh, lặp hằng tuần): đây là CAM KẾT trực ca,
/// là điều kiện để nhận đơn giao trong khung giờ đó.
model DeliveryShiftRegistration {
  id          String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  volunteerId String              @map("volunteer_id") @db.Uuid
  workDate    DateTime            @map("work_date") @db.Date
  period      CampaignShiftPeriod
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz

  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  @@unique([volunteerId, workDate, period], map: "delivery_shift_reg_unique")
  @@index([workDate, period], map: "idx_delivery_shift_reg_slot")
  @@index([volunteerId, workDate], map: "idx_delivery_shift_reg_volunteer")
  @@map("delivery_shift_registrations")
}

model KitchenCampaign {
  id                     String                                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  charityReceiverId      String                                 @map("charity_receiver_id") @db.Uuid
  title                  String                                 @db.VarChar(255)
  description            String?
  kitchenAddress         String                                 @map("kitchen_address")
  kitchenLocation        Unsupported("geography(Point, 4326)")? @map("kitchen_location")
  scheduledDate          DateTime                               @map("scheduled_date") @db.Date
  /// Ngày kết thúc (>= scheduledDate). NULL = 1 ngày duy nhất.
  /// Trường ngày tương thích; cron dùng operationEndAt làm mốc kết thúc chuẩn.
  endDate                DateTime?                              @map("end_date") @db.Date
  startTime              String                                 @map("start_time") @db.VarChar(8)
  endTime                String                                 @map("end_time") @db.VarChar(8)
  chefSlotsNeeded        Int                                    @default(0) @map("chef_slots_needed") @db.SmallInt
  waiterSlotsNeeded      Int                                    @default(0) @map("waiter_slots_needed") @db.SmallInt
  shipperSlotsNeeded     Int                                    @default(0) @map("shipper_slots_needed") @db.SmallInt
  chefSlotsFilled        Int                                    @default(0) @map("chef_slots_filled") @db.SmallInt
  waiterSlotsFilled      Int                                    @default(0) @map("waiter_slots_filled") @db.SmallInt
  shipperSlotsFilled     Int                                    @default(0) @map("shipper_slots_filled") @db.SmallInt
  status                 CampaignStatus                         @default(pending_approval)
  operationStartAt       DateTime                               @map("operation_start_at") @db.Timestamptz
  operationEndAt         DateTime                               @map("operation_end_at") @db.Timestamptz
  recruitmentStartAt     DateTime                               @map("recruitment_start_at") @db.Timestamptz
  recruitmentEndAt       DateTime                               @map("recruitment_end_at") @db.Timestamptz
  recruitmentBufferHours Int                                    @default(24) @map("recruitment_buffer_hours") @db.SmallInt
  recruitmentStatus      RecruitmentStatus                      @default(scheduled) @map("recruitment_status")
  expectedServings       Int?                                   @map("expected_servings")
  actualServings         Int?                                   @map("actual_servings")
  imageUrls              Json                                   @default("[]") @map("image_urls")
  notes                  String?
  menuItems              Json                                   @default("[]") @map("menu_items")
  scheduleItems          Json                                   @default("[]") @map("schedule_items")
  supplyItems            Json                                   @default("[]") @map("supply_items")
  createdAt              DateTime                               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                               @updatedAt @map("updated_at") @db.Timestamptz

  charityReceiver   ReceiverProfile               @relation(fields: [charityReceiverId], references: [id])
  assignments       CampaignVolunteerAssignment[]
  donations         CampaignDonation[]
  changeRequests    CampaignChangeRequest[]
  experiences       CampaignExperience[]
  menuItemRefs      CampaignMenuItem[]
  dishSteps         CampaignDishStep[]
  safetyLogs        KitchenSafetyLog[]
  mealDistributions MealDistribution[]
  shifts            CampaignShift[]
  providerRequests  CampaignProviderRequest[]

  @@index([charityReceiverId])
  @@index([scheduledDate, status])
  @@index([status, recruitmentStatus, recruitmentStartAt, recruitmentEndAt], map: "kitchen_campaigns_status_recruitment_window_idx")
  @@index([status, operationStartAt], map: "kitchen_campaigns_status_operation_start_idx")
  @@index([kitchenLocation], map: "idx_campaign_location", type: Gist)
  @@map("kitchen_campaigns")
}

/// Nhà cung cấp quyên góp nguyên liệu cho một chiến dịch bếp ăn
model CampaignDonation {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId String    @map("campaign_id") @db.Uuid
  providerId String    @map("provider_id") @db.Uuid
  itemName   String    @map("item_name") @db.VarChar(255)
  quantity   String?   @db.VarChar(100)
  note       String?
  status     String    @default("pledged") @db.VarChar(20)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  receivedAt DateTime? @map("received_at") @db.Timestamptz

  /// Lịch đi nhận hàng do tổ chức đặt. Khung giờ này BẮT BUỘC nằm trong ca trực
  /// SHIPPER được phân công (validate ở assignDonationPickup) — không để lệch
  /// giữa giờ đăng ký ca của TNV và giờ hẹn lấy hàng với NCC.
  pickupDate      DateTime? @map("pickup_date") @db.Date
  pickupStartTime String?   @map("pickup_start_time") @db.VarChar(5)
  pickupEndTime   String?   @map("pickup_end_time") @db.VarChar(5)
  /// DS id bản ghi phân công ca (campaign_volunteer_assignments) được cử đi nhận.
  /// JSONB array<uuid> — một khoản góp lớn có thể cần NHIỀU shipper đi cùng
  /// (cùng pattern `assigneeIds` của meal_distributions).
  pickupAssigneeIds Json @default("[]") @map("pickup_assignee_ids")

  /// Đơn nguyên liệu đã sinh ra khoản này (NCC đồng ý request → BE tự tạo donation để
  /// số kg vào sổ kho). Có giá trị = CÙNG MỘT LÔ HÀNG với request đó: lịch đi nhận và
  /// việc xác nhận thực nhận do request quản, không làm riêng ở đây.
  /// null = NCC tự nguyện góp thẳng, không qua đơn nào.
  providerRequestId String? @map("provider_request_id") @db.Uuid

  campaign KitchenCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id])
  providerRequest CampaignProviderRequest? @relation("DonationFromProviderRequest", fields: [providerRequestId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([providerRequestId])
  @@index([providerId])
  @@map("campaign_donations")
}

/**
 * Charity gửi request hợp tác đến provider.
 * Provider nhận → accept/reject → tạo listing thực phẩm cho chiến dịch.
 */
model CampaignProviderRequest {
  id              String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId      String                @map("campaign_id") @db.Uuid
  receiverId      String                @map("receiver_id") @db.Uuid // charity tổ chức
  providerId      String                @map("provider_id") @db.Uuid
  message         String?               @db.VarChar(500)
  status          CampaignRequestStatus @default(pending)
  /// Thời hạn hợp tác (số tháng), null = vĩnh viễn
  durationMonths  Int?                  @map("duration_months")
  /// Danh sách ID thực phẩm được chọn (lưu dạng JSON array string)
  listingIds      String?               @map("listing_ids") @db.VarChar(1000)
  /// Ngày TNV đến lấy thực phẩm từ provider — copy từ campaign lúc accept (có thể override).
  scheduledDate   DateTime?             @map("scheduled_date") @db.Date
  /// Giờ bắt đầu lấy hàng do provider chọn (HH:mm). Default = campaign.startTime.
  pickupStartTime String?               @map("pickup_start_time") @db.VarChar(8)
  /// Giờ kết thúc lấy hàng (mặc định = campaign.endTime).
  pickupEndTime   String?               @map("pickup_end_time") @db.VarChar(8)
  /// Nếu true → sau accept, BE tạo delivery record + tìm shipper gần nhất.
  needsTransport  Boolean               @default(false) @map("needs_transport")
  /// Chi tiết đơn yêu cầu nguyên liệu do bếp khai (loại thực phẩm, số kg, khung giờ
  /// cần nhận, bán kính tìm, tiêu chuẩn ATVSTP bắt buộc, cam kết phi thương mại).
  /// Để JSONB thay vì tách cột: bộ tiêu chí này còn thay đổi theo nghiệp vụ, thêm/bớt
  /// field không phải migrate lại. Shape xem `DemandDetailsDto`.
  demandDetails   Json?                 @map("demand_details")
  /// DS id bản ghi phân công ca (campaign_volunteer_assignments) mà TỔ CHỨC cử đi
  /// nhận hàng — thay cho vòng tìm shipper toàn hệ thống. Chỉ nhận shipper có ca
  /// phủ trọn khung giờ lấy (validate ở assignRequestPickup). JSONB array<uuid>,
  /// cùng pattern `pickupAssigneeIds` của campaign_donations.
  pickupAssigneeIds Json                @default("[]") @map("pickup_assignee_ids")
  reviewedAt      DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  reviewedNote    String?               @map("reviewed_note") @db.VarChar(255)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  campaign         KitchenCampaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  receiver         ReceiverProfile           @relation(fields: [receiverId], references: [id])
  provider         ProviderProfile           @relation(fields: [providerId], references: [id])
  transport        CampaignTransport?
  delivery         Delivery?                 @relation("DeliveryForProviderRequest")
  ingredientPickup CampaignIngredientPickup?
  /// Khoản ghi sổ kho sinh ra khi NCC đồng ý đơn này — cùng một lô hàng.
  donations        CampaignDonation[]        @relation("DonationFromProviderRequest")

  // Unique (campaignId, providerId) đã gỡ: một chiến dịch được gửi NHIỀU đơn nguyên
  // liệu tới cùng một NCC (mỗi món một đơn); service chỉ sửa-tại-chỗ đơn còn pending.
  @@index([campaignId, providerId])
  @@index([campaignId])
  @@index([providerId])
  @@index([status])
  @@map("campaign_provider_requests")
}

/// Liên kết 1-1 giữa provider-request và delivery (khi needsTransport=true).
/// Cho phép sau này 1 request có thể gắn nhiều delivery (multi-item).
model CampaignTransport {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  providerRequestId String    @unique @map("provider_request_id") @db.Uuid
  deliveryId        String?   @unique @map("delivery_id") @db.Uuid
  status            String    @default("pending") @db.VarChar(20)
  assignedAt        DateTime? @map("assigned_at") @db.Timestamptz
  pickedUpAt        DateTime? @map("picked_up_at") @db.Timestamptz
  deliveredAt       DateTime? @map("delivered_at") @db.Timestamptz
  receivedAt        DateTime? @map("received_at") @db.Timestamptz
  failedAt          DateTime? @map("failed_at") @db.Timestamptz
  failureReason     String?   @map("failure_reason")
  receivedByUserId  String?   @map("received_by_user_id") @db.Uuid
  receiptNote       String?   @map("receipt_note") @db.VarChar(500)
  receiptPhotoUrl   String?   @map("receipt_photo_url")
  lastBroadcastAt   DateTime? @map("last_broadcast_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  providerRequest CampaignProviderRequest @relation(fields: [providerRequestId], references: [id], onDelete: Cascade)
  delivery        Delivery?               @relation("DeliveryForTransport", fields: [deliveryId], references: [id])
  receivedByUser  User?                   @relation("CampaignTransportReceipt", fields: [receivedByUserId], references: [id], onDelete: SetNull)

  @@index([providerRequestId])
  @@index([status])
  @@map("campaign_transports")
}

/// Biên nhận TNV (shipper) ĐÃ LẤY nguyên liệu tại NCC cho một đơn của chiến dịch.
///
/// Đơn `needsTransport = true` đi qua luồng /deliveries (đã có ảnh QC lúc `qc_completed`).
/// Đơn `needsTransport = false` — bếp tự cử shipper đi lấy — trước đây KHÔNG có bằng chứng
/// nào: TNV bấm "hoàn thành ca" là xong, không biết lấy đủ số kg đã đặt hay không.
/// Bảng này là bằng chứng cho luồng đó: ảnh nguyên liệu + số kg THỰC NHẬN.
///
/// 1 đơn = 1 biên nhận (unique providerRequestId) — hàng lấy một lần từ một NCC.
model CampaignIngredientPickup {
  id                String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  providerRequestId String   @unique @map("provider_request_id") @db.Uuid
  /// Denormalize để truy vấn theo chiến dịch không phải join ngược.
  campaignId        String   @map("campaign_id") @db.Uuid
  /// Assignment của shipper trong chiến dịch (nguồn của ràng buộc "phải điểm danh trước").
  assignmentId      String   @map("assignment_id") @db.Uuid
  volunteerId       String   @map("volunteer_id") @db.Uuid
  /// Số kg bếp ĐẶT lúc gửi đơn — chụp lại tại thời điểm xác nhận vì `demandDetails`
  /// có thể bị sửa sau, còn biên nhận thì phải bất biến.
  requestedKg       Decimal? @map("requested_kg") @db.Decimal(10, 2)
  /// Số kg shipper THỰC NHẬN tại NCC.
  receivedKg        Decimal  @map("received_kg") @db.Decimal(10, 2)
  /// Ảnh nguyên liệu đã lấy — bắt buộc, đây là bằng chứng chính.
  photoUrl          String   @map("photo_url")
  note              String?  @db.VarChar(500)
  confirmedAt       DateTime @default(now()) @map("confirmed_at") @db.Timestamptz(6)

  providerRequest CampaignProviderRequest @relation(fields: [providerRequestId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([volunteerId])
  @@map("campaign_ingredient_pickups")
}

enum CampaignRequestStatus {
  pending
  accepted
  rejected
  expired

  @@map("campaign_request_status")
}

model CampaignVolunteerAssignment {
  id                   String                                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  campaignId           String                                 @map("campaign_id") @db.Uuid
  volunteerId          String                                 @map("volunteer_id") @db.Uuid
  role                 AssignmentRole
  status               AssignmentStatus                       @default(assigned)
  checkInTime          DateTime?                              @map("check_in_time") @db.Timestamptz
  /// Số phút điểm danh TRỄ so với giờ phải có mặt (giờ ca trực, hoặc giờ bắt đầu
  /// chiến dịch nếu không có ca). null = chưa điểm danh; 0 = đúng giờ.
  /// Trễ quá thời gian ân hạn thì bị trừ uy tín và đánh dấu ở mọi nơi hiển thị.
  checkInLateMinutes   Int?                                   @map("check_in_late_minutes")
  checkInLocation      Unsupported("geography(Point, 4326)")? @map("check_in_location")
  checkOutTime         DateTime?                              @map("check_out_time") @db.Timestamptz
  ingredientProofUrl   String?                                @map("ingredient_proof_url")
  ingredientProofAt    DateTime?                              @map("ingredient_proof_at") @db.Timestamptz
  cookedProofUrl       String?                                @map("cooked_proof_url")
  cookedProofAt        DateTime?                              @map("cooked_proof_at") @db.Timestamptz
  distributionProofUrl String?                                @map("distribution_proof_url")
  distributionProofAt  DateTime?                              @map("distribution_proof_at") @db.Timestamptz
  pointsAwarded        Int?                                   @map("points_awarded") @db.SmallInt
  confirmationStatus   AssignmentConfirmationStatus           @default(pending) @map("confirmation_status")
  confirmedAt          DateTime?                              @map("confirmed_at") @db.Timestamptz
  notes                String?
  createdAt            DateTime                               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime                               @updatedAt @map("updated_at") @db.Timestamptz

  shiftId String? @map("shift_id") @db.Uuid

  /// NGÀY TRỰC cụ thể. Ca (`CampaignShift`) chỉ có giờ, không có ngày — với chiến dịch
  /// nhiều ngày thì ca lặp lại mỗi ngày, nên nếu không ghi ngày ở đây tổ chức không biết
  /// ai trực buổi nào. NULL = dữ liệu cũ, hiểu là `campaign.scheduledDate`.
  workDate DateTime? @map("work_date") @db.Date

  campaign  KitchenCampaign  @relation(fields: [campaignId], references: [id])
  volunteer VolunteerProfile @relation(fields: [volunteerId], references: [id])
  shift     CampaignShift?   @relation(fields: [shiftId], references: [id])

  // workDate nằm trong khoá: cùng một ca, TNV được nhận nhiều ngày khác nhau.
  @@unique([shiftId, volunteerId, role, workDate])
  @@index([campaignId, volunteerId, role])
  @@index([campaignId])
  @@index([volunteerId])
  @@map("campaign_volunteer_assignments")
}

model Rating {
  id            String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  // referenceType: 'reservation' | 'campaign' — polymorphic, no FK at Prisma level
  referenceType String   @map("reference_type") @db.VarChar(20)
  referenceId   String   @map("reference_id") @db.Uuid
  raterId       String   @map("rater_id") @db.Uuid
  rateeId       String   @map("ratee_id") @db.Uuid
  score         Int      @db.SmallInt
  comment       String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  rater User @relation("RaterRelation", fields: [raterId], references: [id])
  ratee User @relation("RateeRelation", fields: [rateeId], references: [id])

  @@unique([referenceType, referenceId, raterId, rateeId])
  @@index([rateeId])
  @@index([referenceType, referenceId])
  @@map("ratings")
}

model TrustScoreHistory {
  id            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
